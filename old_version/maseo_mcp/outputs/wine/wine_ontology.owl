<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/wine#"
     xml:base="http://www.semanticweb.org/wine#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
    <owl:Ontology rdf:about="http://www.semanticweb.org/wine#">
        <rdfs:comment>An ontology for wine characteristics, regions, types, and vintages.</rdfs:comment>
    </owl:Ontology>

    <!-- Classes -->
    <owl:Class rdf:about="http://www.semanticweb.org/wine#Wine">
        <rdfs:label>Wine</rdfs:label>
        <rdfs:comment>A class representing wine.</rdfs:comment>
        <dc:source>(competency_question) CQ1</dc:source>
        <dc:source>(competency_question) CQ2</dc:source>
        <dc:source>(competency_question) CQ6</dc:source>
        <dc:source>(competency_question) CQ7</dc:source>
        <dc:source>(competency_question) CQnew1</dc:source>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/wine#WineCharacteristic">
        <rdfs:label>WineCharacteristic</rdfs:label>
        <rdfs:comment>A characteristic of a wine, such as bouquet or body.</rdfs:comment>
        <dc:source>(competency_question) CQ1</dc:source>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/wine#RedWine">
        <rdfs:label>RedWine</rdfs:label>
        <rdfs:comment>A subclass of Wine representing red wines.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/wine#Wine"/>
        <dc:source>(competency_question) CQ2</dc:source>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/wine#WhiteWine">
        <rdfs:label>WhiteWine</rdfs:label>
        <rdfs:comment>A subclass of Wine representing white wines.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/wine#Wine"/>
        <dc:source>(competency_question) CQ2</dc:source>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/wine#WineRegion">
        <rdfs:label>WineRegion</rdfs:label>
        <rdfs:comment>A geographical region where wine is produced.</rdfs:comment>
        <dc:source>(competency_question) CQ2</dc:source>
        <dc:source>(competency_question) CQnew1</dc:source>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/wine#Vintage">
        <rdfs:label>Vintage</rdfs:label>
        <rdfs:comment>A specific year's harvest of grapes for a wine.</rdfs:comment>
        <dc:source>(competency_question) CQ6</dc:source>
        <dc:source>(competency_question) CQ7</dc:source>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/wine#WineType">
        <rdfs:label>WineType</rdfs:label>
        <rdfs:comment>A type or style of wine, e.g., Zinfandel.</rdfs:comment>
        <dc:source>(competency_question) CQ7</dc:source>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/wine#Grape">
        <rdfs:label>Grape</rdfs:label>
        <rdfs:comment>A grape variety used in winemaking.</rdfs:comment>
        <dc:source>(competency_question) CQnew1</dc:source>
    </owl:Class>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#hasCharacteristic">
        <rdfs:label>hasCharacteristic</rdfs:label>
        <rdfs:comment>Relates a wine to one of its characteristics.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/wine#WineCharacteristic"/>
        <dc:source>(competency_question) CQ1</dc:source>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#producedIn">
        <rdfs:label>producedIn</rdfs:label>
        <rdfs:comment>Relates a wine to the region where it is produced.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/wine#WineRegion"/>
        <dc:source>(competency_question) CQ2</dc:source>
        <dc:source>(competency_question) CQnew1</dc:source>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/wine#hasColor">
        <rdfs:label>hasColor</rdfs:label>
        <rdfs:comment>The color of a wine (e.g., "red", "white").</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:source>(competency_question) CQ2</dc:source>
    </owl:DatatypeProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#hasBouquet">
        <rdfs:label>hasBouquet</rdfs:label>
        <rdfs:comment>Relates a wine to its bouquet characteristic.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/wine#WineCharacteristic"/>
        <dc:source>(competency_question) CQ6</dc:source>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#hasBody">
        <rdfs:label>hasBody</rdfs:label>
        <rdfs:comment>Relates a wine to its body characteristic.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/wine#WineCharacteristic"/>
        <dc:source>(competency_question) CQ6</dc:source>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#hasVintage">
        <rdfs:label>hasVintage</rdfs:label>
        <rdfs:comment>Relates a wine to a specific vintage.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/wine#Vintage"/>
        <dc:source>(competency_question) CQ6</dc:source>
        <dc:source>(competency_question) CQ7</dc:source>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#hasQuality">
        <rdfs:label>hasQuality</rdfs:label>
        <rdfs:comment>Relates a vintage to its quality rating.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Vintage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:source>(competency_question) CQ7</dc:source>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#madeFromGrape">
        <rdfs:label>madeFromGrape</rdfs:label>
        <rdfs:comment>Relates a wine to the grape variety it is made from.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/wine#Grape"/>
        <dc:source>(competency_question) CQnew1</dc:source>
    </owl:ObjectProperty>

    <!-- Data Properties -->
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/wine#vintageYear">
        <rdfs:label>vintageYear</rdfs:label>
        <rdfs:comment>The year of a vintage.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Vintage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <dc:source>(competency_question) CQ6</dc:source>
        <dc:source>(competency_question) CQ7</dc:source>
    </owl:DatatypeProperty>

    <!-- Individuals -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/wine#Bordeaux">
        <rdf:type rdf:resource="http://www.semanticweb.org/wine#WineRegion"/>
        <rdfs:label>Bordeaux</rdfs:label>
        <rdfs:comment>The Bordeaux wine region.</rdfs:comment>
        <dc:source>(competency_question) CQ2</dc:source>
        <dc:source>(competency_question) CQnew1</dc:source>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/wine#NapaZinfandel">
        <rdf:type rdf:resource="http://www.semanticweb.org/wine#WineType"/>
        <rdfs:label>NapaZinfandel</rdfs:label>
        <rdfs:comment>A wine type: Zinfandel from Napa Valley.</rdfs:comment>
        <dc:source>(competency_question) CQ7</dc:source>
    </owl:NamedIndividual>

    <!-- Axioms (as class restrictions) -->
    <owl:Class rdf:about="http://www.semanticweb.org/wine#Wine">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/wine#hasCharacteristic"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/wine#WineCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/wine#hasVintage"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/wine#Vintage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

</rdf:RDF>