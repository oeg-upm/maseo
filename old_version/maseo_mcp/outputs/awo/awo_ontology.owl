<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:vaem="http://www.linkedmodel.org/schema/vaem#"
         xml:base="http://www.semanticweb.org/awo#">

    <owl:Ontology rdf:about="http://www.semanticweb.org/awo#">
        <rdfs:label>Animal Food Web Ontology</rdfs:label>
        <rdfs:comment>Ontology modeling animal-plant food relationships</rdfs:comment>
    </owl:Ontology>

    <!-- Classes -->
    <owl:Class rdf:about="http://www.semanticweb.org/awo#Animal">
        <rdfs:label>Animal</rdfs:label>
        <rdfs:comment>Any animal organism</rdfs:comment>
        <dc:source>(competency_question) CQ1</dc:source>
        <dc:source>(competency_question) CQ2</dc:source>
        <dc:source>(competency_question) CQ3</dc:source>
        <dc:source>(competency_question) CQ4</dc:source>
        <dc:source>(competency_question) CQ6</dc:source>
        <dc:source>(competency_question) CQ7</dc:source>
        <dc:source>(competency_question) CQ14</dc:source>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/awo#Herbivore">
        <rdfs:label>Herbivore</rdfs:label>
        <rdfs:comment>An animal that eats only plants or plant parts</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/awo#Animal"/>
        <dc:source>(competency_question) CQ2</dc:source>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/awo#Carnivore">
        <rdfs:label>Carnivore</rdfs:label>
        <rdfs:comment>An animal that primarily eats other animals</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/awo#Animal"/>
        <dc:source>(competency_question) CQ14</dc:source>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/awo#Lion">
        <rdfs:label>Lion</rdfs:label>
        <rdfs:comment>A large carnivorous feline</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/awo#Animal"/>
        <dc:source>(competency_question) CQ4</dc:source>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/awo#Plant">
        <rdfs:label>Plant</rdfs:label>
        <rdfs:comment>Any plant organism</rdfs:comment>
        <dc:source>(competency_question) CQ4</dc:source>
        <dc:source>(competency_question) CQ6</dc:source>
        <dc:source>(competency_question) CQ14</dc:source>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/awo#PlantPart">
        <rdfs:label>PlantPart</rdfs:label>
        <rdfs:comment>A part of a plant (e.g., leaf, root, fruit)</rdfs:comment>
        <dc:source>(competency_question) CQ3</dc:source>
        <dc:source>(competency_question) CQ4</dc:source>
        <dc:source>(competency_question) CQ14</dc:source>
    </owl:Class>

    <!-- Object Property -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/awo#eats">
        <rdfs:label>eats</rdfs:label>
        <rdfs:comment>Relates an organism to what it consumes</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/awo#Animal"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/awo#Animal"/>
        <dc:source>(competency_question) CQ1</dc:source>
        <dc:source>(competency_question) CQ3</dc:source>
        <dc:source>(competency_question) CQ4</dc:source>
        <dc:source>(competency_question) CQ6</dc:source>
        <dc:source>(competency_question) CQ7</dc:source>
        <dc:source>(competency_question) CQ14</dc:source>
    </owl:ObjectProperty>

    <!-- Additional domain/range axioms for eats to cover Plant and PlantPart -->
    <rdf:Description rdf:about="http://www.semanticweb.org/awo#eats">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/awo#Plant"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/awo#PlantPart"/>
    </rdf:Description>

    <!-- Subclass restrictions for Lion -->
    <owl:Class rdf:about="http://www.semanticweb.org/awo#Lion">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/awo#eats"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/awo#Plant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/awo#eats"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/awo#PlantPart"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- Subclass restrictions for Carnivore -->
    <owl:Class rdf:about="http://www.semanticweb.org/awo#Carnivore">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/awo#eats"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/awo#Plant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/awo#eats"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/awo#PlantPart"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

</rdf:RDF>