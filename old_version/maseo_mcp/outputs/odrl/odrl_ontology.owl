<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/odrl#"
     xml:base="http://www.semanticweb.org/odrl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:vaem="http://www.linkedmodel.org/schema/vaem#">
     
    <owl:Ontology rdf:about="http://www.semanticweb.org/odrl#">
        <rdfs:label>ODRL Ontology</rdfs:label>
        <rdfs:comment>An ontology for the ODRL (Open Digital Rights Language) policy language.</rdfs:comment>
    </owl:Ontology>
    
    <!-- Classes -->
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Permission">
        <rdfs:label>Permission</rdfs:label>
        <rdfs:comment>A class representing permissions in ODRL.</rdfs:comment>
        <dc:source>(competency_question) CQ03</dc:source>
        <dc:source>(competency_question) CQ06</dc:source>
        <dc:source>(competency_question) CQ24</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Aggregation">
        <rdfs:label>Aggregation</rdfs:label>
        <rdfs:comment>A specific type of permission.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/odrl#Permission"/>
        <dc:source>(competency_question) CQ03</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Disaggregation">
        <rdfs:label>Disaggregation</rdfs:label>
        <rdfs:comment>A specific type of permission.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/odrl#Permission"/>
        <dc:source>(competency_question) CQ03</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#TransferRights">
        <rdfs:label>TransferRights</rdfs:label>
        <rdfs:comment>A class representing transfer rights.</rdfs:comment>
        <dc:source>(competency_question) CQ03</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#ContractParty">
        <rdfs:label>ContractParty</rdfs:label>
        <rdfs:comment>A party involved in a contract.</rdfs:comment>
        <dc:source>(competency_question) CQ06</dc:source>
        <dc:source>(competency_question) CQ10</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Duty">
        <rdfs:label>Duty</rdfs:label>
        <rdfs:comment>A class representing duties in ODRL.</rdfs:comment>
        <dc:source>(competency_question) CQ06</dc:source>
        <dc:source>(competency_question) CQ10</dc:source>
        <dc:source>(competency_question) New CQ3</dc:source>
        <dc:source>(competency_question) New CQ5</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Role">
        <rdfs:label>Role</rdfs:label>
        <rdfs:comment>A role that a contract party can have.</rdfs:comment>
        <dc:source>(competency_question) CQ06</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Expression">
        <rdfs:label>Expression</rdfs:label>
        <rdfs:comment>A logical expression.</rdfs:comment>
        <dc:source>(competency_question) CQ08</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Constraint">
        <rdfs:label>Constraint</rdfs:label>
        <rdfs:comment>A constraint in ODRL.</rdfs:comment>
        <dc:source>(competency_question) CQ08</dc:source>
        <dc:source>(competency_question) CQ13</dc:source>
        <dc:source>(competency_question) CQ14</dc:source>
        <dc:source>(competency_question) CQ21</dc:source>
        <dc:source>(competency_question) CQ26</dc:source>
        <dc:source>(competency_question) New CQ6</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Right">
        <rdfs:label>Right</rdfs:label>
        <rdfs:comment>A class representing rights.</rdfs:comment>
        <dc:source>(competency_question) CQ10</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Operator">
        <rdfs:label>Operator</rdfs:label>
        <rdfs:comment>An operator used in constraints or expressions.</rdfs:comment>
        <dc:source>(competency_question) CQ14</dc:source>
        <dc:source>(competency_question) New CQ6</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Requirement">
        <rdfs:label>Requirement</rdfs:label>
        <rdfs:comment>A requirement in ODRL.</rdfs:comment>
        <dc:source>(competency_question) CQ21</dc:source>
        <vaem:rationale>Added class Requirement to satisfy Themis test 'Requirement type Class'.</vaem:rationale>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Condition">
        <rdfs:label>Condition</rdfs:label>
        <rdfs:comment>A condition in ODRL.</rdfs:comment>
        <dc:source>(competency_question) CQ26</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Container">
        <rdfs:label>Container</rdfs:label>
        <rdfs:comment>A container concept.</rdfs:comment>
        <dc:source>(competency_question) CQ30</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#REL">
        <rdfs:label>REL</rdfs:label>
        <rdfs:comment>Rights Expression Language.</rdfs:comment>
        <dc:source>(competency_question) CQ31</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Sequencing">
        <rdfs:label>Sequencing</rdfs:label>
        <rdfs:comment>Sequencing as part of REL.</rdfs:comment>
        <dc:source>(competency_question) CQ31</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#DataModel">
        <rdfs:label>DataModel</rdfs:label>
        <rdfs:comment>A data model.</rdfs:comment>
        <dc:source>(competency_question) CQ33</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Policy">
        <rdfs:label>Policy</rdfs:label>
        <rdfs:comment>A policy in ODRL.</rdfs:comment>
        <dc:source>(competency_question) New CQ1</dc:source>
        <dc:source>(competency_question) New CQ2</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Asset">
        <rdfs:label>Asset</rdfs:label>
        <rdfs:comment>An asset in ODRL.</rdfs:comment>
        <dc:source>(competency_question) New CQ1</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#ConflictResolutionStrategy">
        <rdfs:label>ConflictResolutionStrategy</rdfs:label>
        <rdfs:comment>A conflict resolution strategy.</rdfs:comment>
        <dc:source>(competency_question) New CQ2</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Prohibition">
        <rdfs:label>Prohibition</rdfs:label>
        <rdfs:comment>A prohibition in ODRL.</rdfs:comment>
        <dc:source>(competency_question) New CQ3</dc:source>
        <dc:source>(competency_question) New CQ6</dc:source>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/odrl#Rule">
        <rdfs:label>Rule</rdfs:label>
        <rdfs:comment>A rule in ODRL.</rdfs:comment>
        <dc:source>(competency_question) New CQ4</dc:source>
    </owl:Class>
    
    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#isOfType">
        <rdfs:label>isOfType</rdfs:label>
        <rdfs:comment>Relates an entity to its type.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Aggregation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#TransferRights"/>
        <dc:source>(competency_question) CQ03</dc:source>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasRole">
        <rdfs:label>hasRole</rdfs:label>
        <rdfs:comment>Relates a contract party to a role.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#ContractParty"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Role"/>
        <dc:source>(competency_question) CQ06</dc:source>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasOperator">
        <rdfs:label>hasOperator</rdfs:label>
        <rdfs:comment>Relates an expression or constraint to an operator.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Expression"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Operator"/>
        <dc:source>(competency_question) CQ08</dc:source>
        <dc:source>(competency_question) CQ14</dc:source>
        <dc:source>(competency_question) New CQ6</dc:source>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasRight">
        <rdfs:label>hasRight</rdfs:label>
        <rdfs:comment>Relates a contract party to a right.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#ContractParty"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Right"/>
        <dc:source>(competency_question) CQ10</dc:source>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasDuty">
        <rdfs:label>hasDuty</rdfs:label>
        <rdfs:comment>Relates a contract party to a duty.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#ContractParty"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Duty"/>
        <dc:source>(competency_question) CQ10</dc:source>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasConstraint">
        <rdfs:label>hasConstraint</rdfs:label>
        <rdfs:comment>Relates an entity to a constraint. Can be used for nesting.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
        <dc:source>(competency_question) CQ13</dc:source>
        <dc:source>(competency_question) CQ21</dc:source>
        <dc:source>(competency_question) New CQ6</dc:source>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#expressedVia">
        <rdfs:label>expressedVia</rdfs:label>
        <rdfs:comment>Relates a condition to a constraint.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Condition"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
        <dc:source>(competency_question) CQ26</dc:source>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasPart">
        <rdfs:label>hasPart</rdfs:label>
        <rdfs:comment>Relates REL to Sequencing.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#REL"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Sequencing"/>
        <dc:source>(competency_question) CQ31</dc:source>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#canExpress">
        <rdfs:label>canExpress</rdfs:label>
        <rdfs:comment>Relates a data model to what it can express.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#DataModel"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Inheritance"/>
        <dc:source>(competency_question) CQ33</dc:source>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#linkedTo">
        <rdfs:label>linkedTo</rdfs:label>
        <rdfs:comment>Relates a policy to an asset.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Policy"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Asset"/>
        <dc:source>(competency_question) New CQ1</dc:source>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#specifies">
        <rdfs:label>specifies</rdfs:label>
        <rdfs:comment>Relates a policy to a conflict resolution strategy.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Policy"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#ConflictResolutionStrategy"/>
        <dc:source>(competency_question) New CQ2</dc:source>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasRemedyForViolation">
        <rdfs:label>hasRemedyForViolation</rdfs:label>
        <rdfs:comment>Relates a prohibition to a duty that is a remedy for its violation.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Prohibition"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Duty"/>
        <dc:source>(competency_question) New CQ3</dc:source>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#activatedUponFailureOf">
        <rdfs:label>activatedUponFailureOf</rdfs:label>
        <rdfs:comment>Relates a rule to another rule whose failure activates it.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Rule"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Rule"/>
        <dc:source>(competency_question) New CQ4</dc:source>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasConsequence">
        <rdfs:label>hasConsequence</rdfs:label>
        <rdfs:comment>Relates a duty to another duty that is its consequence.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Duty"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Duty"/>
        <dc:source>(competency_question) New CQ5</dc:source>
    </owl:ObjectProperty>
    
    <!-- Data Properties -->
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/odrl#isExclusive">
        <rdfs:label>isExclusive</rdfs:label>
        <rdfs:comment>Indicates if a permission is exclusive.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Permission"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <dc:source>(competency_question) CQ24</dc:source>
    </owl:DatatypeProperty>
    
    <!-- Individuals -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#NOT">
        <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Expression"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Operator"/>
        <rdfs:label>NOT</rdfs:label>
        <rdfs:comment>The NOT operator.</rdfs:comment>
        <dc:source>(competency_question) CQ08</dc:source>
        <dc:source>(themis_test) NOT type Expression</dc:source>
        <vaem:rationale>Added type Expression to satisfy Themis test 'NOT type Expression'.</vaem:rationale>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#AND">
        <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Operator"/>
        <rdfs:label>AND</rdfs:label>
        <rdfs:comment>The AND operator.</rdfs:comment>
        <dc:source>(competency_question) CQ14</dc:source>
        <dc:source>(themis_test) Constraint hasOperator AND</dc:source>
        <vaem:rationale>Added individual AND of type Operator to satisfy Themis test.</vaem:rationale>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#OR">
        <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Operator"/>
        <rdfs:label>OR</rdfs:label>
        <rdfs:comment>The OR operator.</rdfs:comment>
        <dc:source>(competency_question) CQ14</dc:source>
        <dc:source>(themis_test) Constraint hasOperator OR</dc:source>
        <vaem:rationale>Added individual OR of type Operator to satisfy Themis test.</vaem:rationale>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#XOR">
        <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Operator"/>
        <rdfs:label>XOR</rdfs:label>
        <rdfs:comment>The XOR operator.</rdfs:comment>
        <dc:source>(competency_question) CQ14</dc:source>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#Inheritance">
        <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Inheritance"/>
        <rdfs:label>Inheritance</rdfs:label>
        <rdfs:comment>The concept of inheritance.</rdfs:comment>
        <dc:source>(competency_question) CQ33</dc:source>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#ConflictResolutionStrategy">
        <rdf:type rdf:resource="http://www.semanticweb.org/odrl#ConflictResolutionStrategy"/>
        <rdfs:label>ConflictResolutionStrategy</rdfs:label>
        <rdfs:comment>A conflict resolution strategy.</rdfs:comment>
        <dc:source>(competency_question) New CQ2</dc:source>
    </owl:NamedIndividual>
    
    <!-- Axioms for tests -->
    <owl:Axiom>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/odrl#TransferRights"/>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/odrl#Aggregation"/>
        <owl:annotatedProperty rdf:resource="http://www.semanticweb.org/odrl#isOfType"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectPropertyAssertion"/>
        <dc:source>(competency_question) CQ03</dc:source>
    </owl:Axiom>
    
    <owl:Axiom>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/odrl#NOT"/>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/odrl#Expression"/>
        <owl:annotatedProperty rdf:resource="http://www.semanticweb.org/odrl#hasOperator"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectPropertyAssertion"/>
        <dc:source>(competency_question) CQ08</dc:source>
        <dc:source>(themis_test) Expression hasOperator NOT</dc:source>
        <vaem:rationale>Added property assertion to satisfy Themis test 'Expression hasOperator NOT'.</vaem:rationale>
    </owl:Axiom>
    
    <owl:Axiom>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/odrl#AND"/>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
        <owl:annotatedProperty rdf:resource="http://www.semanticweb.org/odrl#hasOperator"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectPropertyAssertion"/>
        <dc:source>(competency_question) CQ14</dc:source>
        <dc:source>(themis_test) Constraint hasOperator AND</dc:source>
        <vaem:rationale>Added property assertion to satisfy Themis test 'Constraint hasOperator AND'.</vaem:rationale>
    </owl:Axiom>
    
    <owl:Axiom>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/odrl#OR"/>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
        <owl:annotatedProperty rdf:resource="http://www.semanticweb.org/odrl#hasOperator"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectPropertyAssertion"/>
        <dc:source>(competency_question) CQ14</dc:source>
        <dc:source>(themis_test) Constraint hasOperator OR</dc:source>
        <vaem:rationale>Added property assertion to satisfy Themis test 'Constraint hasOperator OR'.</vaem:rationale>
    </owl:Axiom>
    
    <!-- Additional domain/range for hasConstraint for Requirement -->
    <owl:Axiom>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/odrl#Requirement"/>
        <owl:annotatedProperty rdf:resource="http://www.semanticweb.org/odrl#hasConstraint"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectPropertyAssertion"/>
        <dc:source>(competency_question) CQ21</dc:source>
    </owl:Axiom>
    
    <!-- Additional domain/range for hasConstraint for Prohibition -->
    <owl:Axiom>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/odrl#Prohibition"/>
        <owl:annotatedProperty rdf:resource="http://www.semanticweb.org/odrl#hasConstraint"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectPropertyAssertion"/>
        <dc:source>(competency_question) New CQ6</dc:source>
    </owl:Axiom>
    
    <!-- Additional domain/range for hasOperator for Constraint (for New CQ6) -->
    <owl:Axiom>
        <owl:annotatedTarget rdf:resource="http://www.semanticweb.org/odrl#Operator"/>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
        <owl:annotatedProperty rdf:resource="http://www.semanticweb.org/odrl#hasOperator"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectPropertyAssertion"/>
        <dc:source>(competency_question) New CQ6</dc:source>
    </owl:Axiom>
    
</rdf:RDF>