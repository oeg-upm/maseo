<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:vaem="http://www.semanticweb.org/vaem/ontology/1.0#"
         xml:base="http://www.semanticweb.org/swo#">

  <owl:Ontology rdf:about="http://www.semanticweb.org/swo#">
    <rdfs:label>Software and Tool Ontology</rdfs:label>
    <rdfs:comment>Ontology covering software, tools, algorithms, and related concepts for competency questions.</rdfs:comment>
    <dc:source>(competency_question) CQ04, CQ05, CQ06, CQ07, CQ08, CQ11, CQ14, CQ15, CQ16, CQ17, CQ19, CQ21, CQ22, CQ23, CQ26, CQ29, CQ30, CQ32, CQ36, CQ37, CQ38, CQ40, CQ45, CQ46, CQ54, CQ55, CQ57, CQ58, CQ59, CQ60, CQ65, CQ68, CQ73, CQ84, CQ85</dc:source>
  </owl:Ontology>

  <!-- Classes -->
  <owl:Class rdf:about="http://www.semanticweb.org/swo#Algorithm">
    <rdfs:label>Algorithm</rdfs:label>
    <rdfs:comment>An algorithm used by a tool.</rdfs:comment>
    <dc:source>(competency_question) CQ04, CQ05</dc:source>
    <vaem:rationale>Created to model algorithms used by tools.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Tool">
    <rdfs:label>Tool</rdfs:label>
    <rdfs:comment>A tool that uses algorithms and may have modifications.</rdfs:comment>
    <dc:source>(competency_question) CQ04, CQ05</dc:source>
    <vaem:rationale>Created to model tools.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Publication">
    <rdfs:label>Publication</rdfs:label>
    <rdfs:comment>A publication describing an algorithm.</rdfs:comment>
    <dc:source>(competency_question) CQ04</dc:source>
    <vaem:rationale>Created to model publications.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Modification">
    <rdfs:label>Modification</rdfs:label>
    <rdfs:comment>A modification to an algorithm.</rdfs:comment>
    <dc:source>(competency_question) CQ05</dc:source>
    <vaem:rationale>Created to model modifications.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Software">
    <rdfs:label>Software</rdfs:label>
    <rdfs:comment>Software application or tool.</rdfs:comment>
    <dc:source>(competency_question) CQ06, CQ07, CQ08, CQ11, CQ14, CQ15, CQ16, CQ17, CQ19, CQ21, CQ22, CQ23, CQ26, CQ29, CQ30, CQ32, CQ36, CQ37, CQ38, CQ40, CQ45, CQ46, CQ54, CQ55, CQ57, CQ58, CQ59, CQ60, CQ65, CQ68, CQ73, CQ84, CQ85</dc:source>
    <vaem:rationale>Created to model software.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#XML">
    <rdfs:label>XML</rdfs:label>
    <rdfs:comment>XML format.</rdfs:comment>
    <dc:source>(competency_question) CQ06</dc:source>
    <vaem:rationale>Created to model XML format.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#SoftwareType">
    <rdfs:label>Software Type</rdfs:label>
    <rdfs:comment>Type of software, e.g., API, Desktop application.</rdfs:comment>
    <dc:source>(competency_question) CQ07</dc:source>
    <vaem:rationale>Created to model software types.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Task">
    <rdfs:label>Task</rdfs:label>
    <rdfs:comment>A task that software can perform.</rdfs:comment>
    <dc:source>(competency_question) CQ08, CQ14, CQ16</dc:source>
    <vaem:rationale>Created to model tasks.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#WebService">
    <rdfs:label>Web Service</rdfs:label>
    <rdfs:comment>A web service.</rdfs:comment>
    <dc:source>(competency_question) CQ11</dc:source>
    <vaem:rationale>Created to model web services.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Functionality">
    <rdfs:label>Functionality</rdfs:label>
    <rdfs:comment>Functionality provided by software.</rdfs:comment>
    <dc:source>(competency_question) CQ14</dc:source>
    <vaem:rationale>Created to model functionalities.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Data">
    <rdfs:label>Data</rdfs:label>
    <rdfs:comment>Data that software can work with or create.</rdfs:comment>
    <dc:source>(competency_question) CQ15, CQ16, CQ23, CQ29</dc:source>
    <vaem:rationale>Created to model data.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Format">
    <rdfs:label>Format</rdfs:label>
    <rdfs:comment>Data format.</rdfs:comment>
    <dc:source>(competency_question) CQ17, CQ26</dc:source>
    <vaem:rationale>Created to model formats.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#FileFormat">
    <rdfs:label>File Format</rdfs:label>
    <rdfs:comment>File format, e.g., .cel.</rdfs:comment>
    <dc:source>(competency_question) CQ19</dc:source>
    <vaem:rationale>Created to model file formats.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Input">
    <rdfs:label>Input</rdfs:label>
    <rdfs:comment>Input to software.</rdfs:comment>
    <dc:source>(competency_question) CQ21, CQ29</dc:source>
    <vaem:rationale>Created to model inputs.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#ProprietaryFormat">
    <rdfs:label>Proprietary Format</rdfs:label>
    <rdfs:comment>Proprietary data format.</rdfs:comment>
    <dc:source>(competency_question) CQ22</dc:source>
    <vaem:rationale>Created to model proprietary formats.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#OpenFormat">
    <rdfs:label>Open Format</rdfs:label>
    <rdfs:comment>Open data format, e.g., csv, txt.</rdfs:comment>
    <dc:source>(competency_question) CQ22</dc:source>
    <vaem:rationale>Created to model open formats.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#License">
    <rdfs:label>License</rdfs:label>
    <rdfs:comment>Software license.</rdfs:comment>
    <dc:source>(competency_question) CQ26, CQ58, CQ59, CQ60, CQ65, CQ68</dc:source>
    <vaem:rationale>Created to model licenses.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Version">
    <rdfs:label>Version</rdfs:label>
    <rdfs:comment>Software version.</rdfs:comment>
    <dc:source>(competency_question) CQ29, CQ46, CQ54, CQ55, CQ57</dc:source>
    <vaem:rationale>Created to model versions.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Export">
    <rdfs:label>Export</rdfs:label>
    <rdfs:comment>Data export from software.</rdfs:comment>
    <dc:source>(competency_question) CQ29</dc:source>
    <vaem:rationale>Created to model exports.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#DownloadLocation">
    <rdfs:label>Download Location</rdfs:label>
    <rdfs:comment>Location to download software.</rdfs:comment>
    <dc:source>(competency_question) CQ30</dc:source>
    <vaem:rationale>Created to model download locations.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#HelpResource">
    <rdfs:label>Help Resource</rdfs:label>
    <rdfs:comment>Help resource for software.</rdfs:comment>
    <dc:source>(competency_question) CQ32</dc:source>
    <vaem:rationale>Created to model help resources.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Developer">
    <rdfs:label>Developer</rdfs:label>
    <rdfs:comment>Developer of software.</rdfs:comment>
    <dc:source>(competency_question) CQ36, CQ38</dc:source>
    <vaem:rationale>Created to model developers.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Homepage">
    <rdfs:label>Homepage</rdfs:label>
    <rdfs:comment>Homepage of software.</rdfs:comment>
    <dc:source>(competency_question) CQ37</dc:source>
    <vaem:rationale>Created to model homepages.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Collaboration">
    <rdfs:label>Collaboration</rdfs:label>
    <rdfs:comment>Collaboration opportunity with developers.</rdfs:comment>
    <dc:source>(competency_question) CQ38</dc:source>
    <vaem:rationale>Created to model collaborations.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#URL">
    <rdfs:label>URL</rdfs:label>
    <rdfs:comment>URL to obtain software.</rdfs:comment>
    <dc:source>(competency_question) CQ40</dc:source>
    <vaem:rationale>Created to model URLs.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#ReleaseDate">
    <rdfs:label>Release Date</rdfs:label>
    <rdfs:comment>Release date of software.</rdfs:comment>
    <dc:source>(competency_question) CQ45</dc:source>
    <vaem:rationale>Created to model release dates.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Community">
    <rdfs:label>Community</rdfs:label>
    <rdfs:comment>Community development for software.</rdfs:comment>
    <dc:source>(competency_question) CQ58</dc:source>
    <vaem:rationale>Created to model communities.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Permissiveness">
    <rdfs:label>Permissiveness</rdfs:label>
    <rdfs:comment>Permissiveness level of a license.</rdfs:comment>
    <dc:source>(competency_question) CQ59</dc:source>
    <vaem:rationale>Created to model permissiveness.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Documentation">
    <rdfs:label>Documentation</rdfs:label>
    <rdfs:comment>Documentation for software.</rdfs:comment>
    <dc:source>(competency_question) CQ73</dc:source>
    <vaem:rationale>Created to model documentation.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#ProgrammingLanguage">
    <rdfs:label>Programming Language</rdfs:label>
    <rdfs:comment>Programming language used to implement software.</rdfs:comment>
    <dc:source>(competency_question) CQ84</dc:source>
    <vaem:rationale>Created to model programming languages.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Platform">
    <rdfs:label>Platform</rdfs:label>
    <rdfs:comment>Platform on which software runs.</rdfs:comment>
    <dc:source>(competency_question) CQ85</dc:source>
    <vaem:rationale>Created to model platforms.</vaem:rationale>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/swo#Feature">
    <rdfs:label>Feature</rdfs:label>
    <rdfs:comment>Feature of a software version.</rdfs:comment>
    <dc:source>(competency_question) CQ55</dc:source>
    <vaem:rationale>Created to model features.</vaem:rationale>
  </owl:Class>

  <!-- Object Properties -->
  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#usesAlgorithm">
    <rdfs:label>uses algorithm</rdfs:label>
    <rdfs:comment>Tool uses an algorithm.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Tool"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Algorithm"/>
    <dc:source>(competency_question) CQ04, CQ05</dc:source>
    <vaem:rationale>Created to link tools to algorithms.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasPublication">
    <rdfs:label>has publication</rdfs:label>
    <rdfs:comment>Algorithm has a publication.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Algorithm"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Publication"/>
    <dc:source>(competency_question) CQ04</dc:source>
    <vaem:rationale>Created to link algorithms to publications.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasModification">
    <rdfs:label>has modification</rdfs:label>
    <rdfs:comment>Tool has a modification to its algorithm.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Tool"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Modification"/>
    <dc:source>(competency_question) CQ05</dc:source>
    <vaem:rationale>Created to link tools to modifications.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#editsFormat">
    <rdfs:label>edits format</rdfs:label>
    <rdfs:comment>Software edits a format (e.g., XML).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#XML"/>
    <dc:source>(competency_question) CQ06</dc:source>
    <vaem:rationale>Created to link software to edited formats.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasType">
    <rdfs:label>has type</rdfs:label>
    <rdfs:comment>Software has a type (e.g., API, Desktop application).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#SoftwareType"/>
    <dc:source>(competency_question) CQ07</dc:source>
    <vaem:rationale>Created to link software to its type.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#performsTask">
    <rdfs:label>performs task</rdfs:label>
    <rdfs:comment>Software performs a task.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Task"/>
    <dc:source>(competency_question) CQ08, CQ14, CQ16</dc:source>
    <vaem:rationale>Created to link software to tasks.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#isAvailableAs">
    <rdfs:label>is available as</rdfs:label>
    <rdfs:comment>Software is available as a web service.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#WebService"/>
    <dc:source>(competency_question) CQ11</dc:source>
    <vaem:rationale>Created to link software to web services.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasFunctionality">
    <rdfs:label>has functionality</rdfs:label>
    <rdfs:comment>Software has a functionality.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Functionality"/>
    <dc:source>(competency_question) CQ14</dc:source>
    <vaem:rationale>Created to link software to functionalities.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#createdData">
    <rdfs:label>created data</rdfs:label>
    <rdfs:comment>Software created data.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Data"/>
    <dc:source>(competency_question) CQ15</dc:source>
    <vaem:rationale>Created to link software to created data.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#worksWithData">
    <rdfs:label>works with data</rdfs:label>
    <rdfs:comment>Software works with data.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Data"/>
    <dc:source>(competency_question) CQ16, CQ23</dc:source>
    <vaem:rationale>Created to link software to data it works with.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasInputFormat">
    <rdfs:label>has input format</rdfs:label>
    <rdfs:comment>Software has an input format.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Format"/>
    <dc:source>(competency_question) CQ17</dc:source>
    <vaem:rationale>Created to link software to input formats.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasOutputFormat">
    <rdfs:label>has output format</rdfs:label>
    <rdfs:comment>Software has an output format.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Format"/>
    <dc:source>(competency_question) CQ17</dc:source>
    <vaem:rationale>Created to link software to output formats.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#canRead">
    <rdfs:label>can read</rdfs:label>
    <rdfs:comment>Software can read a file format.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#FileFormat"/>
    <dc:source>(competency_question) CQ19</dc:source>
    <vaem:rationale>Created to link software to readable file formats.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasValidInput">
    <rdfs:label>has valid input</rdfs:label>
    <rdfs:comment>Software has valid input.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Input"/>
    <dc:source>(competency_question) CQ21</dc:source>
    <vaem:rationale>Created to link software to valid inputs.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#exportsTo">
    <rdfs:label>exports to</rdfs:label>
    <rdfs:comment>Software exports to an open format.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#OpenFormat"/>
    <dc:source>(competency_question) CQ22</dc:source>
    <vaem:rationale>Created to link software to export formats.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#outputsData">
    <rdfs:label>outputs data</rdfs:label>
    <rdfs:comment>Software outputs data.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Data"/>
    <dc:source>(competency_question) CQ23</dc:source>
    <vaem:rationale>Created to link software to output data.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#canProcess">
    <rdfs:label>can process</rdfs:label>
    <rdfs:comment>Software can process a format.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Format"/>
    <dc:source>(competency_question) CQ26</dc:source>
    <vaem:rationale>Created to link software to processable formats.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasLicense">
    <rdfs:label>has license</rdfs:label>
    <rdfs:comment>Software has a license.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#License"/>
    <dc:source>(competency_question) CQ26, CQ58, CQ59, CQ60, CQ65, CQ68</dc:source>
    <vaem:rationale>Created to link software to licenses.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasVersion">
    <rdfs:label>has version</rdfs:label>
    <rdfs:comment>Software has a version.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Version"/>
    <dc:source>(competency_question) CQ29, CQ46, CQ54, CQ55, CQ57</dc:source>
    <vaem:rationale>Created to link software to versions.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasInput">
    <rdfs:label>has input</rdfs:label>
    <rdfs:comment>Software has an input.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Input"/>
    <dc:source>(competency_question) CQ29</dc:source>
    <vaem:rationale>Created to link software to inputs.</vaem:rationale>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasExport">
    <rdfs:label>has export</rdfs:label>
    <rdfs:comment>Software has an export.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Export"/>
    <dc:source>(competency_question) CQ29</dc:source>
    <vaem:rationale>Created to link software to exports.</vaem:rationale>
