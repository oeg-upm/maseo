@prefix vtc: <https://w3id.org/def/vtc#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix : <http://www.semanticweb.org/wine/tests#> .

:suite rdf:type owl:NamedIndividual , vtc:TestSuite .

:CQ1 rdf:type owl:NamedIndividual , vtc:Requirement ;
    vtc:requirementId "CQ1"^^xsd:string ;
    vtc:category "competency question"^^xsd:string ;
    dcterms:description "Which wine characteristics should I consider when choosing a wine?"^^xsd:string .

:CQ1_test1 rdf:type owl:NamedIndividual , vtc:TestCaseDesign ;
    vtc:belongsTo :suite ;
    vtc:comesFromRequirement :CQ1 ;
    vtc:isRelatedToRequirement "http://www.semanticweb.org/wine#CQ1"^^xsd:anyURI ;
    vtc:desiredBehaviour "WineCharacteristic type Class"^^xsd:string .

:CQ1_test2 rdf:type owl:NamedIndividual , vtc:TestCaseDesign ;
    vtc:belongsTo :suite ;
    vtc:comesFromRequirement :CQ1 ;
    vtc:isRelatedToRequirement "http://www.semanticweb.org/wine#CQ1"^^xsd:anyURI ;
    vtc:desiredBehaviour "hasCharacteristic type Property"^^xsd:string .

:CQ1_test3 rdf:type owl:NamedIndividual , vtc:TestCaseDesign ;
    vtc:belongsTo :suite ;
    vtc:comesFromRequirement :CQ1 ;
    vtc:isRelatedToRequirement "http://www.semanticweb.org/wine#CQ1"^^xsd:anyURI ;
    vtc:desiredBehaviour "Wine hasCharacteristic WineCharacteristic"^^xsd:string .

