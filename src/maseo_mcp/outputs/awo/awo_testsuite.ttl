@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix : <http://www.semanticweb.org/awo/tests#> .

:suite rdf:type owl:NamedIndividual , vtc:TestSuite .

:CQ1 rdf:type owl:NamedIndividual , vtc:Requirement ;
    vtc:requirementId "CQ1"^^xsd:string ;
    vtc:category "competency question"^^xsd:string ;
    dcterms:description "Which animal eats which other animal?"^^xsd:string .

:CQ1_test1 rdf:type owl:NamedIndividual , vtc:TestCaseDesign ;
    vtc:belongsTo :suite ;
    vtc:comesFromRequirement :CQ1 ;
    vtc:isRelatedToRequirement "http://www.semanticweb.org/awo#CQ1"^^xsd:anyURI ;
    vtc:desiredBehaviour "Animal type Class"^^xsd:string .

:CQ1_test2 rdf:type owl:NamedIndividual , vtc:TestCaseDesign ;
    vtc:belongsTo :suite ;
    vtc:comesFromRequirement :CQ1 ;
    vtc:isRelatedToRequirement "http://www.semanticweb.org/awo#CQ1"^^xsd:anyURI ;
    vtc:desiredBehaviour "eats type Property"^^xsd:string .

:CQ1_test3 rdf:type owl:NamedIndividual , vtc:TestCaseDesign ;
    vtc:belongsTo :suite ;
    vtc:comesFromRequirement :CQ1 ;
    vtc:isRelatedToRequirement "http://www.semanticweb.org/awo#CQ1"^^xsd:anyURI ;
    vtc:desiredBehaviour "Animal eats Animal"^^xsd:string .

