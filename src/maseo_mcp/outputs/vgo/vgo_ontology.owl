<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:vaem="http://www.linkedmodel.org/1.0/vaem#">

  <owl:Ontology rdf:about="http://www.semanticweb.org/vgo#">
    <rdfs:label>Video Game Ontology</rdfs:label>
    <rdfs:comment>Ontology for video game domain covering players, games, achievements, items, in-app purchases, and related entities.</rdfs:comment>
  </owl:Ontology>

  <!-- Classes -->
  <owl:Class rdf:about="http://www.semanticweb.org/vgo#Player">
    <rdfs:label>Player</rdfs:label>
    <rdfs:comment>A person who plays video games.</rdfs:comment>
    <dc:source>(competency_question) CQ01</dc:source>
    <dc:source>(competency_question) CQ02</dc:source>
    <dc:source>(competency_question) CQ03</dc:source>
    <dc:source>(competency_question) CQ05</dc:source>
    <dc:source>(competency_question) CQ07</dc:source>
    <dc:source>(competency_question) CQ22</dc:source>
    <dc:source>(competency_question) CQ24</dc:source>
    <dc:source>(competency_question) CQ25</dc:source>
    <dc:source>(competency_question) CQ26</dc:source>
    <dc:source>(competency_question) CQ27</dc:source>
    <dc:source>(competency_question) CQ29</dc:source>
    <dc:source>(competency_question) CQ35</dc:source>
    <dc:source>(competency_question) CQ52</dc:source>
    <dc:source>(competency_question) CQ56</dc:source>
    <dc:source>(competency_question) CQ57</dc:source>
    <dc:source>(competency_question) CQ63</dc:source>
    <dc:source>(competency_question) CQ64</dc:source>
    <dc:source>(competency_question) CQ65</dc:source>
    <dc:source>(competency_question) CQ66</dc:source>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/vgo#Game">
    <rdfs:label>Game</rdfs:label>
    <rdfs:comment>A video game.</rdfs:comment>
    <dc:source>(competency_question) CQ03</dc:source>
    <dc:source>(competency_question) CQ08</dc:source>
    <dc:source>(competency_question) CQ09</dc:source>
    <dc:source>(competency_question) CQ10</dc:source>
    <dc:source>(competency_question) CQ11</dc:source>
    <dc:source>(competency_question) CQ12</dc:source>
    <dc:source>(competency_question) CQ13</dc:source>
    <dc:source>(competency_question) CQ15</dc:source>
    <dc:source>(competency_question) CQ17</dc:source>
    <dc:source>(competency_question) CQ22</dc:source>
    <dc:source>(competency_question) CQ25</dc:source>
    <dc:source>(competency_question) CQ29</dc:source>
    <dc:source>(competency_question) CQ35</dc:source>
    <dc:source>(competency_question) CQ52</dc:source>
    <dc:source>(competency_question) CQ55</dc:source>
    <dc:source>(competency_question) New CQ1</dc:source>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/vgo#Achievement">
    <rdfs:label>Achievement</rdfs:label>
    <rdfs:comment>An achievement that can be obtained in a game.</rdfs:comment>
    <dc:source>(competency_question) CQ05</dc:source>
    <dc:source>(competency_question) CQ07</dc:source>
    <dc:source>(competency_question) CQ08</dc:source>
    <dc:source>(competency_question) CQ24</dc:source>
    <dc:source>(competency_question) CQ27</dc:source>
    <dc:source>(competency_question) CQ35</dc:source>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/vgo#AchievementType">
    <rdfs:label>AchievementType</rdfs:label>
    <rdfs:comment>The type or category of an achievement.</rdfs:comment>
    <dc:source>(competency_question) CQ10</dc:source>
    <dc:source>(competency_question) CQ11</dc:source>
    <dc:source>(competency_question) CQ27</dc:source>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/vgo#Genre">
    <rdfs:label>Genre</rdfs:label>
    <rdfs:comment>A genre of a game.</rdfs:comment>
    <dc:source>(competency_question) CQ12</dc:source>
    <dc:source>(competency_question) CQ17</dc:source>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/vgo#Item">
    <rdfs:label>Item</rdfs:label>
    <rdfs:comment>An item that exists in a game or is owned by a player.</rdfs:comment>
    <dc:source>(competency_question) CQ13</dc:source>
    <dc:source>(competency_question) CQ19</dc:source>
    <dc:source>(competency_question) CQ26</dc:source>
    <dc:source>(competency_question) CQ52</dc:source>
    <dc:source>(competency_question) CQ55</dc:source>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/vgo#Ability">
    <rdfs:label>Ability</rdfs:label>
    <rdfs:comment>An ability that an item can provide.</rdfs:comment>
    <dc:source>(competency_question) CQ19</dc:source>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/vgo#InAppPurchase">
    <rdfs:label>InAppPurchase</rdfs:label>
    <rdfs:comment>An in-app purchase made by a player.</rdfs:comment>
    <dc:source>(competency_question) CQ56</dc:source>
    <dc:source>(competency_question) CQ57</dc:source>
    <dc:source>(competency_question) CQ62</dc:source>
    <dc:source>(competency_question) CQ64</dc:source>
    <dc:source>(competency_question) CQ66</dc:source>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/vgo#Location">
    <rdfs:label>Location</rdfs:label>
    <rdfs:comment>A geographic location where a player lives.</rdfs:comment>
    <dc:source>(competency_question) CQ63</dc:source>
    <dc:source>(competency_question) CQ65</dc:source>
    <dc:source>(competency_question) CQ66</dc:source>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/vgo#PlayingArea">
    <rdfs:label>PlayingArea</rdfs:label>
    <rdfs:comment>An area within a game where gameplay occurs.</rdfs:comment>
    <dc:source>(competency_question) New CQ1</dc:source>
  </owl:Class>

  <!-- Object Properties -->
  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasFriend">
    <rdfs:label>hasFriend</rdfs:label>
    <rdfs:comment>Relates a player to another player who is a friend.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Player"/>
    <dc:source>(competency_question) CQ02</dc:source>
    <dc:source>(competency_question) CQ03</dc:source>
    <dc:source>(competency_question) CQ05</dc:source>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#playsGame">
    <rdfs:label>playsGame</rdfs:label>
    <rdfs:comment>Relates a player to a game they play.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Game"/>
    <dc:source>(competency_question) CQ03</dc:source>
    <dc:source>(competency_question) CQ22</dc:source>
    <dc:source>(competency_question) CQ25</dc:source>
    <dc:source>(competency_question) CQ29</dc:source>
    <dc:source>(competency_question) CQ35</dc:source>
    <dc:source>(competency_question) CQ52</dc:source>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasAchievement">
    <rdfs:label>hasAchievement</rdfs:label>
    <rdfs:comment>Relates a player to an achievement they have earned, or a game to an achievement it contains.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
    <dc:source>(competency_question) CQ05</dc:source>
    <dc:source>(competency_question) CQ07</dc:source>
    <dc:source>(competency_question) CQ08</dc:source>
    <dc:source>(competency_question) CQ24</dc:source>
    <dc:source>(competency_question) CQ27</dc:source>
    <dc:source>(competency_question) CQ35</dc:source>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasType">
    <rdfs:label>hasType</rdfs:label>
    <rdfs:comment>Relates an achievement to its type.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#AchievementType"/>
    <dc:source>(competency_question) CQ10</dc:source>
    <dc:source>(competency_question) CQ11</dc:source>
    <dc:source>(competency_question) CQ27</dc:source>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasGenre">
    <rdfs:label>hasGenre</rdfs:label>
    <rdfs:comment>Relates a game to its genre.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Genre"/>
    <dc:source>(competency_question) CQ12</dc:source>
    <dc:source>(competency_question) CQ17</dc:source>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasItem">
    <rdfs:label>hasItem</rdfs:label>
    <rdfs:comment>Relates a game to an item it contains, or a player to an item they own.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Item"/>
    <dc:source>(competency_question) CQ13</dc:source>
    <dc:source>(competency_question) CQ19</dc:source>
    <dc:source>(competency_question) CQ26</dc:source>
    <dc:source>(competency_question) CQ52</dc:source>
    <dc:source>(competency_question) CQ55</dc:source>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#providesAbility">
    <rdfs:label>providesAbility</rdfs:label>
    <rdfs:comment>Relates an item to an ability it provides.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Item"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Ability"/>
    <dc:source>(competency_question) CQ19</dc:source>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasPurchase">
    <rdfs:label>hasPurchase</rdfs:label>
    <rdfs:comment>Relates a player to an in-app purchase they made.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#InAppPurchase"/>
    <dc:source>(competency_question) CQ56</dc:source>
    <dc:source>(competency_question) CQ57</dc:source>
    <dc:source>(competency_question) CQ64</dc:source>
    <dc:source>(competency_question) CQ66</dc:source>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#livesIn">
    <rdfs:label>livesIn</rdfs:label>
    <rdfs:comment>Relates a player to the location where they live.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Location"/>
    <dc:source>(competency_question) CQ63</dc:source>
    <dc:source>(competency_question) CQ65</dc:source>
    <dc:source>(competency_question) CQ66</dc:source>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasPlayingArea">
    <rdfs:label>hasPlayingArea</rdfs:label>
    <rdfs:comment>Relates a game to a playing area within it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#PlayingArea"/>
    <dc:source>(competency_question) New CQ1</dc:source>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasAchievementType">
    <rdfs:label>hasAchievementType</rdfs:label>
    <rdfs:comment>Relates a game to the types of achievements it contains.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#AchievementType"/>
    <dc:source>(competency_question) CQ10</dc:source>
    <dc:source>(competency_question) CQ11</dc:source>
    <dc:source>(competency_question) CQ27</dc:source>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasAbility">
    <rdfs:label>hasAbility</rdfs:label>
    <rdfs:comment>Relates an item to an ability it provides.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Item"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Ability"/>
    <dc:source>(competency_question) CQ19</dc:source>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#lastPlayedGame">
    <rdfs:label>lastPlayedGame</rdfs:label>
    <rdfs:comment>Relates a player to the last game they played.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Game"/>
    <dc:source>(competency_question) CQ29</dc:source>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#usableInGame">
    <rdfs:label>usableInGame</rdfs:label>
    <rdfs:comment>Relates an item to a game where it can be used.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Item"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Game"/>
    <dc:source>(competency_question) CQ55</dc:source>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasInAppPurchase">
    <rdfs:label>hasInAppPurchase</rdfs:label>
    <rdfs:comment>Relates a player to an in-app purchase they made.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#InAppPurchase"/>
    <dc:source>(competency_question) CQ56</dc:source>
    <dc:source>(competency_question) CQ57</dc:source>
    <dc:source>(competency_question) CQ64</dc:source>
    <dc:source>(competency_question) CQ66</dc:source>
  </owl:ObjectProperty>

  <!-- Data Properties -->
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#username">
    <rdfs:label>username</rdfs:label>
    <rdfs:comment>The username of a player.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dc:source>(competency_question) CQ01</dc:source>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#totalPlayTime">
    <rdfs:label>totalPlayTime</rdfs:label>
    <rdfs:comment>The total play time of a game in hours.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <dc:source>(competency_question) CQ09</dc:source>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#releaseDate">
    <rdfs:label>releaseDate</rdfs:label>
    <rdfs:comment>The release date of a game.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <dc:source>(competency_question) CQ15</dc:source>
    <dc:source>(error_message) HermiT does not support xsd:date; changed to xsd:dateTime</dc:source>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#hasKillCount">
    <rdfs:label>hasKillCount</rdfs:label>
    <rdfs:comment>The kill count of a player in a game.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dc:source>(competency_question) CQ22</dc:source>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#purchaseTime">
    <rdfs:label>purchaseTime</rdfs:label>
    <rdfs:comment>The time when an in-app purchase was made.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#InAppPurchase"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <dc:source>(competency_question) CQ62</dc:source>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#timeSpentBeforeFirstIAP">
    <rdfs:label>timeSpentBeforeFirstIAP</rdfs:label>
    <rdfs:comment>The time a player spent in the game before making their first in-app purchase.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <dc:source>(competency_question) CQ64</dc:source>
  </owl:DatatypeProperty>

</rdf:RDF>