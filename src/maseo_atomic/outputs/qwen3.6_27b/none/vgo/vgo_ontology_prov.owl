  <prov:actedOnBehalfOf rdf:resource="http://www.semanticweb.org/vgo_prov#MASEO"/>
  <prov:hadRole rdf:resource="http://www.semanticweb.org/vgo_prov#FixRole"/>
</prov:SoftwareAgent>

<prov:SoftwareAgent rdf:about="http://www.semanticweb.org/vgo_prov#MASEO">
  <rdfs:label>MASEO pipeline</rdfs:label>
</prov:SoftwareAgent>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/vgo_prov#GeneratorRole">
  <rdf:type rdf:resource="http://www.w3.org/ns/prov#Role"/>
  <rdfs:label>generator</rdfs:label>
  <rdfs:comment>Creates new content from the competency questions: CQ atomization, term extraction, ontology generation.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/vgo_prov#RefinementRole">
  <rdf:type rdf:resource="http://www.w3.org/ns/prov#Role"/>
  <rdfs:label>refinement</rdfs:label>
  <rdfs:comment>Filters or reshapes existing content: term identification/refinement, axiom and test proposal, other LLM stages.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/vgo_prov#FixRole">
  <rdf:type rdf:resource="http://www.w3.org/ns/prov#Role"/>
  <rdfs:label>fix</rdfs:label>
  <rdfs:comment>Corrects the ontology in response to a validation-tool failure (ontology correction).</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/vgo_prov#ValidatorRole">
  <rdf:type rdf:resource="http://www.w3.org/ns/prov#Role"/>
  <rdfs:label>validator</rdfs:label>
  <rdfs:comment>Checks the ontology without changing it: syntax, CQ coverage, OOPS, HermiT, Themis.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/vgo_prov#GenerationPrompt">
  <rdf:type rdf:resource="http://www.w3.org/ns/prov#Plan"/>
  <rdfs:label>generation prompt</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/vgo_prov#CorrectionPrompt">
  <rdf:type rdf:resource="http://www.w3.org/ns/prov#Plan"/>
  <rdfs:label>correction prompt</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/vgo_prov#ValidationPlan">
  <rdf:type rdf:resource="http://www.w3.org/ns/prov#Plan"/>
  <rdfs:label>validation plan</rdfs:label>
</owl:NamedIndividual>

<prov:SoftwareAgent rdf:about="http://www.semanticweb.org/vgo_prov#tool_syntax_check">
  <rdfs:label>syntax_check</rdfs:label>
  <prov:actedOnBehalfOf rdf:resource="http://www.semanticweb.org/vgo_prov#MASEO"/>
</prov:SoftwareAgent>

<prov:SoftwareAgent rdf:about="http://www.semanticweb.org/vgo_prov#tool_cq_coverage">
  <rdfs:label>cq_coverage</rdfs:label>
  <prov:actedOnBehalfOf rdf:resource="http://www.semanticweb.org/vgo_prov#MASEO"/>
</prov:SoftwareAgent>

<prov:SoftwareAgent rdf:about="http://www.semanticweb.org/vgo_prov#tool_oops_scan">
  <rdfs:label>oops_scan</rdfs:label>
  <prov:actedOnBehalfOf rdf:resource="http://www.semanticweb.org/vgo_prov#MASEO"/>
</prov:SoftwareAgent>

<prov:SoftwareAgent rdf:about="http://www.semanticweb.org/vgo_prov#tool_hermit_consistency">
  <rdfs:label>hermit_consistency</rdfs:label>
  <prov:actedOnBehalfOf rdf:resource="http://www.semanticweb.org/vgo_prov#MASEO"/>
</prov:SoftwareAgent>

<prov:SoftwareAgent rdf:about="http://www.semanticweb.org/vgo_prov#tool_themis_test">
  <rdfs:label>themis_test</rdfs:label>
  <prov:actedOnBehalfOf rdf:resource="http://www.semanticweb.org/vgo_prov#MASEO"/>
</prov:SoftwareAgent>

