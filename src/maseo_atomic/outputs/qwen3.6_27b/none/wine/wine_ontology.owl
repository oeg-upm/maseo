<?xml version="1.0"?>
<rdf:RDF xml:base="http://www.semanticweb.org/wine#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:vaem="http://www.linkedmodel.org/schema/vaem#">

  <owl:Ontology rdf:about="http://www.semanticweb.org/wine#"/>

  <!-- owl:Class declarations -->

<owl:Class rdf:about="http://www.semanticweb.org/wine#Wine">
  <rdfs:comment>A fermented grape beverage characterized by attributes, vintages, and grape varieties.</rdfs:comment>
  <rdfs:label>Wine</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Base class for all wines in CQ1, CQ2, CQ6, CQ7, CQnew1</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which wine characteristics should I consider when choosing a wine?
    (competency_question) CQ2: Is Bordeaux a red or white wine?
    (competency_question) CQ6: Does a bouquet or body of a specific wine change with vintage year?
    (competency_question) CQ7: What were good vintages for Napa Zinfandel?
    (competency_question) CQnew1: What grapes are used to make Bordeaux wine?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#Characteristic">
  <rdfs:comment>An attribute or quality of a wine.</rdfs:comment>
  <rdfs:label>Characteristic</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Superclass for wine attributes in CQ1</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which wine characteristics should I consider when choosing a wine?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#Bouquet">
  <rdfs:comment>The aroma and scent profile of a wine.</rdfs:comment>
  <rdfs:label>Bouquet</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Specific characteristic in CQ1 and CQ6</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which wine characteristics should I consider when choosing a wine?
    (competency_question) CQ6: Does a bouquet or body of a specific wine change with vintage year?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/wine#Characteristic"/>
  <!-- Axiom: SubClassOf Characteristic -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#Body">
  <rdfs:comment>The weight and texture of a wine on the palate.</rdfs:comment>
  <rdfs:label>Body</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Specific characteristic in CQ1 and CQ6</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which wine characteristics should I consider when choosing a wine?
    (competency_question) CQ6: Does a bouquet or body of a specific wine change with vintage year?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/wine#Characteristic"/>
  <!-- Axiom: SubClassOf Characteristic -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#Color">
  <rdfs:comment>The visual hue of a wine.</rdfs:comment>
  <rdfs:label>Color</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Specific characteristic in CQ1 and range for color property</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which wine characteristics should I consider when choosing a wine?
    (competency_question) CQ2: Is Bordeaux a red or white wine?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/wine#Characteristic"/>
  <!-- Axiom: SubClassOf Characteristic -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#Flavor">
  <rdfs:comment>The taste profile of a wine.</rdfs:comment>
  <rdfs:label>Flavor</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Specific characteristic in CQ1</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which wine characteristics should I consider when choosing a wine?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/wine#Characteristic"/>
  <!-- Axiom: SubClassOf Characteristic -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#Acidity">
  <rdfs:comment>The level of tartness in a wine.</rdfs:comment>
  <rdfs:label>Acidity</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Specific characteristic in CQ1</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which wine characteristics should I consider when choosing a wine?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/wine#Characteristic"/>
  <!-- Axiom: SubClassOf Characteristic -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#Tannin">
  <rdfs:comment>The astringent compounds in wine.</rdfs:comment>
  <rdfs:label>Tannin</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Specific characteristic in CQ1</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which wine characteristics should I consider when choosing a wine?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/wine#Characteristic"/>
  <!-- Axiom: SubClassOf Characteristic -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#RedWine">
  <rdfs:comment>A wine made from dark-colored grape varieties.</rdfs:comment>
  <rdfs:label>Red Wine</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Subclass of Wine in CQ2</vaem:rationale>
  <dc:source>(competency_question) CQ2: Is Bordeaux a red or white wine?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/wine#Wine"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/wine#WhiteWine"/>
  <!-- Axiom: Disjoint with WhiteWine -->
  <!-- Axiom: SubClassOf Wine -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#WhiteWine">
  <rdfs:comment>A wine made from white or light-colored grape varieties.</rdfs:comment>
  <rdfs:label>White Wine</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Subclass of Wine in CQ2</vaem:rationale>
  <dc:source>(competency_question) CQ2: Is Bordeaux a red or white wine?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/wine#Wine"/>
  <!-- Axiom: SubClassOf Wine -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#VintageYear">
  <rdfs:comment>The year in which the grapes for a wine were harvested.</rdfs:comment>
  <rdfs:label>Vintage Year</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Class for years in CQ6 and CQ7</vaem:rationale>
  <dc:source>(competency_question) CQ6: Does a bouquet or body of a specific wine change with vintage year?
    (competency_question) CQ7: What were good vintages for Napa Zinfandel?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#Grape">
  <rdfs:comment>The fruit used to produce wine.</rdfs:comment>
  <rdfs:label>Grape</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Class for grapes in CQnew1</vaem:rationale>
  <dc:source>(competency_question) CQnew1: What grapes are used to make Bordeaux wine?</dc:source>
</owl:Class>

  <!-- owl:ObjectProperty declarations -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#characteristic">
  <rdfs:comment>Relates a wine to one of its characteristics.</rdfs:comment>
  <rdfs:label>Characteristic</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Connects Wine to Characteristic in CQ1</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which wine characteristics should I consider when choosing a wine?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/wine#Characteristic"/>
  <!-- Axiom: domain Wine -->
  <!-- Axiom: range Characteristic -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#color">
  <rdfs:comment>Relates a wine to its color characteristic.</rdfs:comment>
  <rdfs:label>Color</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Connects Wine to Color in CQ2</vaem:rationale>
  <dc:source>(competency_question) CQ2: Is Bordeaux a red or white wine?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/wine#Color"/>
  <!-- Axiom: domain Wine -->
  <!-- Axiom: range Color -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#bouquet">
  <rdfs:comment>Relates a wine to its bouquet characteristic.</rdfs:comment>
  <rdfs:label>Bouquet</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Connects Wine to Bouquet in CQ6</vaem:rationale>
  <dc:source>(competency_question) CQ6: Does a bouquet or body of a specific wine change with vintage year?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/wine#Bouquet"/>
  <!-- Axiom: domain Wine -->
  <!-- Axiom: range Bouquet -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#body">
  <rdfs:comment>Relates a wine to its body characteristic.</rdfs:comment>
  <rdfs:label>Body</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Connects Wine to Body in CQ6</vaem:rationale>
  <dc:source>(competency_question) CQ6: Does a bouquet or body of a specific wine change with vintage year?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/wine#Body"/>
  <!-- Axiom: domain Wine -->
  <!-- Axiom: range Body -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#vintageYear">
  <rdfs:comment>Relates a wine to its harvest year.</rdfs:comment>
  <rdfs:label>Vintage Year</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Connects Wine to VintageYear in CQ6 and CQ7</vaem:rationale>
  <dc:source>(competency_question) CQ6: Does a bouquet or body of a specific wine change with vintage year?
    (competency_question) CQ7: What were good vintages for Napa Zinfandel?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/wine#VintageYear"/>
  <!-- Axiom: domain Wine -->
  <!-- Axiom: range VintageYear -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#variesWith">
  <rdfs:comment>Relates a wine characteristic to the vintage years in which it changes.</rdfs:comment>
  <rdfs:label>Varies With</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Connects Bouquet to VintageYear in CQ6</vaem:rationale>
  <dc:source>(competency_question) CQ6: Does a bouquet or body of a specific wine change with vintage year?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Bouquet"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/wine#VintageYear"/>
  <!-- Axiom: domain Bouquet -->
  <!-- Axiom: range VintageYear -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#usedToMake">
  <rdfs:comment>Relates a grape variety to the wine it is used to produce.</rdfs:comment>
  <rdfs:label>Used To Make</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Connects Grape to Wine in CQnew1</vaem:rationale>
  <dc:source>(competency_question) CQnew1: What grapes are used to make Bordeaux wine?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Grape"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/wine#Wine"/>
  <!-- Axiom: domain Grape -->
  <!-- Axiom: range Wine -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#grape">
  <rdfs:comment>Relates a wine to the grape variety used to make it.</rdfs:comment>
  <rdfs:label>Grape</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Inverse of usedToMake in CQnew1</vaem:rationale>
  <dc:source>(competency_question) CQnew1: What grapes are used to make Bordeaux wine?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/wine#Grape"/>
  <owl:inverseOf rdf:resource="http://www.semanticweb.org/wine#usedToMake"/>
  <!-- Axiom: domain Wine -->
  <!-- Axiom: range Grape -->
</owl:ObjectProperty>

  <!-- owl:NamedIndividual declarations -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/wine#Bordeaux">
  <rdfs:comment>A famous wine region and style.</rdfs:comment>
  <rdfs:label>Bordeaux</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Instance of Wine in CQ2 and CQnew1</vaem:rationale>
  <dc:source>(competency_question) CQ2: Is Bordeaux a red or white wine?
    (competency_question) CQnew1: What grapes are used to make Bordeaux wine?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/wine#Wine"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/wine#NapaZinfandel">
  <rdfs:comment>A specific wine style from Napa Valley.</rdfs:comment>
  <rdfs:label>Napa Zinfandel</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Instance of Wine in CQ7</vaem:rationale>
  <dc:source>(competency_question) CQ7: What were good vintages for Napa Zinfandel?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/wine#Wine"/>
</owl:NamedIndividual>

</rdf:RDF>