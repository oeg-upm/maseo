  <prov:used rdf:resource="http://www.semanticweb.org/awo_prov#Report_r1_themis_test_8"/>
  <prov:generated rdf:resource="http://www.semanticweb.org/awo#"/>
  <prov:wasInformedBy rdf:resource="http://www.semanticweb.org/awo_prov#GenerationActivity"/>
  <prov:wasInformedBy rdf:resource="http://www.semanticweb.org/awo_prov#Check_r1_themis_test_8"/>
  <prov:wasAssociatedWith rdf:resource="http://www.semanticweb.org/awo_prov#agent_OntoCorrection_Agent"/>
  <prov:hadRole rdf:resource="http://www.semanticweb.org/awo_prov#FixRole"/>
  <prov:hadPlan rdf:resource="http://www.semanticweb.org/awo_prov#CorrectionPrompt"/>
  <prov:qualifiedAssociation>
    <prov:Association>
      <prov:agent rdf:resource="http://www.semanticweb.org/awo_prov#agent_OntoCorrection_Agent"/>
      <prov:hadRole rdf:resource="http://www.semanticweb.org/awo_prov#FixRole"/>
    </prov:Association>
  </prov:qualifiedAssociation>
  <vaem:rationale>The ontology contradicted CQ3 tests because multiple domain and range assertions on 'eats' implied an empty intersection in OWL 2. Removing these conflicting axioms allows the property to relate various classes as required, resolving the Conflict.</vaem:rationale>
  <awo_prov:correctionRound rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</awo_prov:correctionRound>
  <awo_prov:correctionOutcome>succeeded</awo_prov:correctionOutcome>
  <awo_prov:ofRun rdf:resource="http://www.semanticweb.org/awo_prov#run_awo_none"/>
  <awo_prov:triggeredBy rdf:resource="http://www.semanticweb.org/awo_prov#tool_themis_test"/>
</prov:Activity>

