<prov:Activity rdf:about="http://www.semanticweb.org/awo_prov#GenerationActivity">
  <rdfs:label>Ontology generation by OntoGeneration Agent (step 3)</rdfs:label>
  <prov:used rdf:resource="http://www.semanticweb.org/awo_prov#CandidateTerms"/>
  <prov:used rdf:resource="http://www.semanticweb.org/awo_prov#ProposedAxioms"/>
  <prov:used rdf:resource="http://www.semanticweb.org/awo_prov#ProposedTests"/>
  <prov:generated rdf:resource="http://www.semanticweb.org/awo_prov#OntologyDraft_iteration0"/>
  <prov:wasInformedBy rdf:resource="http://www.semanticweb.org/awo_prov#TestGenerationActivity"/>
  <prov:wasAssociatedWith rdf:resource="http://www.semanticweb.org/awo_prov#agent_OntoGeneration_Agent"/>
  <prov:hadRole rdf:resource="http://www.semanticweb.org/awo_prov#GeneratorRole"/>
  <prov:hadPlan rdf:resource="http://www.semanticweb.org/awo_prov#GenerationPrompt"/>
  <prov:qualifiedAssociation>
    <prov:Association>
      <prov:agent rdf:resource="http://www.semanticweb.org/awo_prov#agent_OntoGeneration_Agent"/>
      <prov:hadRole rdf:resource="http://www.semanticweb.org/awo_prov#GeneratorRole"/>
    </prov:Association>
  </prov:qualifiedAssociation>
  <vaem:rationale>The ontology models the supplied classes (Animal, Herbivore, Omnivore, Carnivore, Plant, PlantPart) and instance (Lion) with a single object property (eats). Subclass axioms establish dietary categories under Animal, disjoint axioms separate mutually exclusive diets, and domain/range axioms on eats cover all consumption scenarios across animals, plants, and plant parts as required by the tests.</vaem:rationale>
</prov:Activity>

<prov:Activity rdf:about="http://www.semanticweb.org/awo_prov#OntoCorrectionActivity">
  <rdfs:label>Ontology correction by OntoCorrection Agent (triggered by themis_test) (step 9)</rdfs:label>
  <prov:used rdf:resource="http://www.semanticweb.org/awo_prov#OntologyDraft_iteration0"/>
  <prov:used rdf:resource="http://www.semanticweb.org/awo_prov#CandidateTerms"/>
  <prov:used rdf:resource="http://www.semanticweb.org/awo_prov#ProposedAxioms"/>
