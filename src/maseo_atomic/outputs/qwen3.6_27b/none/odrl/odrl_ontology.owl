<?xml version="1.0"?>
<rdf:RDF xml:base="http://www.semanticweb.org/odrl#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:vaem="http://www.linkedmodel.org/schema/vaem#">

  <owl:Ontology rdf:about="http://www.semanticweb.org/odrl#"/>

  <!-- owl:Class declarations -->

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Permission">
  <rdfs:comment>A right or allowance granted within a policy.</rdfs:comment>
  <rdfs:label>Permission</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ03, CQ06, CQ24 ask about permissions and their types/roles
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] added SubClassOf axiom: CQ03 Themis test expects Permission SubClassOf TransferRight
    [OntoCorrection Agent | loop_rounds: 3 tool_retries: 3 | themis_test] created: CQ03, CQ06, CQ24 ask about permissions</vaem:rationale>
  <dc:source>(competency_question) CQ03: Shall the permissions 'Aggregation' and 'Disaggregation' be of the type Transfer Rights?
    (competency_question) CQ06: Expressing the various roles of contract parties within the Permission/Duty element.
    (competency_question) CQ24: How to express exclusive permissions?
    (competency_question) CQ03, CQ06, CQ24
    (themis_test) CQ03: Permission SubClassOf TransferRight -&gt; Absent</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/odrl#TransferRight"/>
  <!-- Axiom: SubClassOf TransferRight -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#TransferRight">
  <rdfs:comment>A right that can be transferred or assigned.</rdfs:comment>
  <rdfs:label>Transfer Right</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ03 defines Permission as a subclass of TransferRight</vaem:rationale>
  <dc:source>(competency_question) CQ03: Shall the permissions 'Aggregation' and 'Disaggregation' be of the type Transfer Rights?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Role">
  <rdfs:comment>A function or capacity assigned to a contract party.</rdfs:comment>
  <rdfs:label>Role</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06 models roles of contract parties</vaem:rationale>
  <dc:source>(competency_question) CQ06: Expressing the various roles of contract parties within the Permission/Duty element.</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#ContractParty">
  <rdfs:comment>An entity involved in a contractual agreement.</rdfs:comment>
  <rdfs:label>Contract Party</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06, CQ10 involve contract parties and their roles/rights
    [OntoCorrection Agent | loop_rounds: 3 tool_retries: 3 | themis_test] created: CQ06, CQ10 involve contract parties</vaem:rationale>
  <dc:source>(competency_question) CQ06: Expressing the various roles of contract parties within the Permission/Duty element.
    (competency_question) CQ10: How are rights and duties supported for all contract parties?
    (competency_question) CQ06, CQ10</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Duty">
  <rdfs:comment>An obligation or requirement imposed on a party.</rdfs:comment>
  <rdfs:label>Duty</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06, CQ10, New CQ3, New CQ5 model duties and their relations
    [OntoCorrection Agent | loop_rounds: 3 tool_retries: 3 | themis_test] created: CQ06, CQ10, New CQ3, New CQ5 model duties</vaem:rationale>
  <dc:source>(competency_question) CQ06: Expressing the various roles of contract parties within the Permission/Duty element.
    (competency_question) CQ10: How are rights and duties supported for all contract parties?
    (competency_question) New CQ3: What duty is specified as a remedy for the violation of a prohibition?
    (competency_question) New CQ5: What duty is specified as a consequence of another duty?
    (competency_question) CQ06, CQ10, New CQ3, New CQ5</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Expression">
  <rdfs:comment>A logical or syntactic construct used in policies.</rdfs:comment>
  <rdfs:label>Expression</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ08 defines Operator as a subclass of Expression</vaem:rationale>
  <dc:source>(competency_question) CQ08: How to provide a 'NOT' expression?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Operator">
  <rdfs:comment>A logical operator used in expressions or constraints.</rdfs:comment>
  <rdfs:label>Operator</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ08, New CQ6 involve operators and their usage
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] added SubClassOf axiom: CQ08 Themis test expects Operator SubClassOf Expression
    [OntoCorrection Agent | loop_rounds: 3 tool_retries: 3 | themis_test] created: CQ08, New CQ6 involve operators</vaem:rationale>
  <dc:source>(competency_question) CQ08: How to provide a 'NOT' expression?
    (competency_question) New CQ6: What operator is used in the constraints of a prohibition?
    (competency_question) CQ08, New CQ6
    (themis_test) CQ08: Operator SubClassOf Expression -&gt; Absent</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/odrl#Expression"/>
  <!-- Axiom: SubClassOf Expression -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Right">
  <rdfs:comment>An entitlement or privilege granted to a party.</rdfs:comment>
  <rdfs:label>Right</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ10 models rights supported for contract parties</vaem:rationale>
  <dc:source>(competency_question) CQ10: How are rights and duties supported for all contract parties?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Constraint">
  <rdfs:comment>A condition or limitation applied to requirements, permissions, or prohibitions.</rdfs:comment>
  <rdfs:label>Constraint</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ13, CQ14, CQ21, CQ26, New CQ6 model constraints and their nesting/operators
    [OntoCorrection Agent | loop_rounds: 3 tool_retries: 3 | themis_test] created: CQ13, CQ14, CQ21, CQ26, New CQ6 model constraints</vaem:rationale>
  <dc:source>(competency_question) CQ13: Shall ODRLv2 allow for nested constraints?
    (competency_question) CQ14: How do we express 'and', 'or', 'xor' constraints?
    (competency_question) CQ21: How to express constraints on requirements?
    (competency_question) CQ26: How to express Condition via Constraints?
    (competency_question) New CQ6: What operator is used in the constraints of a prohibition?
    (competency_question) CQ13, CQ14, CQ21, CQ26, New CQ6</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#LogicalOperator">
  <rdfs:comment>An operator that combines constraints logically.</rdfs:comment>
  <rdfs:label>Logical Operator</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ14 models logical operators for constraints</vaem:rationale>
  <dc:source>(competency_question) CQ14: How do we express 'and', 'or', 'xor' constraints?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Requirement">
  <rdfs:comment>A mandatory condition or action in a policy.</rdfs:comment>
  <rdfs:label>Requirement</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ21 models constraints on requirements
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] ensured declaration: CQ21 Themis test reported Undefined for Requirement</vaem:rationale>
  <dc:source>(competency_question) CQ21: How to express constraints on requirements?
    (themis_test) CQ21: constraint domain Requirement -&gt; Undefined</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#PolicyType">
  <rdfs:comment>A classification of a policy or permission.</rdfs:comment>
  <rdfs:label>Policy Type</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ24 models types of permissions</vaem:rationale>
  <dc:source>(competency_question) CQ24: How to express exclusive permissions?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Condition">
  <rdfs:comment>A prerequisite or situational factor for a policy rule.</rdfs:comment>
  <rdfs:label>Condition</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ26 models conditions expressed via constraints
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] ensured declaration: CQ26 Themis test reported Undefined for Condition</vaem:rationale>
  <dc:source>(competency_question) CQ26: How to express Condition via Constraints?
    (themis_test) CQ26: constraint domain Condition -&gt; Undefined</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Container">
  <rdfs:comment>An entity that can contain other containers.</rdfs:comment>
  <rdfs:label>Container</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ30 models container containment
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] ensured declaration: CQ30 Themis test reported Undefined for Container</vaem:rationale>
  <dc:source>(competency_question) CQ30: What do we lose if containers are no longer part of ODRL?
    (themis_test) CQ30: partOf domain Container -&gt; Undefined; partOf range Container -&gt; Undefined</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Rule">
  <rdfs:comment>A policy directive that can contain actions or trigger other rules.</rdfs:comment>
  <rdfs:label>Rule</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ31, New CQ4 model rules and their activation/failure</vaem:rationale>
  <dc:source>(competency_question) CQ31: Do we need 'Sequencing' as part of the REL?
    (competency_question) New CQ4: Which rule is activated upon the failure of another rule?
    (competency_question) CQ31, New CQ4</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Action">
  <rdfs:comment>An operation or behavior specified in a rule.</rdfs:comment>
  <rdfs:label>Action</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ31 models actions as part of rules</vaem:rationale>
  <dc:source>(competency_question) CQ31: Do we need 'Sequencing' as part of the REL?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Class">
  <rdfs:comment>A conceptual category in the data model.</rdfs:comment>
  <rdfs:label>Class</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ33 models class inheritance in the data model
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] added explicit type and subclass axioms: CQ33 Themis tests reported Undefined for Class type/subclassOf
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] added explicit type and subclass axioms: CQ33 Themis test reported Undefined for Class type/subclassOf
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] ensured declaration: CQ33 Themis test reported Undefined for Class type
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 2 | themis_test] added explicit type axiom: CQ33 Themis test reported Undefined for Class type Class
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 3 | themis_test] added explicit type axiom: CQ33 Themis test reported Undefined for Class type
    [OntoCorrection Agent | loop_rounds: 3 tool_retries: 2 | themis_test] added explicit type and subclass axioms: CQ33 Themis tests reported Undefined for Class type and Class subclassOf
    [OntoCorrection Agent | loop_rounds: 3 tool_retries: 3 | themis_test] ensured explicit declaration: CQ33 Themis test reported Undefined for Class type</vaem:rationale>
  <dc:source>(competency_question) CQ33: Can the new data model express inheritance?
    (themis_test) Class type Class -&gt; Undefined; Class subclassOf Class -&gt; Undefined
    (themis_test) CQ33: Class type Class -&gt; Undefined; Class subclassOf Class -&gt; Undefined
    (themis_test) CQ33: Class type Class -&gt; Undefined
    (themis_test) Class type Class -&gt; Undefined</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#DataModel">
  <rdfs:comment>The structural framework defining classes and relations.</rdfs:comment>
  <rdfs:label>Data Model</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ33 mentions DataModel alongside Class</vaem:rationale>
  <dc:source>(competency_question) CQ33: Can the new data model express inheritance?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Asset">
  <rdfs:comment>A resource or item governed by a policy.</rdfs:comment>
  <rdfs:label>Asset</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ1 links assets to policies</vaem:rationale>
  <dc:source>(competency_question) New CQ1: Which policy is directly linked to a given asset?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Policy">
  <rdfs:comment>A set of rules governing the use of an asset.</rdfs:comment>
  <rdfs:label>Policy</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ1, New CQ2 link policies to assets and conflict strategies</vaem:rationale>
  <dc:source>(competency_question) New CQ1: Which policy is directly linked to a given asset?
    (competency_question) New CQ2: What conflict resolution strategy is specified by a policy?
    (competency_question) New CQ1, New CQ2</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#ConflictResolutionStrategy">
  <rdfs:comment>A method for resolving conflicts between policies.</rdfs:comment>
  <rdfs:label>Conflict Resolution Strategy</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ2 specifies conflict strategies for policies</vaem:rationale>
  <dc:source>(competency_question) New CQ2: What conflict resolution strategy is specified by a policy?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Violation">
  <rdfs:comment>An instance where a prohibition is broken.</rdfs:comment>
  <rdfs:label>Violation</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ3 links prohibitions to violations and remedies</vaem:rationale>
  <dc:source>(competency_question) New CQ3: What duty is specified as a remedy for the violation of a prohibition?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Prohibition">
  <rdfs:comment>A rule forbidding a specific action.</rdfs:comment>
  <rdfs:label>Prohibition</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ3, New CQ6 model prohibitions and their constraints/violations</vaem:rationale>
  <dc:source>(competency_question) New CQ3: What duty is specified as a remedy for the violation of a prohibition?
    (competency_question) New CQ6: What operator is used in the constraints of a prohibition?
    (competency_question) New CQ3, New CQ6</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Remedy">
  <rdfs:comment>A corrective action or compensation for a violation.</rdfs:comment>
  <rdfs:label>Remedy</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ3 lists Remedy as a class alongside Duty, Violation, Prohibition</vaem:rationale>
  <dc:source>(competency_question) New CQ3: What duty is specified as a remedy for the violation of a prohibition?</dc:source>
</owl:Class>

  <!-- owl:ObjectProperty declarations -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#role">
  <rdfs:comment>Relates a contract party to the role they assume.</rdfs:comment>
  <rdfs:label>Role</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06 connects ContractParty to Role</vaem:rationale>
  <dc:source>(competency_question) CQ06: Expressing the various roles of contract parties within the Permission/Duty element.</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#ContractParty"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Role"/>
  <!-- Axiom: domain ContractParty -->
  <!-- Axiom: range Role -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#party">
  <rdfs:comment>Relates a permission or duty to the contract party it applies to.</rdfs:comment>
  <rdfs:label>Party</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06, CQ10 connect permissions and duties to contract parties
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] added Duty to domain: CQ10 Themis test expects party domain Duty
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] explicitly declared domain Duty and range ContractParty axioms: CQ10 Themis test expects party domain Duty
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] added explicit domain/range axioms: CQ10 Themis test expects party domain Duty and range ContractParty
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] updated domain: CQ06 Themis test expects party domain Permission
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 2 | themis_test] added domain axiom for Duty: CQ10 Themis test expects party domain Duty</vaem:rationale>
  <dc:source>(competency_question) CQ06: Expressing the various roles of contract parties within the Permission/Duty element.
    (competency_question) CQ10: How are rights and duties supported for all contract parties?
    (themis_test) party domain Duty -&gt; Absent
    (themis_test) CQ10: Duty party ContractParty -&gt; Incorrect; party domain Duty -&gt; Incorrect
    (competency_question) CQ06, CQ10
    (themis_test) CQ06: party domain Permission -&gt; Absent
    (themis_test) CQ10: party domain Duty -&gt; Absent</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Permission"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#ContractParty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Duty"/>
  <!-- Axiom: domain Permission -->
  <!-- Axiom: range ContractParty -->
  <!-- Axiom: domain Duty -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#within">
  <rdfs:comment>Relates a duty to another duty or context it operates within.</rdfs:comment>
  <rdfs:label>Within</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06 models duties within other duties
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] changed range to Permission: CQ06 Themis test expects within range Permission
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] set domain and range explicitly with axioms: CQ06 Themis test expects within domain Duty and range Permission
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] added explicit domain/range axioms: CQ06 Themis test expects within domain Duty and range Permission
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] set domain and range explicitly: CQ06 Themis test expects within domain Duty and range Permission</vaem:rationale>
  <dc:source>(competency_question) CQ06: Expressing the various roles of contract parties within the Permission/Duty element.
    (themis_test) within range Permission -&gt; Absent
    (themis_test) CQ06: Duty within Permission -&gt; Incorrect; within domain Duty -&gt; Incorrect</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Duty"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Permission"/>
  <!-- Axiom: domain Duty -->
  <!-- Axiom: range Permission -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#constraint">
  <rdfs:comment>Relates a rule element to its constraining conditions.</rdfs:comment>
  <rdfs:label>Constraint</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ13, CQ21, CQ26, New CQ6 model constraints on various elements
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] added Requirement, Condition, Prohibition to domain: CQ21, CQ26, New CQ6 Themis tests expect constraint domain Requirement/Condition/Prohibition
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] explicitly declared domain Prohibition and range Constraint axioms: New CQ6 Themis test expects constraint domain Prohibition
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] added explicit domain/range axioms: New CQ6 Themis test expects constraint domain Prohibition and range Constraint
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] updated domain: CQ13 Themis test expects constraint domain Constraint
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 2 | themis_test] added domain axioms for Requirement, Condition, Prohibition: CQ21, CQ26, New CQ6 Themis tests expect these domains</vaem:rationale>
  <dc:source>(competency_question) CQ13: Shall ODRLv2 allow for nested constraints?
    (competency_question) CQ21: How to express constraints on requirements?
    (competency_question) CQ26: How to express Condition via Constraints?
    (competency_question) New CQ6: What operator is used in the constraints of a prohibition?
    (themis_test) constraint domain Requirement -&gt; Undefined; constraint domain Condition -&gt; Undefined; constraint domain Prohibition -&gt; Absent
    (themis_test) New CQ6: Prohibition constraint Constraint -&gt; Incorrect; constraint domain Prohibition -&gt; Incorrect
    (competency_question) CQ13, CQ21, CQ26, New CQ6
    (themis_test) CQ13: constraint domain Constraint -&gt; Absent
    (themis_test) CQ21: constraint domain Requirement -&gt; Undefined; CQ26: constraint domain Condition -&gt; Undefined; New CQ6: constraint domain Prohibition -&gt; Absent</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Requirement"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Condition"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Prohibition"/>
  <!-- Axiom: domain Constraint -->
  <!-- Axiom: range Constraint -->
  <!-- Axiom: domain Requirement -->
  <!-- Axiom: domain Condition -->
  <!-- Axiom: domain Prohibition -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#operator">
  <rdfs:comment>Relates a constraint to the logical operator combining it.</rdfs:comment>
  <rdfs:label>Operator</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ14 connects constraints to logical operators</vaem:rationale>
  <dc:source>(competency_question) CQ14: How do we express 'and', 'or', 'xor' constraints?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#LogicalOperator"/>
  <!-- Axiom: domain Constraint -->
  <!-- Axiom: range LogicalOperator -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#type">
  <rdfs:comment>Relates a permission to its policy type classification.</rdfs:comment>
  <rdfs:label>Type</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ24 connects permissions to policy types
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] explicitly declared domain and range axioms: CQ24 Themis test expects Permission type PolicyType
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] added explicit domain/range axioms: CQ24 Themis test expects Permission type PolicyType
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] verified declaration: CQ24 Themis test expects Permission type PolicyType
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 2 | themis_test] explicitly declared domain and range axioms: CQ24 Themis test reported Incorrect for Permission type PolicyType
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 3 | themis_test] added explicit domain and range axioms: CQ24 Themis test reported Incorrect for Permission type PolicyType
    [OntoCorrection Agent | loop_rounds: 3 tool_retries: 1 | themis_test] added explicit domain/range axioms: CQ24 Themis test reported Incorrect for Permission type PolicyType</vaem:rationale>
  <dc:source>(competency_question) CQ24: How to express exclusive permissions?
    (themis_test) CQ24: Permission type PolicyType -&gt; Incorrect
    (themis_test) Permission type PolicyType -&gt; Incorrect</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Permission"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#PolicyType"/>
  <!-- Axiom: domain Permission -->
  <!-- Axiom: range PolicyType -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#partOf">
  <rdfs:comment>Relates an entity to the container or rule it belongs to.</rdfs:comment>
  <rdfs:label>Part Of</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ30, CQ31 model containment and rule composition
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] added Action to domain and Rule to range: CQ31 Themis test expects partOf domain Action and range Rule
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] explicitly declared domain Action and range Rule axioms: CQ31 Themis test expects partOf domain Action and range Rule
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] added explicit domain/range axioms: CQ31 Themis test expects partOf domain Action and range Rule
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] updated domain and range: CQ30 Themis test expects partOf domain Container and range Container
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 2 | themis_test] added domain and range axioms for Action and Rule: CQ31 Themis tests expect partOf domain Action and range Rule</vaem:rationale>
  <dc:source>(competency_question) CQ30: What do we lose if containers are no longer part of ODRL?
    (competency_question) CQ31: Do we need 'Sequencing' as part of the REL?
    (themis_test) partOf domain Action -&gt; Absent; partOf range Rule -&gt; Absent
    (themis_test) CQ31: Action partOf Rule -&gt; Incorrect; partOf domain Action -&gt; Incorrect
    (competency_question) CQ30, CQ31
    (themis_test) CQ30: partOf domain Container -&gt; Undefined; partOf range Container -&gt; Undefined
    (themis_test) CQ31: partOf domain Action -&gt; Absent; partOf range Rule -&gt; Absent</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Container"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Container"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Action"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Rule"/>
  <!-- Axiom: domain Container -->
  <!-- Axiom: range Container -->
  <!-- Axiom: domain Action -->
  <!-- Axiom: range Rule -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#subclassOf">
  <rdfs:comment>Relates a class to its superclass in the data model.</rdfs:comment>
  <rdfs:label>Subclass Of</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ33 models inheritance between classes
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] added explicit domain/range axioms: CQ33 Themis tests reported Undefined for subclassOf domain/range
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] added explicit domain and range axioms: CQ33 Themis test reported Undefined for subclassOf domain/range
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] added explicit domain/range axioms: CQ33 Themis test reported Undefined for subclassOf domain/range
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] verified declaration: CQ33 Themis test expects subclassOf domain/range Class
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 2 | themis_test] added explicit domain and range axioms: CQ33 Themis tests reported Undefined for subclassOf domain/range Class
    [OntoCorrection Agent | loop_rounds: 3 tool_retries: 2 | themis_test] added explicit domain and range axioms: CQ33 Themis tests reported Undefined for subclassOf domain/range
    [OntoCorrection Agent | loop_rounds: 3 tool_retries: 3 | themis_test] explicitly declared domain and range axioms: CQ33 Themis test reported Undefined for subclassOf domain/range</vaem:rationale>
  <dc:source>(competency_question) CQ33: Can the new data model express inheritance?
    (themis_test) subclassOf domain Class -&gt; Undefined; subclassOf range Class -&gt; Undefined
    (themis_test) CQ33: subclassOf domain Class -&gt; Undefined; subclassOf range Class -&gt; Undefined</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Class"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Class"/>
  <!-- Axiom: domain Class -->
  <!-- Axiom: range Class -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#linkedTo">
  <rdfs:comment>Relates an asset to the policy that governs it.</rdfs:comment>
  <rdfs:label>Linked To</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ1 connects assets to policies</vaem:rationale>
  <dc:source>(competency_question) New CQ1: Which policy is directly linked to a given asset?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Asset"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Policy"/>
  <!-- Axiom: domain Asset -->
  <!-- Axiom: range Policy -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#specifiedBy">
  <rdfs:comment>Relates a policy to its conflict resolution strategy.</rdfs:comment>
  <rdfs:label>Specified By</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ2 connects policies to conflict strategies
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] swapped domain and range: New CQ2 Themis test expects specifiedBy domain ConflictResolutionStrategy and range Policy</vaem:rationale>
  <dc:source>(competency_question) New CQ2: What conflict resolution strategy is specified by a policy?
    (themis_test) specifiedBy domain ConflictResolutionStrategy -&gt; Absent; specifiedBy range Policy -&gt; Absent</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#ConflictResolutionStrategy"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Policy"/>
  <!-- Axiom: domain ConflictResolutionStrategy -->
  <!-- Axiom: range Policy -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#violation">
  <rdfs:comment>Relates a prohibition to the violation it generates.</rdfs:comment>
  <rdfs:label>Violation</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ3 connects prohibitions to violations
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] explicitly declared domain and range axioms: New CQ3 Themis test expects violation domain Prohibition and range Violation
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] added explicit domain/range axioms: New CQ3 Themis test expects violation domain Prohibition and range Violation</vaem:rationale>
  <dc:source>(competency_question) New CQ3: What duty is specified as a remedy for the violation of a prohibition?
    (themis_test) New CQ3: Prohibition violation Violation -&gt; Incorrect; violation domain Prohibition -&gt; Incorrect</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Prohibition"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Violation"/>
  <!-- Axiom: domain Prohibition -->
  <!-- Axiom: range Violation -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#remedy">
  <rdfs:comment>Relates a violation to the duty that serves as its remedy.</rdfs:comment>
  <rdfs:label>Remedy</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ3 connects violations to remedial duties
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] explicitly declared domain and range axioms: New CQ3 Themis test expects remedy domain Violation and range Duty
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] added explicit domain/range axioms: New CQ3 Themis test expects remedy domain Violation and range Duty</vaem:rationale>
  <dc:source>(competency_question) New CQ3: What duty is specified as a remedy for the violation of a prohibition?
    (themis_test) New CQ3: Violation remedy Duty -&gt; Incorrect; remedy range Duty -&gt; Incorrect</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Violation"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Duty"/>
  <!-- Axiom: domain Violation -->
  <!-- Axiom: range Duty -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#failure">
  <rdfs:comment>Relates a rule to the rule that fails.</rdfs:comment>
  <rdfs:label>Failure</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ4 models rule failure dependencies</vaem:rationale>
  <dc:source>(competency_question) New CQ4: Which rule is activated upon the failure of another rule?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Rule"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Rule"/>
  <!-- Axiom: domain Rule -->
  <!-- Axiom: range Rule -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#activatedUpon">
  <rdfs:comment>Relates a rule to the rule that activates it upon failure.</rdfs:comment>
  <rdfs:label>Activated Upon</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ4 models rule activation chains</vaem:rationale>
  <dc:source>(competency_question) New CQ4: Which rule is activated upon the failure of another rule?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Rule"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Rule"/>
  <!-- Axiom: domain Rule -->
  <!-- Axiom: range Rule -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#consequence">
  <rdfs:comment>Relates a duty to another duty that follows as a consequence.</rdfs:comment>
  <rdfs:label>Consequence</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ5 models duty consequences
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] explicitly declared domain and range axioms: New CQ5 Themis test expects consequence domain Duty and range Duty
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] added explicit domain/range axioms: New CQ5 Themis test expects consequence domain Duty and range Duty</vaem:rationale>
  <dc:source>(competency_question) New CQ5: What duty is specified as a consequence of another duty?
    (themis_test) New CQ5: Duty consequence Duty -&gt; Incorrect; consequence domain Duty -&gt; Incorrect; consequence range Duty -&gt; Incorrect</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Duty"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Duty"/>
  <!-- Axiom: domain Duty -->
  <!-- Axiom: range Duty -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#usedIn">
  <rdfs:comment>Relates an operator to the constraint in which it is used.</rdfs:comment>
  <rdfs:label>Used In</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ6 connects operators to constraints
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] swapped domain and range: New CQ6 Themis test expects usedIn domain Operator and range Constraint</vaem:rationale>
  <dc:source>(competency_question) New CQ6: What operator is used in the constraints of a prohibition?
    (themis_test) usedIn domain Operator -&gt; Absent; usedIn range Constraint -&gt; Absent</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Operator"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
  <!-- Axiom: domain Operator -->
  <!-- Axiom: range Constraint -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#supportedFor">
  <rdfs:comment>Relates a right to the contract party it is supported for.</rdfs:comment>
  <rdfs:label>Supported For</rdfs:label>
  <vaem:rationale>[OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | cq_coverage] added missing property: CQ10 requires supportedFor to connect Right to ContractParty
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] created: CQ10 requires supportedFor to connect Right to ContractParty</vaem:rationale>
  <dc:source>(competency_question) CQ10: How are rights and duties supported for all contract parties?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Right"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#ContractParty"/>
  <!-- Axiom: domain Right -->
  <!-- Axiom: range ContractParty -->
</owl:ObjectProperty>

  <!-- owl:NamedIndividual declarations -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#Aggregation">
  <rdfs:comment>A permission type allowing aggregation.</rdfs:comment>
  <rdfs:label>Aggregation</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ03 lists Aggregation as an individual</vaem:rationale>
  <dc:source>(competency_question) CQ03: Shall the permissions 'Aggregation' and 'Disaggregation' be of the type Transfer Rights?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Permission"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#Disaggregation">
  <rdfs:comment>A permission type allowing disaggregation.</rdfs:comment>
  <rdfs:label>Disaggregation</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ03 lists Disaggregation as an individual</vaem:rationale>
  <dc:source>(competency_question) CQ03: Shall the permissions 'Aggregation' and 'Disaggregation' be of the type Transfer Rights?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Permission"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#Not">
  <rdfs:comment>A logical negation operator.</rdfs:comment>
  <rdfs:label>Not</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ08 lists Not as an individual</vaem:rationale>
  <dc:source>(competency_question) CQ08: How to provide a 'NOT' expression?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Operator"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#And">
  <rdfs:comment>A logical conjunction operator.</rdfs:comment>
  <rdfs:label>And</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ14 lists And as an individual</vaem:rationale>
  <dc:source>(competency_question) CQ14: How do we express 'and', 'or', 'xor' constraints?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/odrl#LogicalOperator"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#Or">
  <rdfs:comment>A logical disjunction operator.</rdfs:comment>
  <rdfs:label>Or</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ14 lists Or as an individual</vaem:rationale>
  <dc:source>(competency_question) CQ14: How do we express 'and', 'or', 'xor' constraints?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/odrl#LogicalOperator"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#Xor">
  <rdfs:comment>A logical exclusive disjunction operator.</rdfs:comment>
  <rdfs:label>Xor</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ14 lists Xor as an individual</vaem:rationale>
  <dc:source>(competency_question) CQ14: How do we express 'and', 'or', 'xor' constraints?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/odrl#LogicalOperator"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#Exclusive">
  <rdfs:comment>A policy type indicating exclusivity.</rdfs:comment>
  <rdfs:label>Exclusive</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ24 lists Exclusive as an individual</vaem:rationale>
  <dc:source>(competency_question) CQ24: How to express exclusive permissions?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/odrl#PolicyType"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#Sequencing">
  <rdfs:comment>An action specifying sequential execution.</rdfs:comment>
  <rdfs:label>Sequencing</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ31 lists Sequencing as an individual</vaem:rationale>
  <dc:source>(competency_question) CQ31: Do we need 'Sequencing' as part of the REL?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Action"/>
</owl:NamedIndividual>

