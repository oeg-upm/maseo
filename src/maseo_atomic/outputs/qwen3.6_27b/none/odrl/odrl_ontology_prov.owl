  <prov:hadRole rdf:resource="http://www.semanticweb.org/odrl_prov#GeneratorRole"/>
</prov:SoftwareAgent>

<prov:SoftwareAgent rdf:about="http://www.semanticweb.org/odrl_prov#agent_OntoCorrection_Agent">
