<prov:SoftwareAgent rdf:about="http://www.semanticweb.org/odrl_prov#agent_AxiomGeneration_Agent">
  <rdfs:label>AxiomGeneration Agent</rdfs:label>
  <prov:actedOnBehalfOf rdf:resource="http://www.semanticweb.org/odrl_prov#MASEO"/>
  <prov:hadRole rdf:resource="http://www.semanticweb.org/odrl_prov#RefinementRole"/>
</prov:SoftwareAgent>

<prov:SoftwareAgent rdf:about="http://www.semanticweb.org/odrl_prov#agent_TestGeneration_Agent">
