<?xml version="1.0"?>
<rdf:RDF xml:base="http://www.semanticweb.org/water#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:vaem="http://www.linkedmodel.org/schema/vaem#">

  <owl:Ontology rdf:about="http://www.semanticweb.org/water#"/>

  <!-- owl:Class declarations -->

<owl:Class rdf:about="http://www.semanticweb.org/water#Asset">
  <rdfs:comment>A physical component that composes a water distribution infrastructure.</rdfs:comment>
  <rdfs:label>Asset</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ01 asks which assets compose the infrastructure</vaem:rationale>
  <dc:source>(competency_question) CQ01: Which assets compose a water distribution infrastructure?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#WaterDistributionInfrastructure">
  <rdfs:comment>The infrastructure system composed of various assets.</rdfs:comment>
  <rdfs:label>Water Distribution Infrastructure</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ01 asks which assets compose it</vaem:rationale>
  <dc:source>(competency_question) CQ01: Which assets compose a water distribution infrastructure?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Sensor">
  <rdfs:comment>A device used in water infrastructures to detect or measure phenomena.</rdfs:comment>
  <rdfs:label>Sensor</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ04 asks which types of sensors are used</vaem:rationale>
  <dc:source>(competency_question) CQ04: Which types of sensors are used in water infrastructures?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#WaterInfrastructure">
  <rdfs:comment>The general infrastructure system where sensors, actuators, and aspects are used or defined.</rdfs:comment>
  <rdfs:label>Water Infrastructure</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ04 and CQ05 ask about components used in it</vaem:rationale>
  <dc:source>(competency_question) CQ04: Which types of sensors are used in water infrastructures?
    (competency_question) CQ05: Which types of actuators are used in water infrastructures?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Actuator">
  <rdfs:comment>A device used in water infrastructures to control or move mechanisms.</rdfs:comment>
  <rdfs:label>Actuator</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ05 asks which types of actuators are used</vaem:rationale>
  <dc:source>(competency_question) CQ05: Which types of actuators are used in water infrastructures?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#WaterMeter">
  <rdfs:comment>A device that measures different aspects of a water infrastructure.</rdfs:comment>
  <rdfs:label>Water Meter</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06 states it is a device measuring aspects; multiple CQs query its properties</vaem:rationale>
  <dc:source>(competency_question) CQ06: A water meter is a device that measures different aspects of a water infrastructure.
    (competency_question) CQ08: What is the fabrication number of the water meter?
    (competency_question) CQ09: What are the manufacturer and the model of the water meter?
    (competency_question) CQ10: What is the version of the water meter?
    (competency_question) CQ11: What is the hardware version number of the water meter?
    (competency_question) CQ12: What firmware version is the water meter using?
    (competency_question) CQ18: What is the power of the water meter?
    (competency_question) CQ19: What is the radio frequency level of the water meter?
    (competency_question) CQ20: What is the geolocation of the water meter?
    (competency_question) CQ25: Water meters can provide measurements according to different temporal settings.
    (competency_question) CQ38: What is the start date and time of the tariff in use in the water meter?
    (competency_question) CQ39: What is the duration of the current tariff of the water meter?
    (competency_question) CQ40: What is the tariff period of the water meter?
    (competency_question) CQ42: What is the billing date of the water meter?
    (competency_question) CQ43: What is the billing date period of the water meter?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/water#Device"/>
  <!-- Axiom: SubClassOf Device -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Device">
  <rdfs:comment>A general class for hardware components like water meters.</rdfs:comment>
  <rdfs:label>Device</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06 states a water meter is a device</vaem:rationale>
  <dc:source>(competency_question) CQ06: A water meter is a device that measures different aspects of a water infrastructure.</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Aspect">
  <rdfs:comment>Different measurable characteristics of a water infrastructure.</rdfs:comment>
  <rdfs:label>Aspect</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06 states meters measure aspects; Themis test requires it to be a subclass of WaterInfrastructure</vaem:rationale>
  <dc:source>(competency_question) CQ06: A water meter is a device that measures different aspects of a water infrastructure.</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/water#WaterInfrastructure"/>
  <!-- Axiom: SubClassOf WaterInfrastructure -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Manufacturer">
  <rdfs:comment>The entity that produces a water meter.</rdfs:comment>
  <rdfs:label>Manufacturer</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ09 asks for the manufacturer of the water meter</vaem:rationale>
  <dc:source>(competency_question) CQ09: What are the manufacturer and the model of the water meter?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Model">
  <rdfs:comment>The specific model designation of a water meter.</rdfs:comment>
  <rdfs:label>Model</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ09 asks for the model of the water meter</vaem:rationale>
  <dc:source>(competency_question) CQ09: What are the manufacturer and the model of the water meter?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Measurement">
  <rdfs:comment>Data provided by a water meter according to temporal settings.</rdfs:comment>
  <rdfs:label>Measurement</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ25 states meters provide measurements</vaem:rationale>
  <dc:source>(competency_question) CQ25: Water meters can provide measurements according to different temporal settings.</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#TemporalSetting">
  <rdfs:comment>Time-based configuration for water meter measurements.</rdfs:comment>
  <rdfs:label>Temporal Setting</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ25 states measurements are according to temporal settings</vaem:rationale>
  <dc:source>(competency_question) CQ25: Water meters can provide measurements according to different temporal settings.</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Water">
  <rdfs:comment>The substance whose physical and chemical properties are queried.</rdfs:comment>
  <rdfs:label>Water</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ33 and CQ34 ask for its properties</vaem:rationale>
  <dc:source>(competency_question) CQ33: What are the physical properties of water?
    (competency_question) CQ34: What are the chemical properties of water?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#PhysicalProperty">
  <rdfs:comment>Characteristics of water related to its physical state.</rdfs:comment>
  <rdfs:label>Physical Property</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ33 asks for physical properties</vaem:rationale>
  <dc:source>(competency_question) CQ33: What are the physical properties of water?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#ChemicalProperty">
  <rdfs:comment>Characteristics of water related to its chemical composition.</rdfs:comment>
  <rdfs:label>Chemical Property</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ34 asks for chemical properties</vaem:rationale>
  <dc:source>(competency_question) CQ34: What are the chemical properties of water?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#WaterIndicator">
  <rdfs:comment>Metrics or indicators defined for specific cities.</rdfs:comment>
  <rdfs:label>Water Indicator</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ37 asks which indicators are defined for Burgos</vaem:rationale>
  <dc:source>(competency_question) CQ37: Which water indicators are defined for Burgos?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#City">
  <rdfs:comment>An urban area for which water indicators are defined.</rdfs:comment>
  <rdfs:label>City</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ37 asks about indicators defined for a city</vaem:rationale>
  <dc:source>(competency_question) CQ37: Which water indicators are defined for Burgos?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Tariff">
  <rdfs:comment>Pricing scheme used in water meters, with start times and durations.</rdfs:comment>
  <rdfs:label>Tariff</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ38 and CQ39 ask about tariffs in use</vaem:rationale>
  <dc:source>(competency_question) CQ38: What is the start date and time of the tariff in use in the water meter?
    (competency_question) CQ39: What is the duration of the current tariff of the water meter?</dc:source>
</owl:Class>

  <!-- owl:ObjectProperty declarations -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#compose">
  <rdfs:comment>Relates an asset to the water distribution infrastructure it composes.</rdfs:comment>
  <rdfs:label>Compose</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ01 connects assets to the infrastructure</vaem:rationale>
  <dc:source>(competency_question) CQ01: Which assets compose a water distribution infrastructure?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Asset"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#WaterDistributionInfrastructure"/>
  <!-- Axiom: domain Asset -->
  <!-- Axiom: range WaterDistributionInfrastructure -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#usedIn">
  <rdfs:comment>Relates sensors or actuators to the water infrastructure where they are used.</rdfs:comment>
  <rdfs:label>Used In</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ04 and CQ05 connect sensors/actuators to infrastructures</vaem:rationale>
  <dc:source>(competency_question) CQ04: Which types of sensors are used in water infrastructures?
    (competency_question) CQ05: Which types of actuators are used in water infrastructures?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Sensor"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#WaterInfrastructure"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Actuator"/>
  <!-- Axiom: domain Sensor -->
  <!-- Axiom: domain Actuator -->
  <!-- Axiom: range WaterInfrastructure -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#measure">
  <rdfs:comment>Relates a water meter to the aspect it measures.</rdfs:comment>
  <rdfs:label>Measure</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06 states meters measure aspects</vaem:rationale>
  <dc:source>(competency_question) CQ06: A water meter is a device that measures different aspects of a water infrastructure.</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#Aspect"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range Aspect -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#manufacturer">
  <rdfs:comment>Relates a water meter to its manufacturer.</rdfs:comment>
  <rdfs:label>Manufacturer</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ09 asks for the manufacturer</vaem:rationale>
  <dc:source>(competency_question) CQ09: What are the manufacturer and the model of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#Manufacturer"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range Manufacturer -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#model">
  <rdfs:comment>Relates a water meter to its model.</rdfs:comment>
  <rdfs:label>Model</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ09 asks for the model</vaem:rationale>
  <dc:source>(competency_question) CQ09: What are the manufacturer and the model of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#Model"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range Model -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#provide">
  <rdfs:comment>Relates a water meter to the measurements it provides.</rdfs:comment>
  <rdfs:label>Provide</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ25 states meters provide measurements</vaem:rationale>
  <dc:source>(competency_question) CQ25: Water meters can provide measurements according to different temporal settings.</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#Measurement"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range Measurement -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#accordingTo">
  <rdfs:comment>Relates a measurement to its temporal setting.</rdfs:comment>
  <rdfs:label>According To</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ25 states measurements follow temporal settings</vaem:rationale>
  <dc:source>(competency_question) CQ25: Water meters can provide measurements according to different temporal settings.</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Measurement"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#TemporalSetting"/>
  <!-- Axiom: domain Measurement -->
  <!-- Axiom: range TemporalSetting -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#physicalProperty">
  <rdfs:comment>Relates water to its physical properties.</rdfs:comment>
  <rdfs:label>Physical Property</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ33 asks for physical properties</vaem:rationale>
  <dc:source>(competency_question) CQ33: What are the physical properties of water?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Water"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#PhysicalProperty"/>
  <!-- Axiom: domain Water -->
  <!-- Axiom: range PhysicalProperty -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#chemicalProperty">
  <rdfs:comment>Relates water to its chemical properties.</rdfs:comment>
  <rdfs:label>Chemical Property</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ34 asks for chemical properties</vaem:rationale>
  <dc:source>(competency_question) CQ34: What are the chemical properties of water?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Water"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#ChemicalProperty"/>
  <!-- Axiom: domain Water -->
  <!-- Axiom: range ChemicalProperty -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#definedFor">
  <rdfs:comment>Relates a water indicator to the city it is defined for.</rdfs:comment>
  <rdfs:label>Defined For</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ37 asks which indicators are defined for a city</vaem:rationale>
  <dc:source>(competency_question) CQ37: Which water indicators are defined for Burgos?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterIndicator"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#City"/>
  <!-- Axiom: domain WaterIndicator -->
  <!-- Axiom: range City -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#inUseIn">
  <rdfs:comment>Relates a tariff to the water meter where it is in use.</rdfs:comment>
  <rdfs:label>In Use In</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ38 asks about tariffs in use</vaem:rationale>
  <dc:source>(competency_question) CQ38: What is the start date and time of the tariff in use in the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Tariff"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <!-- Axiom: domain Tariff -->
  <!-- Axiom: range WaterMeter -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#hasTariff">
  <rdfs:comment>Relates a water meter to its current tariff.</rdfs:comment>
  <rdfs:label>Has Tariff</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ39 asks about the current tariff</vaem:rationale>
  <dc:source>(competency_question) CQ39: What is the duration of the current tariff of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#Tariff"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range Tariff -->
</owl:ObjectProperty>

  <!-- owl:DatatypeProperty declarations -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#fabricationNumber">
  <rdfs:comment>The fabrication number of a water meter.</rdfs:comment>
  <rdfs:label>Fabrication Number</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ08 asks for the fabrication number</vaem:rationale>
  <dc:source>(competency_question) CQ08: What is the fabrication number of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#version">
  <rdfs:comment>The version of a water meter.</rdfs:comment>
  <rdfs:label>Version</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ10 asks for the version</vaem:rationale>
  <dc:source>(competency_question) CQ10: What is the version of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#hardwareVersionNumber">
  <rdfs:comment>The hardware version number of a water meter.</rdfs:comment>
  <rdfs:label>Hardware Version Number</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ11 asks for the hardware version number</vaem:rationale>
  <dc:source>(competency_question) CQ11: What is the hardware version number of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#firmwareVersion">
  <rdfs:comment>The firmware version used by a water meter.</rdfs:comment>
  <rdfs:label>Firmware Version</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ12 asks for the firmware version</vaem:rationale>
  <dc:source>(competency_question) CQ12: What firmware version is the water meter using?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#power">
  <rdfs:comment>The power consumption or rating of a water meter.</rdfs:comment>
  <rdfs:label>Power</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ18 asks for the power</vaem:rationale>
  <dc:source>(competency_question) CQ18: What is the power of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range float -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#radioFrequencyLevel">
  <rdfs:comment>The radio frequency level of a water meter.</rdfs:comment>
  <rdfs:label>Radio Frequency Level</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ19 asks for the radio frequency level</vaem:rationale>
  <dc:source>(competency_question) CQ19: What is the radio frequency level of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range float -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#geolocation">
  <rdfs:comment>The geographic location of a water meter.</rdfs:comment>
  <rdfs:label>Geolocation</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ20 asks for the geolocation</vaem:rationale>
  <dc:source>(competency_question) CQ20: What is the geolocation of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#startDateAndTime">
  <rdfs:comment>The start date and time of a tariff.</rdfs:comment>
  <rdfs:label>Start Date And Time</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ38 asks for the start date and time</vaem:rationale>
  <dc:source>(competency_question) CQ38: What is the start date and time of the tariff in use in the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Tariff"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Tariff -->
  <!-- Axiom: range dateTime -->
