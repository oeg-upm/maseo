<?xml version="1.0"?>
<rdf:RDF xml:base="http://www.semanticweb.org/awo#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:vaem="http://www.linkedmodel.org/schema/vaem#">

  <owl:Ontology rdf:about="http://www.semanticweb.org/awo#"/>

  <!-- owl:Class declarations -->

<owl:Class rdf:about="http://www.semanticweb.org/awo#Animal">
  <rdfs:comment>A living organism that may consume other organisms or plants.</rdfs:comment>
  <rdfs:label>Animal</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ1, CQ2, CQ3, CQ6, CQ7, CQ14 refer to animals as eaters or food</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which animal eats which other animal?
    (competency_question) CQ2: Is [this animal] a herbivore?
    (competency_question) CQ3: Which plant parts does [this omnivorous or herbivorourus animal] eat?
    (competency_question) CQ6: Which plants eat animals?
    (competency_question) CQ7: Which animals eat [these animals]?
    (competency_question) CQ14: Are there animals that are carnivore but still eat some plants or parts of plants?
    (competency_question) CQ1, CQ2, CQ3, CQ6, CQ7, CQ14</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/awo#Herbivore">
  <rdfs:comment>An animal that primarily consumes plants or plant parts.</rdfs:comment>
  <rdfs:label>Herbivore</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ2 asks whether an animal is a herbivore</vaem:rationale>
  <dc:source>(competency_question) CQ2: Is [this animal] a herbivore?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/awo#Animal"/>
  <!-- Axiom: SubClassOf Animal -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/awo#PlantPart">
  <rdfs:comment>A structural component of a plant that may be consumed.</rdfs:comment>
  <rdfs:label>Plant Part</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ3, CQ4, and CQ14 refer to plant parts as food</vaem:rationale>
  <dc:source>(competency_question) CQ3: Which plant parts does [this omnivorous or herbivorourus animal] eat?
    (competency_question) CQ4: Does a lion eat plants or plant parts?
    (competency_question) CQ14: Are there animals that are carnivore but still eat some plants or parts of plants?
    (competency_question) CQ3, CQ4, CQ14</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/awo#Lion">
  <rdfs:comment>A large feline predator.</rdfs:comment>
  <rdfs:label>Lion</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ4 asks about lion dietary habits</vaem:rationale>
  <dc:source>(competency_question) CQ4: Does a lion eat plants or plant parts?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/awo#Animal"/>
  <!-- Axiom: SubClassOf Animal -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/awo#Plant">
  <rdfs:comment>A multicellular organism that may be eaten or, in some cases, consume animals.</rdfs:comment>
  <rdfs:label>Plant</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ4 and CQ6 refer to plants as food or eaters</vaem:rationale>
  <dc:source>(competency_question) CQ4: Does a lion eat plants or plant parts?
    (competency_question) CQ6: Which plants eat animals?
    (competency_question) CQ14: Are there animals that are carnivore but still eat some plants or parts of plants?
    (competency_question) CQ4, CQ6</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/awo#Carnivore">
  <rdfs:comment>An animal that primarily consumes other animals.</rdfs:comment>
  <rdfs:label>Carnivore</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ14 asks about carnivores eating plants</vaem:rationale>
  <dc:source>(competency_question) CQ14: Are there animals that are carnivore but still eat some plants or parts of plants?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/awo#Animal"/>
  <!-- Axiom: SubClassOf Animal -->
</owl:Class>

  <!-- owl:ObjectProperty declarations -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/awo#eats">
  <rdfs:comment>Relates an organism that consumes to the organism or plant part it consumes.</rdfs:comment>
  <rdfs:label>Eats</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ1, CQ3, CQ4, CQ6, CQ7, CQ14 ask about consumption relationships
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] added domain Lion and Carnivore: Themis tests for CQ4 and CQ14 require eats to have Lion and Carnivore as domains</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which animal eats which other animal?
    (competency_question) CQ3: Which plant parts does [this omnivorous or herbivorourus animal] eat?
    (competency_question) CQ4: Does a lion eat plants or plant parts?
    (competency_question) CQ6: Which plants eat animals?
    (competency_question) CQ7: Which animals eat [these animals]?
    (competency_question) CQ14: Are there animals that are carnivore but still eat some plants or parts of plants?
    (competency_question) CQ1, CQ3, CQ4, CQ6, CQ7, CQ14
    (themis_test) CQ4: eats domain Lion -&gt; Absent; CQ14: eats domain Carnivore -&gt; Absent</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/awo#Animal"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/awo#Animal"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/awo#Plant"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/awo#Plant"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/awo#PlantPart"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/awo#Lion"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/awo#Carnivore"/>
  <!-- Axiom: domain Animal -->
  <!-- Axiom: range Animal -->
  <!-- Axiom: domain Plant -->
  <!-- Axiom: range Plant -->
  <!-- Axiom: range PlantPart -->
  <!-- Axiom: domain Lion -->
  <!-- Axiom: domain Carnivore -->
</owl:ObjectProperty>

  <!-- owl:NamedIndividual declarations -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/awo#GivenAnimal">
  <rdfs:comment>A specific animal instance used in queries.</rdfs:comment>
  <rdfs:label>Given Animal</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ2 and CQ3 use this as a supplied instance</vaem:rationale>
  <dc:source>(competency_question) CQ2: Is [this animal] a herbivore?
    (competency_question) CQ3: Which plant parts does [this omnivorous or herbivorourus animal] eat?
    (competency_question) CQ2, CQ3</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/awo#Animal"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/awo#GivenPreyAnimals">
  <rdfs:comment>Specific animal instances used as prey in queries.</rdfs:comment>
  <rdfs:label>Given Prey Animals</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ7 uses this as a supplied instance</vaem:rationale>
  <dc:source>(competency_question) CQ7: Which animals eat [these animals]?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/awo#Animal"/>
</owl:NamedIndividual>

</rdf:RDF>