  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain License -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/swo#isFoss">
  <rdfs:comment>Indicates whether software is FOSS.</rdfs:comment>
  <rdfs:label>Is FOSS</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Boolean attribute of Software per CQ65</vaem:rationale>
