  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Version -->
  <!-- Axiom: range dateTime -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/swo#permissiveness">
  <rdfs:comment>Describes the permissiveness of a license.</rdfs:comment>
