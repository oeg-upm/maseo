  <!-- Axiom: range dateTime -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/swo#developmentActivity">
  <rdfs:comment>Describes the development activity level of the software.</rdfs:comment>
  <rdfs:label>Development Activity</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: String attribute of Software per CQ46</vaem:rationale>
