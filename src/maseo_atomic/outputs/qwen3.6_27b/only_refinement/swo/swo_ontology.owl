  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range anyURI -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/swo#firstReleaseDate">
  <rdfs:comment>The date the software was first released.</rdfs:comment>
  <rdfs:label>First Release Date</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: DateTime attribute of Software per CQ45</vaem:rationale>
