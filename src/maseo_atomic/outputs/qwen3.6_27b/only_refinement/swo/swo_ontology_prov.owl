      <prov:entity rdf:resource="http://www.semanticweb.org/swo_prov#CQ26"/>
      <prov:hadActivity rdf:resource="http://www.semanticweb.org/swo_prov#ExtractionActivity"/>
    </prov:Derivation>
  </prov:qualifiedDerivation>
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/swo_prov#CQ30"/>
