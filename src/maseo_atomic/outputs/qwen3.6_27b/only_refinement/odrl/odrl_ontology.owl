<?xml version="1.0"?>
<rdf:RDF xml:base="http://www.semanticweb.org/odrl#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:vaem="http://www.linkedmodel.org/schema/vaem#">

  <owl:Ontology rdf:about="http://www.semanticweb.org/odrl#"/>

  <!-- owl:Class declarations -->

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Permission">
  <rdfs:comment>A right granted by a policy that specifies what actions are allowed.</rdfs:comment>
  <rdfs:label>Permission</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ03, CQ06, CQ10, CQ21, CQ24, CQ26 ask about permissions and their relations</vaem:rationale>
  <dc:source>(competency_question) CQ03: Shall the permissions 'Aggregation' and 'Disaggregation' be of the type Transfer Rights?
    (competency_question) CQ06: Expressing the various roles of contract parties within the Permission/Duty element.
    (competency_question) CQ10: How are rights and duties supported for all contract parties?
    (competency_question) CQ21: How to express constraints on requirements?
    (competency_question) CQ24: How to express exclusive permissions?
    (competency_question) CQ26: How to express Condition via Constraints?
    (competency_question) CQ03, CQ06, CQ10, CQ21, CQ24, CQ26</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/odrl#TransferRight"/>
  <!-- Axiom: SubClassOf TransferRight -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#TransferRight">
  <rdfs:comment>A right that can be transferred or assigned.</rdfs:comment>
  <rdfs:label>Transfer Right</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ03 asks if permissions are of this type</vaem:rationale>
  <dc:source>(competency_question) CQ03: Shall the permissions 'Aggregation' and 'Disaggregation' be of the type Transfer Rights?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#ContractParty">
  <rdfs:comment>An entity involved in a contract or policy.</rdfs:comment>
  <rdfs:label>Contract Party</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06, CQ10, CQ24 ask about roles and permissions/duties of parties</vaem:rationale>
  <dc:source>(competency_question) CQ06: Expressing the various roles of contract parties within the Permission/Duty element.
    (competency_question) CQ10: How are rights and duties supported for all contract parties?
    (competency_question) CQ24: How to express exclusive permissions?
    (competency_question) CQ06, CQ10, CQ24</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Role">
  <rdfs:comment>A function or capacity assigned to a contract party.</rdfs:comment>
  <rdfs:label>Role</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06 asks about expressing roles of parties</vaem:rationale>
  <dc:source>(competency_question) CQ06: Expressing the various roles of contract parties within the Permission/Duty element.</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Duty">
  <rdfs:comment>An obligation imposed on a party, often as a remedy or consequence.</rdfs:comment>
  <rdfs:label>Duty</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06, CQ10, New CQ3, New CQ5 ask about duties and their relations</vaem:rationale>
  <dc:source>(competency_question) CQ06: Expressing the various roles of contract parties within the Permission/Duty element.
    (competency_question) CQ10: How are rights and duties supported for all contract parties?
    (competency_question) New CQ3: What duty is specified as a remedy for the violation of a prohibition?
    (competency_question) New CQ5: What duty is specified as a consequence of another duty?
    (competency_question) CQ06, CQ10, New CQ3, New CQ5</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Constraint">
  <rdfs:comment>A condition or restriction applied to a rule, requirement, or prohibition.</rdfs:comment>
  <rdfs:label>Constraint</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ08, CQ13, CQ14, CQ21, CQ26, New CQ6 ask about constraints and their structure</vaem:rationale>
  <dc:source>(competency_question) CQ08: How to provide a 'NOT' expression?
    (competency_question) CQ13: Shall ODRLv2 allow for nested constraints?
    (competency_question) CQ14: How do we express 'and', 'or', 'xor' constraints?
    (competency_question) CQ21: How to express constraints on requirements?
    (competency_question) CQ26: How to express Condition via Constraints?
    (competency_question) New CQ6: What operator is used in the constraints of a prohibition?
    (competency_question) CQ08, CQ13, CQ14, CQ21, CQ26, New CQ6</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Operator">
  <rdfs:comment>A logical or arithmetic operator used within constraints.</rdfs:comment>
  <rdfs:label>Operator</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ08, CQ14, New CQ6 ask about operators in constraints</vaem:rationale>
  <dc:source>(competency_question) CQ08: How to provide a 'NOT' expression?
    (competency_question) CQ14: How do we express 'and', 'or', 'xor' constraints?
    (competency_question) New CQ6: What operator is used in the constraints of a prohibition?
    (competency_question) CQ08, CQ14, New CQ6</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Requirement">
  <rdfs:comment>A condition that must be fulfilled for a permission to apply.</rdfs:comment>
  <rdfs:label>Requirement</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ21 asks about constraints on requirements</vaem:rationale>
  <dc:source>(competency_question) CQ21: How to express constraints on requirements?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Condition">
  <rdfs:comment>A prerequisite that must be met for a permission to be valid.</rdfs:comment>
  <rdfs:label>Condition</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ26 asks about expressing conditions via constraints</vaem:rationale>
  <dc:source>(competency_question) CQ26: How to express Condition via Constraints?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Container">
  <rdfs:comment>A grouping mechanism for policies or rules.</rdfs:comment>
  <rdfs:label>Container</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ30 asks about containers in ODRL</vaem:rationale>
  <dc:source>(competency_question) CQ30: What do we lose if containers are no longer part of ODRL?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Rule">
  <rdfs:comment>A set of permissions, prohibitions, or duties that govern an action.</rdfs:comment>
  <rdfs:label>Rule</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ31, CQ33, New CQ4 ask about rules and their relations</vaem:rationale>
  <dc:source>(competency_question) CQ31: Do we need 'Sequencing' as part of the REL?
    (competency_question) CQ33: Can the new data model express inheritance?
    (competency_question) New CQ4: Which rule is activated upon the failure of another rule?
    (competency_question) CQ31, CQ33, New CQ4</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Action">
  <rdfs:comment>An operation that can be performed on an asset.</rdfs:comment>
  <rdfs:label>Action</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ31 asks about actions and sequencing in rules</vaem:rationale>
  <dc:source>(competency_question) CQ31: Do we need 'Sequencing' as part of the REL?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Policy">
  <rdfs:comment>A document or entity that defines rights, duties, and constraints.</rdfs:comment>
  <rdfs:label>Policy</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ33, New CQ1, New CQ2 ask about policies and their inheritance/links</vaem:rationale>
  <dc:source>(competency_question) CQ33: Can the new data model express inheritance?
    (competency_question) New CQ1: Which policy is directly linked to a given asset?
    (competency_question) New CQ2: What conflict resolution strategy is specified by a policy?
    (competency_question) CQ33, New CQ1, New CQ2</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/odrl#Rule"/>
  <!-- Axiom: SubClassOf Rule -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Asset">
  <rdfs:comment>A resource or content item governed by a policy.</rdfs:comment>
  <rdfs:label>Asset</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ1 asks about policies linked to assets</vaem:rationale>
  <dc:source>(competency_question) New CQ1: Which policy is directly linked to a given asset?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#ConflictResolutionStrategy">
  <rdfs:comment>A method for resolving conflicts between overlapping policies.</rdfs:comment>
  <rdfs:label>Conflict Resolution Strategy</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ2 asks about conflict resolution in policies</vaem:rationale>
  <dc:source>(competency_question) New CQ2: What conflict resolution strategy is specified by a policy?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/odrl#Prohibition">
  <rdfs:comment>A rule that forbids certain actions.</rdfs:comment>
  <rdfs:label>Prohibition</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ3, New CQ6 ask about prohibitions and their constraints/remedies</vaem:rationale>
  <dc:source>(competency_question) New CQ3: What duty is specified as a remedy for the violation of a prohibition?
    (competency_question) New CQ6: What operator is used in the constraints of a prohibition?
    (competency_question) New CQ3, New CQ6</dc:source>
</owl:Class>

  <!-- owl:ObjectProperty declarations -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasRole">
  <rdfs:comment>Relates a contract party to its assigned role.</rdfs:comment>
  <rdfs:label>Has Role</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06 connects parties to roles</vaem:rationale>
  <dc:source>(competency_question) CQ06: Expressing the various roles of contract parties within the Permission/Duty element.</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#ContractParty"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Role"/>
  <!-- Axiom: domain ContractParty -->
  <!-- Axiom: range Role -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasParty">
  <rdfs:comment>Relates a permission or duty to the contract party involved.</rdfs:comment>
  <rdfs:label>Has Party</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06, CQ10 connect permissions and duties to parties</vaem:rationale>
  <dc:source>(competency_question) CQ06: Expressing the various roles of contract parties within the Permission/Duty element.
    (competency_question) CQ10: How are rights and duties supported for all contract parties?
    (competency_question) CQ06, CQ10</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Permission"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#ContractParty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Duty"/>
  <!-- Axiom: domain Permission -->
  <!-- Axiom: range ContractParty -->
  <!-- Axiom: domain Duty -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasPermission">
  <rdfs:comment>Relates a contract party to a granted permission.</rdfs:comment>
  <rdfs:label>Has Permission</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06, CQ10 connect parties to permissions
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] added domain Permission: Themis test CQ24 requires Permission in domain</vaem:rationale>
  <dc:source>(competency_question) CQ06: Expressing the various roles of contract parties within the Permission/Duty element.
    (competency_question) CQ10: How are rights and duties supported for all contract parties?
    (competency_question) CQ06, CQ10
    (themis_test) hasPermission domain Permission -&gt; Absent</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#ContractParty"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Permission"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Permission"/>
  <!-- Axiom: domain ContractParty -->
  <!-- Axiom: domain Permission -->
  <!-- Axiom: range Permission -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasDuty">
  <rdfs:comment>Relates a contract party to an imposed duty.</rdfs:comment>
  <rdfs:label>Has Duty</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06, CQ10 connect parties to duties</vaem:rationale>
  <dc:source>(competency_question) CQ06: Expressing the various roles of contract parties within the Permission/Duty element.
    (competency_question) CQ10: How are rights and duties supported for all contract parties?
    (competency_question) CQ06, CQ10</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#ContractParty"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Duty"/>
  <!-- Axiom: domain ContractParty -->
  <!-- Axiom: range Duty -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasOperator">
  <rdfs:comment>Relates a constraint to the operator it uses.</rdfs:comment>
  <rdfs:label>Has Operator</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ08, CQ14, New CQ6 connect constraints to operators</vaem:rationale>
  <dc:source>(competency_question) CQ08: How to provide a 'NOT' expression?
    (competency_question) CQ14: How do we express 'and', 'or', 'xor' constraints?
    (competency_question) New CQ6: What operator is used in the constraints of a prohibition?
    (competency_question) CQ08, CQ14, New CQ6</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Operator"/>
  <!-- Axiom: domain Constraint -->
  <!-- Axiom: range Operator -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasConstraint">
  <rdfs:comment>Relates a rule, requirement, condition, or prohibition to its constraints.</rdfs:comment>
  <rdfs:label>Has Constraint</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ13, CQ21, CQ26, New CQ6 connect various entities to constraints</vaem:rationale>
  <dc:source>(competency_question) CQ13: Shall ODRLv2 allow for nested constraints?
    (competency_question) CQ21: How to express constraints on requirements?
    (competency_question) CQ26: How to express Condition via Constraints?
    (competency_question) New CQ6: What operator is used in the constraints of a prohibition?
    (competency_question) CQ13, CQ21, CQ26, New CQ6</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Requirement"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Condition"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Prohibition"/>
  <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/odrl#hasPart"/>
  <!-- Axiom: domain Constraint -->
  <!-- Axiom: range Constraint -->
  <!-- Axiom: domain Requirement -->
  <!-- Axiom: domain Condition -->
  <!-- Axiom: domain Prohibition -->
  <!-- Axiom: SubPropertyOf hasPart -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasPart">
  <rdfs:comment>Relates a constraint to its nested parts.</rdfs:comment>
  <rdfs:label>Has Part</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ13 supports nested constraints</vaem:rationale>
  <dc:source>(competency_question) CQ13: Shall ODRLv2 allow for nested constraints?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Constraint"/>
  <!-- Axiom: domain Constraint -->
  <!-- Axiom: range Constraint -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasRequirement">
  <rdfs:comment>Relates a permission to its requirements.</rdfs:comment>
  <rdfs:label>Has Requirement</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ21 connects permissions to requirements
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] added domain Requirement: Themis test CQ21 requires Requirement in domain</vaem:rationale>
  <dc:source>(competency_question) CQ21: How to express constraints on requirements?
    (themis_test) hasRequirement domain Requirement -&gt; Absent</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Permission"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Requirement"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Requirement"/>
  <!-- Axiom: domain Permission -->
  <!-- Axiom: domain Requirement -->
  <!-- Axiom: range Requirement -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasCondition">
  <rdfs:comment>Relates a permission to its conditions.</rdfs:comment>
  <rdfs:label>Has Condition</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ26 connects permissions to conditions
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] added domain Condition: Themis test CQ26 requires Condition in domain</vaem:rationale>
  <dc:source>(competency_question) CQ26: How to express Condition via Constraints?
    (themis_test) hasCondition domain Condition -&gt; Absent</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Permission"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Condition"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Condition"/>
  <!-- Axiom: domain Permission -->
  <!-- Axiom: domain Condition -->
  <!-- Axiom: range Condition -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasContainer">
  <rdfs:comment>Relates a container to its sub-containers or contents.</rdfs:comment>
  <rdfs:label>Has Container</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ30 asks about containers</vaem:rationale>
  <dc:source>(competency_question) CQ30: What do we lose if containers are no longer part of ODRL?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Container"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Container"/>
  <!-- Axiom: domain Container -->
  <!-- Axiom: range Container -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#partOf">
  <rdfs:comment>Relates an action to the rule it belongs to.</rdfs:comment>
  <rdfs:label>Part Of</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ31 connects actions to rules
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] added domain Rule: Themis test CQ31 requires Rule in domain</vaem:rationale>
  <dc:source>(competency_question) CQ31: Do we need 'Sequencing' as part of the REL?
    (themis_test) partOf domain Rule -&gt; Absent</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Action"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Rule"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Rule"/>
  <!-- Axiom: domain Action -->
  <!-- Axiom: domain Rule -->
  <!-- Axiom: range Rule -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasAction">
  <rdfs:comment>Relates a rule to the actions it governs.</rdfs:comment>
  <rdfs:label>Has Action</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ31 connects rules to actions</vaem:rationale>
  <dc:source>(competency_question) CQ31: Do we need 'Sequencing' as part of the REL?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Rule"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Action"/>
  <!-- Axiom: domain Rule -->
  <!-- Axiom: range Action -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#inheritsFrom">
  <rdfs:comment>Relates a rule or policy to another it inherits from.</rdfs:comment>
  <rdfs:label>Inherits From</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ33 asks about inheritance
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] added domain and range Policy: Themis test CQ33 requires Policy in domain and range</vaem:rationale>
  <dc:source>(competency_question) CQ33: Can the new data model express inheritance?
    (themis_test) inheritsFrom domain Policy -&gt; Absent
  inheritsFrom range Policy -&gt; Absent</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Rule"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Rule"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Policy"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Policy"/>
  <!-- Axiom: domain Rule -->
  <!-- Axiom: domain Policy -->
  <!-- Axiom: range Rule -->
  <!-- Axiom: range Policy -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#linkedTo">
  <rdfs:comment>Relates an asset to its governing policy.</rdfs:comment>
  <rdfs:label>Linked To</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ1 connects assets to policies</vaem:rationale>
  <dc:source>(competency_question) New CQ1: Which policy is directly linked to a given asset?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Asset"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Policy"/>
  <!-- Axiom: domain Asset -->
  <!-- Axiom: range Policy -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#hasConflictResolutionStrategy">
  <rdfs:comment>Relates a policy to its conflict resolution strategy.</rdfs:comment>
  <rdfs:label>Has Conflict Resolution Strategy</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ2 connects policies to strategies</vaem:rationale>
  <dc:source>(competency_question) New CQ2: What conflict resolution strategy is specified by a policy?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Policy"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#ConflictResolutionStrategy"/>
  <!-- Axiom: domain Policy -->
  <!-- Axiom: range ConflictResolutionStrategy -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#remedy">
  <rdfs:comment>Relates a prohibition to the duty that serves as a remedy for its violation.</rdfs:comment>
  <rdfs:label>Remedy</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ3 connects prohibitions to remedial duties</vaem:rationale>
  <dc:source>(competency_question) New CQ3: What duty is specified as a remedy for the violation of a prohibition?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Prohibition"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Duty"/>
  <!-- Axiom: domain Prohibition -->
  <!-- Axiom: range Duty -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#violation">
  <rdfs:comment>Relates a duty to the prohibition whose violation triggers it.</rdfs:comment>
  <rdfs:label>Violation</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ3 connects duties to violated prohibitions</vaem:rationale>
  <dc:source>(competency_question) New CQ3: What duty is specified as a remedy for the violation of a prohibition?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Duty"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Prohibition"/>
  <!-- Axiom: domain Duty -->
  <!-- Axiom: range Prohibition -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#failure">
  <rdfs:comment>Relates a rule to another rule activated upon its failure.</rdfs:comment>
  <rdfs:label>Failure</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ4 asks about rule failure activation</vaem:rationale>
  <dc:source>(competency_question) New CQ4: Which rule is activated upon the failure of another rule?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Rule"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Rule"/>
  <!-- Axiom: domain Rule -->
  <!-- Axiom: range Rule -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/odrl#consequence">
  <rdfs:comment>Relates a duty to another duty that follows as a consequence.</rdfs:comment>
  <rdfs:label>Consequence</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: New CQ5 asks about duty consequences</vaem:rationale>
  <dc:source>(competency_question) New CQ5: What duty is specified as a consequence of another duty?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Duty"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/odrl#Duty"/>
  <!-- Axiom: domain Duty -->
  <!-- Axiom: range Duty -->
</owl:ObjectProperty>

  <!-- owl:DatatypeProperty declarations -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/odrl#isExclusive">
  <rdfs:comment>Indicates whether a permission is exclusive.</rdfs:comment>
  <rdfs:label>Is Exclusive</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ24 asks about exclusive permissions</vaem:rationale>
  <dc:source>(competency_question) CQ24: How to express exclusive permissions?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/odrl#Permission"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Permission -->
  <!-- Axiom: range boolean -->
</owl:DatatypeProperty>

  <!-- owl:NamedIndividual declarations -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#Aggregation">
  <rdfs:comment>A permission type allowing aggregation of assets.</rdfs:comment>
  <rdfs:label>Aggregation</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ03 names this as a permission instance</vaem:rationale>
  <dc:source>(competency_question) CQ03: Shall the permissions 'Aggregation' and 'Disaggregation' be of the type Transfer Rights?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Permission"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#Disaggregation">
  <rdfs:comment>A permission type allowing disaggregation of assets.</rdfs:comment>
  <rdfs:label>Disaggregation</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ03 names this as a permission instance</vaem:rationale>
  <dc:source>(competency_question) CQ03: Shall the permissions 'Aggregation' and 'Disaggregation' be of the type Transfer Rights?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Permission"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#Not">
  <rdfs:comment>A logical operator representing negation in constraints.</rdfs:comment>
  <rdfs:label>Not</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ08 names this as an operator instance</vaem:rationale>
  <dc:source>(competency_question) CQ08: How to provide a 'NOT' expression?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Operator"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#And">
  <rdfs:comment>A logical operator representing conjunction in constraints.</rdfs:comment>
  <rdfs:label>And</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ14 names this as an operator instance</vaem:rationale>
  <dc:source>(competency_question) CQ14: How do we express 'and', 'or', 'xor' constraints?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Operator"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#Or">
  <rdfs:comment>A logical operator representing disjunction in constraints.</rdfs:comment>
  <rdfs:label>Or</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ14 names this as an operator instance</vaem:rationale>
  <dc:source>(competency_question) CQ14: How do we express 'and', 'or', 'xor' constraints?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Operator"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#Xor">
  <rdfs:comment>A logical operator representing exclusive disjunction in constraints.</rdfs:comment>
  <rdfs:label>Xor</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ14 names this as an operator instance</vaem:rationale>
  <dc:source>(competency_question) CQ14: How do we express 'and', 'or', 'xor' constraints?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Operator"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl#Sequencing">
  <rdfs:comment>An action type representing ordered execution within a rule.</rdfs:comment>
  <rdfs:label>Sequencing</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ31 names this as an action instance</vaem:rationale>
  <dc:source>(competency_question) CQ31: Do we need 'Sequencing' as part of the REL?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/odrl#Action"/>
</owl:NamedIndividual>

</rdf:RDF>