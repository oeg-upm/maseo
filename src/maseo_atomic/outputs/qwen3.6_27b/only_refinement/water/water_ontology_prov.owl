<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#duration">
  <rdfs:comment>The time span for which a tariff remains valid.</rdfs:comment>
  <rdfs:label>Duration</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ39 asks for the duration of a tariff
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] changed range from string to float: Themis test expects Tariff duration float</vaem:rationale>
  <dc:source>(competency_question) CQ39: What is the duration of the current tariff of the water meter?
    (themis_test) CQ39: Tariff duration float -&gt; Conflict</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Tariff"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Tariff -->
  <!-- Axiom: range float -->
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/water_prov#CQ39"/>
  <prov:qualifiedDerivation>
    <prov:Derivation>
      <prov:entity rdf:resource="http://www.semanticweb.org/water_prov#CQ39"/>
      <prov:hadActivity rdf:resource="http://www.semanticweb.org/water_prov#ExtractionActivity"/>
    </prov:Derivation>
  </prov:qualifiedDerivation>
  <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/water_prov#GenerationActivity"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/water_prov#ExtractionActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#agent_TermExtraction_Agent"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/water_prov#RefinementActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#agent_OntoGeneration_Agent"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/water_prov#OntoCorrectionActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#agent_OntoCorrection_Agent"/>
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/water_prov#Report_r1_themis_test_9"/>
  <vaem:rationale>[OntoCorrection Agent | themis_test] changed at OntoCorrectionActivity: added axioms: duration range float; removed axioms: duration range string; Range changed</vaem:rationale>
</owl:DatatypeProperty>

