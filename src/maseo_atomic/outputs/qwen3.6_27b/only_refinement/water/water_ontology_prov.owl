<?xml version="1.0"?>
<rdf:RDF xml:base="http://www.semanticweb.org/water#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:vaem="http://www.linkedmodel.org/schema/vaem#"
         xmlns:earl="http://www.w3.org/ns/earl#"
         xmlns:prov="http://www.w3.org/ns/prov#"
         xmlns:water_prov="http://www.semanticweb.org/water_prov#">

  <owl:Ontology rdf:about="http://www.semanticweb.org/water#">
    <owl:versionInfo>iteration 2</owl:versionInfo>
    <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#MASEO"/>
    <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/water_prov#OntoCorrectionActivity_2"/>
    <prov:wasRevisionOf rdf:resource="http://www.semanticweb.org/water_prov#OntologyDraft_iteration1"/>
    <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#agent_OntoGeneration_Agent"/>
    <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#agent_OntoCorrection_Agent"/>
  </owl:Ontology>

  <!-- ================================================================ -->
  <!-- Provenance vocabulary used in this file.                          -->
  <!-- PROV-O / EARL terms are declared once so the file is self-contained;-->
  <!-- prov:* and evaluation predicates are declared as ANNOTATION       -->
  <!-- properties so the domain ontology stays inside OWL 2 DL.          -->
  <!-- ================================================================ -->

  <!-- PROV-O classes -->
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity">
    <rdfs:comment>A thing with provenance: competency questions, term sets, axioms, ontology versions, reports.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity">
    <rdfs:comment>Something that happened over time: an agent stage, a tool check, a validation round.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#SoftwareAgent">
    <rdfs:comment>An LLM agent or a validation tool of the pipeline.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Plan">
    <rdfs:comment>The prompt / procedure an agent followed (generation prompt, correction prompt, validation plan).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Role">
    <rdfs:comment>The function an agent had in an activity: GeneratorRole, RefinementRole, FixRole, ValidatorRole.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Association">
    <rdfs:comment>Qualified link agent-activity carrying the role the agent played.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Derivation">
    <rdfs:comment>Qualified link element-CQ recording the activity in which the element was first derived from that CQ.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Invalidation">
    <rdfs:comment>Event instance: a term or element was removed by an activity.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Generation">
    <rdfs:comment>Event instance: a term was introduced by an activity.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Collection">
    <rdfs:comment>An entity whose members are other entities: a term stage and its set of terms.</rdfs:comment>
  </owl:Class>

  <!-- PROV-O relations (as annotation properties) -->
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#wasDerivedFrom">
    <rdfs:comment>Element/axiom/test &lt;- competency question or failing report it was derived from.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#wasGeneratedBy">
    <rdfs:comment>Entity &lt;- activity that created it.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#wasInfluencedBy">
    <rdfs:comment>Entity &lt;- activity that kept or changed it without creating it (weaker than wasGeneratedBy).</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#wasInformedBy">
    <rdfs:comment>Activity &lt;- earlier activity whose output it built on (pipeline order).</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#used">
    <rdfs:comment>Activity -&gt; entity it consumed as input.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#generated">
    <rdfs:comment>Activity -&gt; entity it produced (inverse of wasGeneratedBy).</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#wasAssociatedWith">
    <rdfs:comment>Activity -&gt; agent/tool that performed it.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#actedOnBehalfOf">
    <rdfs:comment>Agent -&gt; the pipeline it acts for.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#wasAttributedTo">
    <rdfs:comment>Entity -&gt; agent credited with it.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#wasRevisionOf">
    <rdfs:comment>Entity -&gt; earlier version it revises (ontology after correction; term replacing another).</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#wasInvalidatedBy">
    <rdfs:comment>Entity -&gt; activity that made it obsolete (old ontology draft superseded by a correction).</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#wasQuotedFrom">
    <rdfs:comment>Reified axiom -&gt; the element it is quoted from.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#hadRole">
    <rdfs:comment>Activity/association/agent -&gt; the role played (GeneratorRole, RefinementRole, FixRole, ValidatorRole).</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#hadPlan">
    <rdfs:comment>Activity -&gt; the plan/prompt followed.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#hadActivity">
    <rdfs:comment>Event or derivation -&gt; the activity in which it happened.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#qualifiedDerivation">
    <rdfs:comment>Element -&gt; Derivation node (which CQ, in which activity).</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#qualifiedAssociation">
    <rdfs:comment>Activity -&gt; Association node (which agent, in which role).</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#entity">
    <rdfs:comment>Derivation -&gt; the CQ it derives from.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#agent">
    <rdfs:comment>Association -&gt; the agent.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#value">
    <rdfs:comment>Literal payload: CQ text, test text, tool report.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#type">
    <rdfs:comment>PROV sub-typing hook (unused unless a step supplies one).</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#hadMember">
    <rdfs:comment>Collection -&gt; one of its members (term stage -&gt; a term it contains).</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#alternateOf">
    <rdfs:comment>Term &lt;-&gt; the ontology element presenting the same thing (symmetric in PROV-O).</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#generatedAtTime">
    <rdfs:comment>Timestamp of generation (only if the log supplies one).</rdfs:comment>
  </owl:AnnotationProperty>

  <!-- Other standard vocabularies -->
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/source">
    <rdfs:comment>Original source text kept verbatim (CQ, tool error) when no report entity carries it.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.linkedmodel.org/schema/vaem#rationale">
    <rdfs:comment>Human-readable reason: why an element exists, what a stage changed, why an axiom was added.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#predicate">
    <rdfs:comment>With rdf:subject/rdf:object: the reified axiom (S P O) an ax_* entity stands for.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:Class rdf:about="http://www.w3.org/ns/earl#TestResult">
    <rdfs:comment>Result of one validation-tool run or of a whole validation round.</rdfs:comment>
  </owl:Class>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/earl#outcome">
    <rdfs:comment>earl:passed or earl:failed.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:NamedIndividual rdf:about="http://www.w3.org/ns/earl#passed"/>
  <owl:NamedIndividual rdf:about="http://www.w3.org/ns/earl#failed"/>

  <!-- ================================================================ -->
  <!-- Evaluation layer: run-quality facts, queryable per run.           -->
  <!-- Success is NOT stored; it is derived by query as:                 -->
  <!--   (1) the final verify round has roundPassed=true  AND            -->
  <!--   (2) no failed attempt is left with supersededByRetry=false.     -->
  <!-- ================================================================ -->
  <owl:Class rdf:about="http://www.semanticweb.org/water_prov#PipelineRun">
    <rdfs:comment>One execution of the pipeline (one steps log). All rounds/checks/corrections point to it via ofRun.</rdfs:comment>
  </owl:Class>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#runId">
    <rdfs:comment>Identifier of the run (steps file name unless --run-id given). Group by it when merging many runs.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#ofRun">
    <rdfs:comment>Check / round / correction / attempt -&gt; the PipelineRun it belongs to.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#roundIndex">
    <rdfs:comment>Validation round number = ontology version being validated (1 = first draft).</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#phase">
    <rdfs:comment>'loop' (find errors) or 'verify' (confirm after correction), from the log.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#attempt">
    <rdfs:comment>Attempt counter from the log (tool re-run, or n-th failed agent attempt).</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#isVerifyRound">
    <rdfs:comment>true on validation rounds whose phase is verify.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#isFinalRound">
    <rdfs:comment>true on the last validation round of the run; on PipelineRun, points to it.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#roundPassed">
    <rdfs:comment>true when every tool in the round passed.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#toolName">
    <rdfs:comment>Name of the validation tool that ran the check.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#checkOutcome">
    <rdfs:comment>'passed' or 'failed' for a check or a failed agent attempt.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#correctionRound">
    <rdfs:comment>n-th ontology correction of the run (1-based).</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#correctionOutcome">
    <rdfs:comment>'succeeded' when the correction produced a usable ontology.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#triggeredBy">
    <rdfs:comment>Correction -&gt; the tool whose failure triggered it.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#stage">
    <rdfs:comment>Pipeline stage of a failed attempt (e.g. Generation).</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#supersededByRetry">
    <rdfs:comment>On a failed attempt's report: true if a later successful attempt replaced it.</rdfs:comment>
  </owl:AnnotationProperty>

  <!-- ================================================================ -->
  <!-- Term layer: every term of every term stage, split by kind.        -->
  <!-- One Term individual per distinct name, shared by the stages that   -->
  <!-- held it; the kind is carried by the STAGE -> term link, because a  -->
  <!-- term can be reclassified from one stage to the next.               -->
  <!-- ================================================================ -->
  <owl:Class rdf:about="http://www.semanticweb.org/water_prov#Term">
    <rdfs:comment>A vocabulary term proposed by a term stage, before (or without) becoming an ontology element. prov:alternateOf points at the ontology element that presents the same thing, when the term reached the ontology.</rdfs:comment>
  </owl:Class>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#termName">
    <rdfs:comment>Local name of the term exactly as the agent wrote it.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#reachedOntology">
    <rdfs:comment>true when the term is an element of the final ontology.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#class">
    <rdfs:comment>Term stage -&gt; a term it classified as class (classes). Every such term is also a prov:hadMember of the stage.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#objectProperty">
    <rdfs:comment>Term stage -&gt; a term it classified as objectProperty (object_properties). Every such term is also a prov:hadMember of the stage.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#dataProperty">
    <rdfs:comment>Term stage -&gt; a term it classified as dataProperty (data_properties). Every such term is also a prov:hadMember of the stage.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#individual">
    <rdfs:comment>Term stage -&gt; a term it classified as individual (individuals). Every such term is also a prov:hadMember of the stage.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/water_prov#instance">
    <rdfs:comment>Term stage -&gt; a term it classified as instance (instances). Every such term is also a prov:hadMember of the stage.</rdfs:comment>
  </owl:AnnotationProperty>

  <!-- owl:Class declarations -->

<owl:Class rdf:about="http://www.semanticweb.org/water#Asset">
  <rdfs:comment>A physical or logical component of a water infrastructure system.</rdfs:comment>
  <rdfs:label>Asset</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ01 asks for assets composing an infrastructure</vaem:rationale>
  <dc:source>(competency_question) CQ01: Which assets compose a water distribution infrastructure?</dc:source>
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/water_prov#CQ01"/>
  <prov:qualifiedDerivation>
    <prov:Derivation>
      <prov:entity rdf:resource="http://www.semanticweb.org/water_prov#CQ01"/>
      <prov:hadActivity rdf:resource="http://www.semanticweb.org/water_prov#ExtractionActivity"/>
    </prov:Derivation>
  </prov:qualifiedDerivation>
  <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/water_prov#GenerationActivity"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/water_prov#ExtractionActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#agent_TermExtraction_Agent"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/water_prov#RefinementActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#agent_OntoGeneration_Agent"/>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#WaterDistributionInfrastructure">
  <rdfs:comment>A system for distributing water to end users.</rdfs:comment>
  <rdfs:label>Water Distribution Infrastructure</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ01 asks about the infrastructure composed of assets</vaem:rationale>
  <dc:source>(competency_question) CQ01: Which assets compose a water distribution infrastructure?</dc:source>
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/water_prov#CQ01"/>
  <prov:qualifiedDerivation>
    <prov:Derivation>
      <prov:entity rdf:resource="http://www.semanticweb.org/water_prov#CQ01"/>
      <prov:hadActivity rdf:resource="http://www.semanticweb.org/water_prov#ExtractionActivity"/>
    </prov:Derivation>
  </prov:qualifiedDerivation>
  <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/water_prov#GenerationActivity"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/water_prov#ExtractionActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#agent_TermExtraction_Agent"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/water_prov#RefinementActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#agent_OntoGeneration_Agent"/>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Sensor">
  <rdfs:comment>A device that detects and responds to physical inputs.</rdfs:comment>
  <rdfs:label>Sensor</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ04 asks about sensors used in infrastructures</vaem:rationale>
  <dc:source>(competency_question) CQ04: Which types of sensors are used in water infrastructures?</dc:source>
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/water_prov#CQ04"/>
  <prov:qualifiedDerivation>
    <prov:Derivation>
      <prov:entity rdf:resource="http://www.semanticweb.org/water_prov#CQ04"/>
      <prov:hadActivity rdf:resource="http://www.semanticweb.org/water_prov#ExtractionActivity"/>
    </prov:Derivation>
  </prov:qualifiedDerivation>
  <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/water_prov#GenerationActivity"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/water_prov#ExtractionActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#agent_TermExtraction_Agent"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/water_prov#RefinementActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#agent_OntoGeneration_Agent"/>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#WaterInfrastructure">
  <rdfs:comment>The physical facilities and systems that supply and manage water.</rdfs:comment>
  <rdfs:label>Water Infrastructure</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ04 and CQ05 ask about components used in water infrastructures</vaem:rationale>
  <dc:source>(competency_question) CQ04: Which types of sensors are used in water infrastructures?
    (competency_question) CQ05: Which types of actuators are used in water infrastructures?</dc:source>
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/water_prov#CQ04"/>
  <prov:qualifiedDerivation>
    <prov:Derivation>
      <prov:entity rdf:resource="http://www.semanticweb.org/water_prov#CQ04"/>
      <prov:hadActivity rdf:resource="http://www.semanticweb.org/water_prov#ExtractionActivity"/>
    </prov:Derivation>
  </prov:qualifiedDerivation>
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/water_prov#CQ05"/>
  <prov:qualifiedDerivation>
    <prov:Derivation>
      <prov:entity rdf:resource="http://www.semanticweb.org/water_prov#CQ05"/>
      <prov:hadActivity rdf:resource="http://www.semanticweb.org/water_prov#ExtractionActivity"/>
    </prov:Derivation>
  </prov:qualifiedDerivation>
  <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/water_prov#GenerationActivity"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/water_prov#ExtractionActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#agent_TermExtraction_Agent"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/water_prov#RefinementActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#agent_OntoGeneration_Agent"/>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Actuator">
  <rdfs:comment>A component responsible for moving or controlling a mechanism.</rdfs:comment>
  <rdfs:label>Actuator</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ05 asks about actuators used in infrastructures</vaem:rationale>
  <dc:source>(competency_question) CQ05: Which types of actuators are used in water infrastructures?</dc:source>
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/water_prov#CQ05"/>
  <prov:qualifiedDerivation>
    <prov:Derivation>
      <prov:entity rdf:resource="http://www.semanticweb.org/water_prov#CQ05"/>
      <prov:hadActivity rdf:resource="http://www.semanticweb.org/water_prov#ExtractionActivity"/>
    </prov:Derivation>
  </prov:qualifiedDerivation>
  <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/water_prov#GenerationActivity"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/water_prov#ExtractionActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#agent_TermExtraction_Agent"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/water_prov#RefinementActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#agent_OntoGeneration_Agent"/>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#WaterMeter">
  <rdfs:comment>A device that measures water flow or usage.</rdfs:comment>
  <rdfs:label>Water Meter</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Multiple CQs ask about water meter attributes and relations</vaem:rationale>
  <dc:source>(competency_question) CQ06: A water meter is a device that measures different aspects of a water infrastructure.
    (competency_question) CQ08: What is the fabrication number of the water meter?
    (competency_question) CQ09: What are the manufacturer and the model of the water meter?
    (competency_question) CQ10: What is the version of the water meter?
    (competency_question) CQ11: What is the hardware version number of the water meter?
    (competency_question) CQ12: What firmware version is the water meter using?
    (competency_question) CQ18: What is the power of the water meter?
    (competency_question) CQ19: What is the radio frequency level of the water meter?
    (competency_question) CQ20: What is the geolocation of the water meter?
    (competency_question) CQ25: Water meters can provide measurements according to different temporal settings.
    (competency_question) CQ38: What is the start date and time of the tariff in use in the water meter?
    (competency_question) CQ39: What is the duration of the current tariff of the water meter?
    (competency_question) CQ40: What is the tariff period of the water meter?
    (competency_question) CQ42: What is the billing date of the water meter?
    (competency_question) CQ43: What is the billing date period of the water meter?
