  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/water_prov#OntoCorrectionActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/water_prov#agent_OntoCorrection_Agent"/>
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/water_prov#Report_r1_themis_test_9"/>
  <vaem:rationale>[OntoCorrection Agent | themis_test] changed at OntoCorrectionActivity: added axioms: compose domain Asset; compose range WaterDistributionInfrastructure; removed axioms: compose domain WaterDistributionInfrastructure; compose range Asset; Comment changed; Domain changed; Range changed</vaem:rationale>
</owl:ObjectProperty>

