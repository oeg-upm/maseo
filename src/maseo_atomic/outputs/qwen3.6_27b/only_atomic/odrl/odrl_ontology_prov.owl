  <rdf:type rdf:resource="http://www.w3.org/ns/prov#Role"/>
  <rdfs:label>refinement</rdfs:label>
  <rdfs:comment>Filters or reshapes existing content: term identification/refinement, axiom and test proposal, other LLM stages.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl_prov#FixRole">
  <rdf:type rdf:resource="http://www.w3.org/ns/prov#Role"/>
  <rdfs:label>fix</rdfs:label>
  <rdfs:comment>Corrects the ontology in response to a validation-tool failure (ontology correction).</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl_prov#ValidatorRole">
  <rdf:type rdf:resource="http://www.w3.org/ns/prov#Role"/>
  <rdfs:label>validator</rdfs:label>
  <rdfs:comment>Checks the ontology without changing it: syntax, CQ coverage, OOPS, HermiT, Themis.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl_prov#GenerationPrompt">
  <rdf:type rdf:resource="http://www.w3.org/ns/prov#Plan"/>
  <rdfs:label>generation prompt</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl_prov#CorrectionPrompt">
  <rdf:type rdf:resource="http://www.w3.org/ns/prov#Plan"/>
  <rdfs:label>correction prompt</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/odrl_prov#ValidationPlan">
  <rdf:type rdf:resource="http://www.w3.org/ns/prov#Plan"/>
  <rdfs:label>validation plan</rdfs:label>
</owl:NamedIndividual>

