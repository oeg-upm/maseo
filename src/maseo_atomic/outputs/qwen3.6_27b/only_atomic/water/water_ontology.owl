  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#billingDate">
  <rdfs:comment>The scheduled date for generating a water bill.</rdfs:comment>
  <rdfs:label>Billing Date</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ42 asks for the billing date</vaem:rationale>
