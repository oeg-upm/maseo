  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Tariff"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Tariff -->
  <!-- Axiom: range dateTime -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#duration">
  <rdfs:comment>The length of time a tariff remains valid.</rdfs:comment>
