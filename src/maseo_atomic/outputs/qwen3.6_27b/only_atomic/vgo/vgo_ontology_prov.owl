      <prov:entity rdf:resource="http://www.semanticweb.org/vgo_prov#CQ03"/>
      <prov:hadActivity rdf:resource="http://www.semanticweb.org/vgo_prov#ExtractionActivity"/>
    </prov:Derivation>
  </prov:qualifiedDerivation>
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/vgo_prov#CQ05"/>
