<?xml version="1.0"?>
<rdf:RDF xml:base="http://www.semanticweb.org/vgo#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:vaem="http://www.linkedmodel.org/schema/vaem#">

  <owl:Ontology rdf:about="http://www.semanticweb.org/vgo#"/>

  <!-- owl:Class declarations -->

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Player">
  <rdfs:comment>A user or participant in games who can have friends, achievements, equipment, and make purchases.</rdfs:comment>
  <rdfs:label>Player</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Central entity referenced across nearly all competency questions</vaem:rationale>
  <dc:source>(competency_question) CQ01: What is the username of the player?
    (competency_question) CQ02: Who are the friends of the player?
    (competency_question) CQ03: Who are the friends that play other games as well with this player?
    (competency_question) CQ05: What are the achievements of my friends?
    (competency_question) CQ07: What are the achievements your friend has received?
    (competency_question) CQ22: Who has the best kill count in the game?
    (competency_question) CQ24: What achievements has a player obtained?
    (competency_question) CQ25: What games has the player played?
    (competency_question) CQ26: What items does the player have?
    (competency_question) CQ27: What achievements of a certain type does the player have?
    (competency_question) CQ29: What is the last game a player has played?
    (competency_question) CQ35: In how many games does the player have all the achievements?
    (competency_question) CQ52: What equipment does a player have in a game?
    (competency_question) CQ56: How many players have made in app purchases?
    (competency_question) CQ57: How many players who have already spent money, spend money again?
    (competency_question) CQ64: How long does a player spend in the game before making first IAP?
    (competency_question) CQ65: Where do the players live who have not made any IAP?
    (competency_question) CQ66: Where do the players who have done the most IAP live?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Game">
  <rdfs:comment>A digital entertainment product that players can play, own achievements in, and spend time on.</rdfs:comment>
  <rdfs:label>Game</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Core entity for queries about gameplay, genres, items, and statistics</vaem:rationale>
  <dc:source>(competency_question) CQ03: Who are the friends that play other games as well with this player?
    (competency_question) CQ08: What achievements does a game have?
    (competency_question) CQ09: How many hours has this game been played in total?
    (competency_question) CQ10: What are the types of achievements in this game?
    (competency_question) CQ12: What is the genre of the game?
    (competency_question) CQ13: What items exist in a game?
    (competency_question) CQ15: What is the release date of the game?
    (competency_question) CQ17: List all games of a certain Genre?
    (competency_question) CQ22: Who has the best kill count in the game?
    (competency_question) CQ25: What games has the player played?
    (competency_question) CQ29: What is the last game a player has played?
    (competency_question) CQ35: In how many games does the player have all the achievements?
    (competency_question) CQ52: What equipment does a player have in a game?
    (competency_question) CQ55: What are the games where a player can use this item?
    (competency_question) CQ64: How long does a player spend in the game before making first IAP?
    (competency_question) New CQ1: What playing areas does a game have?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Achievement">
  <rdfs:comment>A milestone or reward unlocked by a player within a game.</rdfs:comment>
  <rdfs:label>Achievement</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Target of queries about player progress and game content</vaem:rationale>
  <dc:source>(competency_question) CQ05: What are the achievements of my friends?
    (competency_question) CQ07: What are the achievements your friend has received?
    (competency_question) CQ08: What achievements does a game have?
    (competency_question) CQ10: What are the types of achievements in this game?
    (competency_question) CQ11: What are the types of achievements a game can have?
    (competency_question) CQ24: What achievements has a player obtained?
    (competency_question) CQ27: What achievements of a certain type does the player have?
    (competency_question) CQ35: In how many games does the player have all the achievements?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Genre">
  <rdfs:comment>A category or style of game.</rdfs:comment>
  <rdfs:label>Genre</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Used to classify and filter games</vaem:rationale>
  <dc:source>(competency_question) CQ12: What is the genre of the game?
    (competency_question) CQ17: List all games of a certain Genre?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Item">
  <rdfs:comment>An object or resource that exists within a game and can be owned or used by players.</rdfs:comment>
  <rdfs:label>Item</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Referenced in queries about game content and player inventory</vaem:rationale>
  <dc:source>(competency_question) CQ13: What items exist in a game?
    (competency_question) CQ19: What abilities does an item have?
    (competency_question) CQ26: What items does the player have?
    (competency_question) CQ55: What are the games where a player can use this item?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Ability">
  <rdfs:comment>A capability or power granted by an item.</rdfs:comment>
  <rdfs:label>Ability</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Target of query about item properties</vaem:rationale>
  <dc:source>(competency_question) CQ19: What abilities does an item have?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Equipment">
  <rdfs:comment>Gear or tools a player can possess in a game.</rdfs:comment>
  <rdfs:label>Equipment</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Target of query about player loadout</vaem:rationale>
  <dc:source>(competency_question) CQ52: What equipment does a player have in a game?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#InAppPurchase">
  <rdfs:comment>A transaction made by a player or customer within the game ecosystem.</rdfs:comment>
  <rdfs:label>In-App Purchase</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Central to monetization and spending queries</vaem:rationale>
  <dc:source>(competency_question) CQ56: How many players have made in app purchases?
    (competency_question) CQ57: How many players who have already spent money, spend money again?
    (competency_question) CQ62: What time are most of the in app purchases done?
    (competency_question) CQ64: How long does a player spend in the game before making first IAP?
    (competency_question) CQ65: Where do the players live who have not made any IAP?
    (competency_question) CQ66: Where do the players who have done the most IAP live?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Customer">
  <rdfs:comment>A paying user who makes purchases.</rdfs:comment>
  <rdfs:label>Customer</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Referenced in spending and location queries</vaem:rationale>
  <dc:source>(competency_question) CQ63: Where do the most paying customers live?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Location">
  <rdfs:comment>A geographical place where players or customers reside.</rdfs:comment>
  <rdfs:label>Location</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Target of demographic queries</vaem:rationale>
  <dc:source>(competency_question) CQ63: Where do the most paying customers live?
    (competency_question) CQ65: Where do the players live who have not made any IAP?
    (competency_question) CQ66: Where do the players who have done the most IAP live?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#PlayingArea">
  <rdfs:comment>A map or zone within a game where gameplay occurs.</rdfs:comment>
  <rdfs:label>Playing Area</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Target of New CQ1</vaem:rationale>
  <dc:source>(competency_question) New CQ1: What playing areas does a game have?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#AchievementType">
  <rdfs:comment>A category or classification of an achievement.</rdfs:comment>
  <rdfs:label>Achievement Type</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Used to filter achievements by kind in CQ27</vaem:rationale>
  <dc:source>(competency_question) CQ27: What achievements of a certain type does the player have?</dc:source>
</owl:Class>

  <!-- owl:ObjectProperty declarations -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#friend">
  <rdfs:comment>Relates a player to another player who is their friend.</rdfs:comment>
  <rdfs:label>Friend</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ02 and part of CQ03</vaem:rationale>
  <dc:source>(competency_question) CQ02: Who are the friends of the player?
    (competency_question) CQ03: Who are the friends that play other games as well with this player?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Player -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#playsGameWith">
  <rdfs:comment>Relates a player to a game they play with others.</rdfs:comment>
  <rdfs:label>Plays Game With</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ03_a2</vaem:rationale>
  <dc:source>(competency_question) CQ03: Who are the friends that play other games as well with this player?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Game -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#achievement">
  <rdfs:comment>Relates a player to an achievement they possess.</rdfs:comment>
  <rdfs:label>Achievement</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ05</vaem:rationale>
  <dc:source>(competency_question) CQ05: What are the achievements of my friends?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Achievement -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasReceived">
  <rdfs:comment>Relates a player to an achievement they have received.</rdfs:comment>
  <rdfs:label>Has Received</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ07</vaem:rationale>
  <dc:source>(competency_question) CQ07: What are the achievements your friend has received?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Achievement -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasGame">
  <rdfs:comment>Relates an achievement to the game it belongs to.</rdfs:comment>
  <rdfs:label>Has Game</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ08, CQ10, and CQ35</vaem:rationale>
  <dc:source>(competency_question) CQ08: What achievements does a game have?
    (competency_question) CQ10: What are the types of achievements in this game?
    (competency_question) CQ35: In how many games does the player have all the achievements?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <!-- Axiom: domain Achievement -->
  <!-- Axiom: range Game -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasType">
  <rdfs:comment>Relates an achievement to its classification type.</rdfs:comment>
  <rdfs:label>Has Type</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ10, CQ11, and CQ27</vaem:rationale>
  <dc:source>(competency_question) CQ10: What are the types of achievements in this game?
    (competency_question) CQ11: What are the types of achievements a game can have?
    (competency_question) CQ27: What achievements of a certain type does the player have?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#AchievementType"/>
  <!-- Axiom: domain Achievement -->
  <!-- Axiom: range AchievementType -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#genre">
  <rdfs:comment>Relates a game to its genre classification.</rdfs:comment>
  <rdfs:label>Genre</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ12</vaem:rationale>
  <dc:source>(competency_question) CQ12: What is the genre of the game?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Genre"/>
  <!-- Axiom: domain Game -->
  <!-- Axiom: range Genre -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasItem">
  <rdfs:comment>Relates a game or player to an item they contain or possess.</rdfs:comment>
  <rdfs:label>Has Item</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ13 and CQ26</vaem:rationale>
  <dc:source>(competency_question) CQ13: What items exist in a game?
    (competency_question) CQ26: What items does the player have?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Item"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <!-- Axiom: domain Game -->
  <!-- Axiom: range Item -->
  <!-- Axiom: domain Player -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#belongsTo">
  <rdfs:comment>Relates a game to the genre it belongs to.</rdfs:comment>
  <rdfs:label>Belongs To</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ17 and acts as inverse of genre</vaem:rationale>
  <dc:source>(competency_question) CQ17: List all games of a certain Genre?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Genre"/>
  <owl:inverseOf rdf:resource="http://www.semanticweb.org/vgo#genre"/>
  <!-- Axiom: domain Game -->
  <!-- Axiom: range Genre -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasAbility">
  <rdfs:comment>Relates an item to the ability it grants.</rdfs:comment>
  <rdfs:label>Has Ability</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ19</vaem:rationale>
  <dc:source>(competency_question) CQ19: What abilities does an item have?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Item"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Ability"/>
  <!-- Axiom: domain Item -->
  <!-- Axiom: range Ability -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasKillCount">
  <rdfs:comment>Relates a player to their kill count statistic or associated game context.</rdfs:comment>
  <rdfs:label>Has Kill Count</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ22_a2</vaem:rationale>
  <dc:source>(competency_question) CQ22: Who has the best kill count in the game?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Player -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasObtained">
  <rdfs:comment>Relates a player to an achievement they have obtained.</rdfs:comment>
  <rdfs:label>Has Obtained</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ24</vaem:rationale>
  <dc:source>(competency_question) CQ24: What achievements has a player obtained?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Achievement -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasPlayed">
  <rdfs:comment>Relates a player to a game they have played.</rdfs:comment>
  <rdfs:label>Has Played</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ25 and CQ29</vaem:rationale>
  <dc:source>(competency_question) CQ25: What games has the player played?
    (competency_question) CQ29: What is the last game a player has played?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Game -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasAchievement">
  <rdfs:comment>Relates a player to an achievement they hold.</rdfs:comment>
  <rdfs:label>Has Achievement</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ27 and CQ35</vaem:rationale>
  <dc:source>(competency_question) CQ27: What achievements of a certain type does the player have?
    (competency_question) CQ35: In how many games does the player have all the achievements?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Achievement -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasEquipment">
  <rdfs:comment>Relates a player to equipment they possess.</rdfs:comment>
  <rdfs:label>Has Equipment</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ52</vaem:rationale>
  <dc:source>(competency_question) CQ52: What equipment does a player have in a game?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Equipment"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Equipment -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#playsIn">
  <rdfs:comment>Relates a player to a game they are currently playing or associated with.</rdfs:comment>
  <rdfs:label>Plays In</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ52 and CQ64</vaem:rationale>
  <dc:source>(competency_question) CQ52: What equipment does a player have in a game?
    (competency_question) CQ64: How long does a player spend in the game before making first IAP?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Game -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#allowsUsing">
  <rdfs:comment>Relates an item to the games where it can be used.</rdfs:comment>
  <rdfs:label>Allows Using</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ55</vaem:rationale>
  <dc:source>(competency_question) CQ55: What are the games where a player can use this item?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Item"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <!-- Axiom: domain Item -->
  <!-- Axiom: range Game -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasMade">
  <rdfs:comment>Relates a player or customer to an in-app purchase they have made.</rdfs:comment>
  <rdfs:label>Has Made</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ56, CQ64, CQ65, and CQ66</vaem:rationale>
  <dc:source>(competency_question) CQ56: How many players have made in app purchases?
    (competency_question) CQ64: How long does a player spend in the game before making first IAP?
    (competency_question) CQ65: Where do the players live who have not made any IAP?
    (competency_question) CQ66: Where do the players who have done the most IAP live?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#InAppPurchase"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range InAppPurchase -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasSpent">
  <rdfs:comment>Relates a player to spending activity or purchases.</rdfs:comment>
  <rdfs:label>Has Spent</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ57_a1</vaem:rationale>
  <dc:source>(competency_question) CQ57: How many players who have already spent money, spend money again?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#InAppPurchase"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range InAppPurchase -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#spendsAgain">
  <rdfs:comment>Relates a player to repeat spending behavior.</rdfs:comment>
  <rdfs:label>Spends Again</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ57_a2</vaem:rationale>
  <dc:source>(competency_question) CQ57: How many players who have already spent money, spend money again?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#InAppPurchase"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range InAppPurchase -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#livesIn">
  <rdfs:comment>Relates a player or customer to their residential location.</rdfs:comment>
  <rdfs:label>Lives In</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ63, CQ65, and CQ66</vaem:rationale>
  <dc:source>(competency_question) CQ63: Where do the most paying customers live?
    (competency_question) CQ65: Where do the players live who have not made any IAP?
    (competency_question) CQ66: Where do the players who have done the most IAP live?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Location"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Customer"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Location -->
  <!-- Axiom: domain Customer -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasPlayingArea">
  <rdfs:comment>Relates a game to its playing areas or maps.</rdfs:comment>
  <rdfs:label>Has Playing Area</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers New CQ1</vaem:rationale>
  <dc:source>(competency_question) New CQ1: What playing areas does a game have?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#PlayingArea"/>
  <!-- Axiom: domain Game -->
  <!-- Axiom: range PlayingArea -->
</owl:ObjectProperty>

  <!-- owl:DatatypeProperty declarations -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#username">
  <rdfs:comment>The unique identifier or handle of a player.</rdfs:comment>
  <rdfs:label>Username</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ01</vaem:rationale>
  <dc:source>(competency_question) CQ01: What is the username of the player?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#hoursPlayed">
  <rdfs:comment>The total number of hours a game has been played.</rdfs:comment>
  <rdfs:label>Hours Played</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ09</vaem:rationale>
  <dc:source>(competency_question) CQ09: How many hours has this game been played in total?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Game -->
  <!-- Axiom: range float -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#releaseDate">
  <rdfs:comment>The date when a game was released.</rdfs:comment>
  <rdfs:label>Release Date</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ15</vaem:rationale>
  <dc:source>(competency_question) CQ15: What is the release date of the game?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Game -->
  <!-- Axiom: range dateTime -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#killCount">
  <rdfs:comment>The number of kills recorded in a game.</rdfs:comment>
  <rdfs:label>Kill Count</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ22_a1</vaem:rationale>
  <dc:source>(competency_question) CQ22: Who has the best kill count in the game?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Game -->
  <!-- Axiom: range integer -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#time">
  <rdfs:comment>The timestamp when an in-app purchase occurred.</rdfs:comment>
  <rdfs:label>Time</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ62</vaem:rationale>
  <dc:source>(competency_question) CQ62: What time are most of the in app purchases done?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#InAppPurchase"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain InAppPurchase -->
  <!-- Axiom: range dateTime -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#timeSpent">
  <rdfs:comment>The duration a player spends in a game before making a purchase.</rdfs:comment>
  <rdfs:label>Time Spent</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ64</vaem:rationale>
  <dc:source>(competency_question) CQ64: How long does a player spend in the game before making first IAP?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range float -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#numberOfIaps">
  <rdfs:comment>The count of in-app purchases made by a player.</rdfs:comment>
  <rdfs:label>Number of IAPs</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ66_a1</vaem:rationale>
  <dc:source>(competency_question) CQ66: Where do the players who have done the most IAP live?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range integer -->
</owl:DatatypeProperty>

</rdf:RDF>