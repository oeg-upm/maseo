  <!-- Axiom: domain Customer -->
  <!-- Axiom: range Payment -->
  <!-- Axiom: SubPropertyOf hasPaymentAssociation -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasPayment">
  <rdfs:comment>Relates a customer to a payment record.</rdfs:comment>
  <rdfs:label>Has Payment</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ63</vaem:rationale>
  <dc:source>(competency_question) CQ63: Where do the most paying customers live?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Customer"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Payment"/>
  <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/vgo#hasPaymentAssociation"/>
  <!-- Axiom: domain Customer -->
  <!-- Axiom: range Payment -->
  <!-- Axiom: SubPropertyOf hasPaymentAssociation -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#relatesToGame">
  <rdfs:comment>General property relating a player to games they interact with.</rdfs:comment>
  <rdfs:label>Relates To Game</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Generalizes playsIn, hasPlayed, lastGame per instruction
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] created: Generalizes playsIn, hasPlayed, lastGame</vaem:rationale>
  <dc:source>(competency_question) CQ22: Who has the best kill count in the game?
    (competency_question) CQ25: What games has the player played?
    (competency_question) CQ29: What is the last game a player has played?
    (competency_question) CQ35: In how many games does the player have all the achievements?
    (competency_question) CQ52: What equipment does a player have in a game?
    (competency_question) CQ64: How long does a player spend in the game before making first IAP?
    (competency_question) CQ22, CQ25, CQ29, CQ35, CQ52, CQ64</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Game -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#playsIn">
  <rdfs:comment>Relates a player to a game they are playing.</rdfs:comment>
  <rdfs:label>Plays In</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ22, CQ35, CQ52, CQ64</vaem:rationale>
  <dc:source>(competency_question) CQ22: Who has the best kill count in the game?
    (competency_question) CQ35: In how many games does the player have all the achievements?
    (competency_question) CQ52: What equipment does a player have in a game?
    (competency_question) CQ64: How long does a player spend in the game before making first IAP?
    (competency_question) CQ22, CQ35, CQ52, CQ64</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/vgo#relatesToGame"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Game -->
  <!-- Axiom: SubPropertyOf relatesToGame -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasPlayed">
  <rdfs:comment>Relates a player to a game they have played.</rdfs:comment>
  <rdfs:label>Has Played</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ25</vaem:rationale>
  <dc:source>(competency_question) CQ25: What games has the player played?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/vgo#relatesToGame"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Game -->
  <!-- Axiom: SubPropertyOf relatesToGame -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#lastGame">
  <rdfs:comment>Relates a player to their most recently played game.</rdfs:comment>
  <rdfs:label>Last Game</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ29</vaem:rationale>
  <dc:source>(competency_question) CQ29: What is the last game a player has played?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/vgo#relatesToGame"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Game -->
  <!-- Axiom: SubPropertyOf relatesToGame -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasAchievementAssociation">
  <rdfs:comment>General property relating a player to achievements.</rdfs:comment>
  <rdfs:label>Has Achievement Association</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Generalizes achievement, receives, obtains per instruction
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] created: Generalizes achievement, receives, obtains</vaem:rationale>
  <dc:source>(competency_question) CQ05: What are the achievements of my friends?
    (competency_question) CQ07: What are the achievements your friend has received?
    (competency_question) CQ24: What achievements has a player obtained?
    (competency_question) CQ05, CQ07, CQ24</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Achievement -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#achievement">
  <rdfs:comment>Relates a player or game to an achievement they hold.</rdfs:comment>
  <rdfs:label>Achievement</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ05, CQ35
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] created: Answers CQ05, CQ35, CQ11
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] added domain Game axiom: Themis test CQ11 requires achievement domain Game</vaem:rationale>
  <dc:source>(competency_question) CQ05: What are the achievements of my friends?
    (competency_question) CQ35: In how many games does the player have all the achievements?
    (competency_question) CQ05, CQ35, CQ11
    (themis_test) achievement domain Game -&gt; Absent</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
  <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/vgo#hasAchievementAssociation"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Achievement -->
  <!-- Axiom: SubPropertyOf hasAchievementAssociation -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#receives">
  <rdfs:comment>Relates a player to an achievement they receive.</rdfs:comment>
  <rdfs:label>Receives</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ07</vaem:rationale>
  <dc:source>(competency_question) CQ07: What are the achievements your friend has received?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
  <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/vgo#hasAchievementAssociation"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Achievement -->
  <!-- Axiom: SubPropertyOf hasAchievementAssociation -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#obtains">
  <rdfs:comment>Relates a player to an achievement they obtain.</rdfs:comment>
  <rdfs:label>Obtains</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ24</vaem:rationale>
  <dc:source>(competency_question) CQ24: What achievements has a player obtained?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
  <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/vgo#hasAchievementAssociation"/>
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Achievement -->
  <!-- Axiom: SubPropertyOf hasAchievementAssociation -->
</owl:ObjectProperty>

