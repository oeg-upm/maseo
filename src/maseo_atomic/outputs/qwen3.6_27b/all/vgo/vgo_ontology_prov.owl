      <prov:hadActivity rdf:resource="http://www.semanticweb.org/vgo_prov#ExtractionActivity"/>
    </prov:Derivation>
  </prov:qualifiedDerivation>
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/vgo_prov#CQ56"/>
  <prov:qualifiedDerivation>
    <prov:Derivation>
      <prov:entity rdf:resource="http://www.semanticweb.org/vgo_prov#CQ56"/>
      <prov:hadActivity rdf:resource="http://www.semanticweb.org/vgo_prov#ExtractionActivity"/>
    </prov:Derivation>
  </prov:qualifiedDerivation>
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/vgo_prov#CQ57"/>
