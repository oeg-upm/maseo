  <rdfs:label>Is Good For</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Connects Wine to Vintage in CQ7, following the supplied-asks direction rule
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] swapped domain and range to Vintage and Wine: Themis test CQ7 requires isGoodFor domain Vintage and range Wine</vaem:rationale>
  <dc:source>(competency_question) CQ7: What were good vintages for Napa Zinfandel?
    (themis_test) CQ7: isGoodFor domain Vintage -&gt; Absent; isGoodFor range Wine -&gt; Absent</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Vintage"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/wine#Wine"/>
  <!-- Axiom: domain Vintage -->
  <!-- Axiom: range Wine -->
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/wine_prov#CQ7"/>
  <prov:qualifiedDerivation>
    <prov:Derivation>
      <prov:entity rdf:resource="http://www.semanticweb.org/wine_prov#CQ7"/>
      <prov:hadActivity rdf:resource="http://www.semanticweb.org/wine_prov#RefinementActivity"/>
    </prov:Derivation>
  </prov:qualifiedDerivation>
  <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/wine_prov#GenerationActivity"/>
  <prov:wasRevisionOf rdf:resource="http://www.semanticweb.org/wine_prov#removed_for"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/wine_prov#RefinementActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/wine_prov#agent_TermRefinement_Agent"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/wine_prov#agent_OntoGeneration_Agent"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/wine_prov#OntoCorrectionActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/wine_prov#agent_OntoCorrection_Agent"/>
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/wine_prov#Report_r1_themis_test_15"/>
  <vaem:rationale>[OntoCorrection Agent | themis_test] changed at OntoCorrectionActivity: added axioms: isGoodFor domain Vintage; isGoodFor range Wine; removed axioms: isGoodFor domain Wine; isGoodFor range Vintage; Comment changed; Domain changed; Range changed</vaem:rationale>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#usedToMake">
  <rdfs:comment>Relates a grape variety to the wine it is used to make.</rdfs:comment>
