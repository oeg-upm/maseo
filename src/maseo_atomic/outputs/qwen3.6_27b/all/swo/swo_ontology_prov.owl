      <prov:entity rdf:resource="http://www.semanticweb.org/swo_prov#CQ05"/>
      <prov:hadActivity rdf:resource="http://www.semanticweb.org/swo_prov#RefinementActivity"/>
    </prov:Derivation>
  </prov:qualifiedDerivation>
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/swo_prov#CQ06"/>
