  <prov:hadRole rdf:resource="http://www.semanticweb.org/swo_prov#RefinementRole"/>
</prov:SoftwareAgent>

<prov:SoftwareAgent rdf:about="http://www.semanticweb.org/swo_prov#agent_TermRefinement_Agent">
