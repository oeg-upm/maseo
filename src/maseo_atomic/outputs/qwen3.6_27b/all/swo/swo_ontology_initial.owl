<?xml version="1.0"?>
<rdf:RDF xml:base="http://www.semanticweb.org/swo#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:vaem="http://www.linkedmodel.org/schema/vaem#">

  <owl:Ontology rdf:about="http://www.semanticweb.org/swo#"/>

  <!-- owl:Class declarations -->

<owl:Class rdf:about="http://www.semanticweb.org/swo#Software">
  <rdfs:comment>A computational tool or program that performs tasks, processes data, and provides features.</rdfs:comment>
  <rdfs:label>Software</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Core entity supplied across nearly all competency questions</vaem:rationale>
  <dc:source>(competency_question) CQ04: Which of the named and published algorithms does this tool use?
    (competency_question) CQ05: Are there any modifications to the algorithm the tool uses?
    (competency_question) CQ06: Does this software provide XML editing?
    (competency_question) CQ07: What type of software (API, Desktop application etc) is it?
    (competency_question) CQ08: What software can perform task x?
    (competency_question) CQ14: Does it do what I want or need it to do e.g. render a gif?
    (competency_question) CQ15: Which software tool created this data?
    (competency_question) CQ16: What software can I use my data with to support my task?
    (competency_question) CQ17: What are the input and output formats for this software?
    (competency_question) CQ19: What software can read a .cel file?
    (competency_question) CQ21: What is the valid input for this software?
    (competency_question) CQ22: Can this software export from its proprietary data format to an open format such as csv, txt?
    (competency_question) CQ23: Can software A work with data that are output from software B?
    (competency_question) CQ26: What open source, maintained software can I use to process these in this format?
    (competency_question) CQ30: Where can I get the software?
    (competency_question) CQ32: How do I get help?
    (competency_question) CQ36: Who developed it?
    (competency_question) CQ37: What is the homepage of the software?
    (competency_question) CQ38: Can we collaborate with developers of software x?
    (competency_question) CQ40: Which URL can I get it from?
    (competency_question) CQ45: How long has this software been around?
    (competency_question) CQ46: How actively developed is it?
    (competency_question) CQ54: What is the version of this software?
    (competency_question) CQ58: Is the software open source development? Is there a community development?
    (competency_question) CQ60: Is it open source or not?
    (competency_question) CQ65: Is it FOSS?
    (competency_question) CQ68: Is it free or not?
    (competency_question) CQ73: Where is the documentation?
    (competency_question) CQ84: In what language was it implemented?
    (competency_question) CQ85: What platform does the software run on?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#Algorithm">
  <rdfs:comment>A step-by-step procedure or formula for solving a problem or accomplishing a task.</rdfs:comment>
  <rdfs:label>Algorithm</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ04 and CQ05 ask about algorithms used by software</vaem:rationale>
  <dc:source>(competency_question) CQ04: Which of the named and published algorithms does this tool use?
    (competency_question) CQ05: Are there any modifications to the algorithm the tool uses?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#Modification">
  <rdfs:comment>An alteration or change made to an algorithm.</rdfs:comment>
  <rdfs:label>Modification</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ05 asks about modifications to algorithms</vaem:rationale>
  <dc:source>(competency_question) CQ05: Are there any modifications to the algorithm the tool uses?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#XmlEditing">
  <rdfs:comment>The capability to edit XML files or structures.</rdfs:comment>
  <rdfs:label>XML Editing</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06 asks if software provides XML editing</vaem:rationale>
  <dc:source>(competency_question) CQ06: Does this software provide XML editing?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#Api">
  <rdfs:comment>An application programming interface that allows software components to communicate.</rdfs:comment>
  <rdfs:label>API</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ07 lists it as a software type</vaem:rationale>
  <dc:source>(competency_question) CQ07: What type of software (API, Desktop application etc) is it?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/swo#DesktopApplication"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/swo#WebService"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/swo#CommandLineTool"/>
  <!-- Axiom: Disjoint with DesktopApplication, WebService, CommandLineTool -->
  <!-- Axiom: SubClassOf Software -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#DesktopApplication">
  <rdfs:comment>Software designed to run on a personal computer operating system.</rdfs:comment>
  <rdfs:label>Desktop Application</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ07 lists it as a software type</vaem:rationale>
  <dc:source>(competency_question) CQ07: What type of software (API, Desktop application etc) is it?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/swo#Api"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/swo#WebService"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/swo#CommandLineTool"/>
  <!-- Axiom: Disjoint with Api, WebService, CommandLineTool -->
  <!-- Axiom: SubClassOf Software -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#WebService">
  <rdfs:comment>Software that provides data or functionality over a network using standard protocols.</rdfs:comment>
  <rdfs:label>Web Service</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ07 and CQ11 list it as a software type/availability</vaem:rationale>
  <dc:source>(competency_question) CQ07: What type of software (API, Desktop application etc) is it?
    (competency_question) CQ11: Is this software available as a web service?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/swo#Api"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/swo#DesktopApplication"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/swo#CommandLineTool"/>
  <!-- Axiom: Disjoint with Api, DesktopApplication, CommandLineTool -->
  <!-- Axiom: SubClassOf Software -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#CommandLineTool">
  <rdfs:comment>Software operated via text-based command line interfaces.</rdfs:comment>
  <rdfs:label>Command Line Tool</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ07 lists it as a software type</vaem:rationale>
  <dc:source>(competency_question) CQ07: What type of software (API, Desktop application etc) is it?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/swo#Api"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/swo#DesktopApplication"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/swo#WebService"/>
  <!-- Axiom: Disjoint with Api, DesktopApplication, WebService -->
  <!-- Axiom: SubClassOf Software -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#Task">
  <rdfs:comment>A specific operation or job that software can perform.</rdfs:comment>
  <rdfs:label>Task</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ08 and CQ16 ask about tasks performed or supported</vaem:rationale>
  <dc:source>(competency_question) CQ08: What software can perform task x?
    (competency_question) CQ16: What software can I use my data with to support my task?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#GifRenderingCapability">
  <rdfs:comment>The ability to render GIF image files.</rdfs:comment>
  <rdfs:label>GIF Rendering Capability</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ14 asks about GIF rendering capability</vaem:rationale>
  <dc:source>(competency_question) CQ14: Does it do what I want or need it to do e.g. render a gif?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#Data">
  <rdfs:comment>Information or content processed, created, or output by software.</rdfs:comment>
  <rdfs:label>Data</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ15, CQ16, CQ23, CQ26 ask about data creation, compatibility, and processing</vaem:rationale>
  <dc:source>(competency_question) CQ15: Which software tool created this data?
    (competency_question) CQ16: What software can I use my data with to support my task?
    (competency_question) CQ23: Can software A work with data that are output from software B?
    (competency_question) CQ26: What open source, maintained software can I use to process these in this format?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#InputFormat">
  <rdfs:comment>A file or data format accepted as input by software.</rdfs:comment>
  <rdfs:label>Input Format</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ17 asks for input formats</vaem:rationale>
  <dc:source>(competency_question) CQ17: What are the input and output formats for this software?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#OutputFormat">
  <rdfs:comment>A file or data format produced as output by software.</rdfs:comment>
  <rdfs:label>Output Format</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ17 asks for output formats</vaem:rationale>
  <dc:source>(competency_question) CQ17: What are the input and output formats for this software?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#CelFile">
  <rdfs:comment>A specific file format used in microarray data analysis.</rdfs:comment>
  <rdfs:label>CEL File</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ19 asks about software that reads .cel files</vaem:rationale>
  <dc:source>(competency_question) CQ19: What software can read a .cel file?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#ValidInput">
  <rdfs:comment>Data or formats that are correctly accepted by software.</rdfs:comment>
  <rdfs:label>Valid Input</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ21 asks about valid input</vaem:rationale>
  <dc:source>(competency_question) CQ21: What is the valid input for this software?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#Format">
  <rdfs:comment>A structured representation of data or files.</rdfs:comment>
  <rdfs:label>Format</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ22 and CQ26 ask about export formats and processing formats</vaem:rationale>
  <dc:source>(competency_question) CQ22: Can this software export from its proprietary data format to an open format such as csv, txt?
    (competency_question) CQ26: What open source, maintained software can I use to process these in this format?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#License">
  <rdfs:comment>Legal permission governing the use of software.</rdfs:comment>
  <rdfs:label>License</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ26 and CQ59 ask about software licenses</vaem:rationale>
  <dc:source>(competency_question) CQ26: What open source, maintained software can I use to process these in this format?
    (competency_question) CQ59: What license and what is permissiveness?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#MaintenanceStatus">
  <rdfs:comment>The state of upkeep and support for a software project.</rdfs:comment>
  <rdfs:label>Maintenance Status</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ26 asks if software is maintained</vaem:rationale>
  <dc:source>(competency_question) CQ26: What open source, maintained software can I use to process these in this format?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#Version">
  <rdfs:comment>A specific release or iteration of software.</rdfs:comment>
  <rdfs:label>Version</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ29, CQ54, CQ55, CQ57 ask about versions and their features/dates</vaem:rationale>
  <dc:source>(competency_question) CQ29: Given input x, what are the data exports for this version?
    (competency_question) CQ54: What is the version of this software?
    (competency_question) CQ55: What new features are in this version?
    (competency_question) CQ57: When was the 1.0 version released?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#DataExport">
  <rdfs:comment>Data produced and exported by a specific software version.</rdfs:comment>
  <rdfs:label>Data Export</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ29 asks about data exports for a version</vaem:rationale>
  <dc:source>(competency_question) CQ29: Given input x, what are the data exports for this version?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#DownloadLocation">
  <rdfs:comment>A place or URL where software can be obtained.</rdfs:comment>
  <rdfs:label>Download Location</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ30 asks where software can be obtained</vaem:rationale>
  <dc:source>(competency_question) CQ30: Where can I get the software?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#Developer">
  <rdfs:comment>A person or organization that creates software.</rdfs:comment>
  <rdfs:label>Developer</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ36 and CQ38 ask about developers and collaboration</vaem:rationale>
  <dc:source>(competency_question) CQ36: Who developed it?
    (competency_question) CQ38: Can we collaborate with developers of software x?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#Homepage">
  <rdfs:comment>The primary web page for a software project.</rdfs:comment>
  <rdfs:label>Homepage</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ37 asks for the homepage</vaem:rationale>
  <dc:source>(competency_question) CQ37: What is the homepage of the software?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#Url">
  <rdfs:comment>A web address providing access to software or resources.</rdfs:comment>
  <rdfs:label>URL</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ40 asks which URL provides the software</vaem:rationale>
  <dc:source>(competency_question) CQ40: Which URL can I get it from?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#Duration">
  <rdfs:comment>The length of time software has existed or been active.</rdfs:comment>
  <rdfs:label>Duration</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ45 asks how long software has been around</vaem:rationale>
  <dc:source>(competency_question) CQ45: How long has this software been around?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#DevelopmentActivity">
  <rdfs:comment>The level of ongoing work and updates on a software project.</rdfs:comment>
  <rdfs:label>Development Activity</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ46 asks about active development</vaem:rationale>
  <dc:source>(competency_question) CQ46: How actively developed is it?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#Feature">
  <rdfs:comment>A distinct capability or function of a software version.</rdfs:comment>
  <rdfs:label>Feature</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ55 asks about new features in a version</vaem:rationale>
  <dc:source>(competency_question) CQ55: What new features are in this version?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#OpenSourceDevelopment">
  <rdfs:comment>A development model where source code is publicly accessible and modifiable.</rdfs:comment>
  <rdfs:label>Open Source Development</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ58 asks about open source development</vaem:rationale>
  <dc:source>(competency_question) CQ58: Is the software open source development? Is there a community development?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#CommunityDevelopment">
  <rdfs:comment>Development driven by a community of contributors.</rdfs:comment>
  <rdfs:label>Community Development</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ58 asks about community development</vaem:rationale>
  <dc:source>(competency_question) CQ58: Is the software open source development? Is there a community development?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#Permissiveness">
  <rdfs:comment>The degree of freedom granted by a software license.</rdfs:comment>
  <rdfs:label>Permissiveness</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ59 asks about permissiveness level</vaem:rationale>
  <dc:source>(competency_question) CQ59: What license and what is permissiveness?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#OpenSourceSoftware">
  <rdfs:comment>Software whose source code is available for modification and redistribution.</rdfs:comment>
  <rdfs:label>Open Source Software</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ60 asks if software is open source</vaem:rationale>
  <dc:source>(competency_question) CQ60: Is it open source or not?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <!-- Axiom: SubClassOf Software -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#FossSoftware">
  <rdfs:comment>Free and Open Source Software combining freedom and open source principles.</rdfs:comment>
  <rdfs:label>FOSS Software</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ65 asks if software is FOSS</vaem:rationale>
  <dc:source>(competency_question) CQ65: Is it FOSS?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <!-- Axiom: SubClassOf Software -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#FreeSoftware">
  <rdfs:comment>Software that respects user freedom and community.</rdfs:comment>
  <rdfs:label>Free Software</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ68 asks if software is free</vaem:rationale>
  <dc:source>(competency_question) CQ68: Is it free or not?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <!-- Axiom: SubClassOf Software -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/swo#Platform">
  <rdfs:comment>The operating system or environment on which software runs.</rdfs:comment>
  <rdfs:label>Platform</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ85 asks about the platform</vaem:rationale>
  <dc:source>(competency_question) CQ85: What platform does the software run on?</dc:source>
</owl:Class>

  <!-- owl:ObjectProperty declarations -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasAlgorithm">
  <rdfs:comment>Relates software to the algorithm it uses.</rdfs:comment>
  <rdfs:label>Has Algorithm</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ04 asks which algorithm a tool uses</vaem:rationale>
  <dc:source>(competency_question) CQ04: Which of the named and published algorithms does this tool use?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Algorithm"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range Algorithm -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasModification">
  <rdfs:comment>Relates an algorithm to its modifications.</rdfs:comment>
  <rdfs:label>Has Modification</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ05 asks about modifications to algorithms</vaem:rationale>
  <dc:source>(competency_question) CQ05: Are there any modifications to the algorithm the tool uses?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Algorithm"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Modification"/>
  <!-- Axiom: domain Algorithm -->
  <!-- Axiom: range Modification -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#has">
  <rdfs:comment>A general relation indicating software possesses a capability or attribute.</rdfs:comment>
  <rdfs:label>Has</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06, CQ14, CQ58 use 'has' for different capabilities</vaem:rationale>
  <dc:source>(competency_question) CQ06: Does this software provide XML editing?
    (competency_question) CQ14: Does it do what I want or need it to do e.g. render a gif?
    (competency_question) CQ58: Is the software open source development? Is there a community development?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#XmlEditing"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#GifRenderingCapability"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#CommunityDevelopment"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range XmlEditing -->
  <!-- Axiom: range GifRenderingCapability -->
  <!-- Axiom: range CommunityDevelopment -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasSoftwareType">
  <rdfs:comment>Relates software to its classification or type.</rdfs:comment>
  <rdfs:label>Has Software Type</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ07 asks what type of software it is</vaem:rationale>
  <dc:source>(competency_question) CQ07: What type of software (API, Desktop application etc) is it?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range Software -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#performsTask">
  <rdfs:comment>Relates software to a task it can execute.</rdfs:comment>
  <rdfs:label>Performs Task</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ08 asks what software can perform a task</vaem:rationale>
  <dc:source>(competency_question) CQ08: What software can perform task x?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Task"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range Task -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#createsData">
  <rdfs:comment>Relates software to the data it generates.</rdfs:comment>
  <rdfs:label>Creates Data</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ15 asks which tool created data</vaem:rationale>
  <dc:source>(competency_question) CQ15: Which software tool created this data?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Data"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range Data -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#supportsTask">
  <rdfs:comment>Relates software to a task it supports.</rdfs:comment>
  <rdfs:label>Supports Task</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ16 asks which software supports a task</vaem:rationale>
  <dc:source>(competency_question) CQ16: What software can I use my data with to support my task?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Task"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range Task -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#isCompatibleWith">
  <rdfs:comment>Relates software to data it can work with.</rdfs:comment>
  <rdfs:label>Is Compatible With</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ16 and CQ23 ask about compatibility with data</vaem:rationale>
  <dc:source>(competency_question) CQ16: What software can I use my data with to support my task?
    (competency_question) CQ23: Can software A work with data that are output from software B?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Data"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range Data -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasInputFormat">
  <rdfs:comment>Relates software to its accepted input formats.</rdfs:comment>
  <rdfs:label>Has Input Format</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ17 asks for input formats</vaem:rationale>
  <dc:source>(competency_question) CQ17: What are the input and output formats for this software?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#InputFormat"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range InputFormat -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasOutputFormat">
  <rdfs:comment>Relates software to its produced output formats.</rdfs:comment>
  <rdfs:label>Has Output Format</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ17 asks for output formats</vaem:rationale>
  <dc:source>(competency_question) CQ17: What are the input and output formats for this software?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#OutputFormat"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range OutputFormat -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#readsFile">
  <rdfs:comment>Relates software to file types it can read.</rdfs:comment>
  <rdfs:label>Reads File</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ19 asks what software can read a .cel file</vaem:rationale>
  <dc:source>(competency_question) CQ19: What software can read a .cel file?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#CelFile"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range CelFile -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasValidInput">
  <rdfs:comment>Relates software to its valid input specifications.</rdfs:comment>
  <rdfs:label>Has Valid Input</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ21 asks about valid input</vaem:rationale>
  <dc:source>(competency_question) CQ21: What is the valid input for this software?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#ValidInput"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range ValidInput -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasExportTo">
  <rdfs:comment>Relates software to formats it can export to.</rdfs:comment>
  <rdfs:label>Has Export To</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ22 asks about export capabilities</vaem:rationale>
  <dc:source>(competency_question) CQ22: Can this software export from its proprietary data format to an open format such as csv, txt?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Format"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range Format -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#outputsData">
  <rdfs:comment>Relates software to the data it outputs.</rdfs:comment>
  <rdfs:label>Outputs Data</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ23 asks what data software outputs</vaem:rationale>
  <dc:source>(competency_question) CQ23: Can software A work with data that are output from software B?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Data"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range Data -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#processDataInFormat">
  <rdfs:comment>Relates software to data it processes in a specific format.</rdfs:comment>
  <rdfs:label>Process Data In Format</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ26 asks about processing data in a format</vaem:rationale>
  <dc:source>(competency_question) CQ26: What open source, maintained software can I use to process these in this format?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Data"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range Data -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasLicense">
  <rdfs:comment>Relates software to its licensing terms.</rdfs:comment>
  <rdfs:label>Has License</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ26 and CQ59 ask about licenses</vaem:rationale>
  <dc:source>(competency_question) CQ26: What open source, maintained software can I use to process these in this format?
    (competency_question) CQ59: What license and what is permissiveness?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#License"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range License -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasDataExport">
  <rdfs:comment>Relates a version to its data exports.</rdfs:comment>
  <rdfs:label>Has Data Export</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ29 asks about data exports for a version</vaem:rationale>
  <dc:source>(competency_question) CQ29: Given input x, what are the data exports for this version?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Version"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#DataExport"/>
  <!-- Axiom: domain Version -->
  <!-- Axiom: range DataExport -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasHelpChannel">
  <rdfs:comment>Relates software to its support or help resources.</rdfs:comment>
  <rdfs:label>Has Help Channel</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ32 asks how help is obtained</vaem:rationale>
  <dc:source>(competency_question) CQ32: How do I get help?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <!-- Axiom: domain Software -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#developedBy">
  <rdfs:comment>Relates software to its creator or developer.</rdfs:comment>
  <rdfs:label>Developed By</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ36 asks who developed the software</vaem:rationale>
  <dc:source>(competency_question) CQ36: Who developed it?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Developer"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range Developer -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#collaboratesWith">
  <rdfs:comment>Relates a developer to software they collaborate on.</rdfs:comment>
  <rdfs:label>Collaborates With</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ38 asks about collaborating with developers</vaem:rationale>
  <dc:source>(competency_question) CQ38: Can we collaborate with developers of software x?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Developer"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <!-- Axiom: domain Developer -->
  <!-- Axiom: range Software -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#providesSoftware">
  <rdfs:comment>Relates a URL to the software it hosts.</rdfs:comment>
  <rdfs:label>Provides Software</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ40 asks which URL provides the software</vaem:rationale>
  <dc:source>(competency_question) CQ40: Which URL can I get it from?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Url"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <!-- Axiom: domain Url -->
  <!-- Axiom: range Software -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasVersion">
  <rdfs:comment>Relates software to a specific version release.</rdfs:comment>
  <rdfs:label>Has Version</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ54 asks for the version of software</vaem:rationale>
  <dc:source>(competency_question) CQ54: What is the version of this software?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Version"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range Version -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasFeature">
  <rdfs:comment>Relates a version to its included features.</rdfs:comment>
  <rdfs:label>Has Feature</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ55 asks about new features in a version</vaem:rationale>
  <dc:source>(competency_question) CQ55: What new features are in this version?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Version"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Feature"/>
  <!-- Axiom: domain Version -->
  <!-- Axiom: range Feature -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasDevelopmentModel">
  <rdfs:comment>Relates software to its development methodology.</rdfs:comment>
  <rdfs:label>Has Development Model</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ58 asks about open source development</vaem:rationale>
  <dc:source>(competency_question) CQ58: Is the software open source development? Is there a community development?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#OpenSourceDevelopment"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range OpenSourceDevelopment -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#implementedIn">
  <rdfs:comment>Relates software to the programming language or environment it is built in.</rdfs:comment>
  <rdfs:label>Implemented In</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ84 asks what language it was implemented in</vaem:rationale>
  <dc:source>(competency_question) CQ84: In what language was it implemented?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <!-- Axiom: domain Software -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#hasPlatform">
  <rdfs:comment>Relates software to the platform it runs on.</rdfs:comment>
  <rdfs:label>Has Platform</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ85 asks about the platform</vaem:rationale>
  <dc:source>(competency_question) CQ85: What platform does the software run on?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Platform"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range Platform -->
</owl:ObjectProperty>

  <!-- owl:DatatypeProperty declarations -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/swo#isMaintained">
  <rdfs:comment>Indicates whether software is actively maintained.</rdfs:comment>
  <rdfs:label>Is Maintained</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ26 asks if software is maintained</vaem:rationale>
  <dc:source>(competency_question) CQ26: What open source, maintained software can I use to process these in this format?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range boolean -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/swo#hasDownloadLocation">
  <rdfs:comment>The URL or location where software can be downloaded.</rdfs:comment>
  <rdfs:label>Has Download Location</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ30 asks where software can be obtained</vaem:rationale>
  <dc:source>(competency_question) CQ30: Where can I get the software?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range anyURI -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/swo#hasHomepage">
  <rdfs:comment>The web address of the software's homepage.</rdfs:comment>
  <rdfs:label>Has Homepage</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ37 asks for the homepage</vaem:rationale>
  <dc:source>(competency_question) CQ37: What is the homepage of the software?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range anyURI -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/swo#hasDuration">
  <rdfs:comment>The length of time the software has been in existence.</rdfs:comment>
  <rdfs:label>Has Duration</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ45 asks how long software has been around</vaem:rationale>
  <dc:source>(competency_question) CQ45: How long has this software been around?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/swo#hasActivityLevel">
  <rdfs:comment>The degree of active development on the software.</rdfs:comment>
  <rdfs:label>Has Activity Level</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ46 asks about active development</vaem:rationale>
  <dc:source>(competency_question) CQ46: How actively developed is it?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Software -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/swo#hasReleaseDate">
  <rdfs:comment>The date when a version was released.</rdfs:comment>
  <rdfs:label>Has Release Date</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ57 asks when a version was released</vaem:rationale>
  <dc:source>(competency_question) CQ57: When was the 1.0 version released?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Version"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Version -->
  <!-- Axiom: range dateTime -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/swo#hasPermissivenessLevel">
  <rdfs:comment>The degree of freedom granted by a license.</rdfs:comment>
  <rdfs:label>Has Permissiveness Level</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ59 asks about permissiveness</vaem:rationale>
  <dc:source>(competency_question) CQ59: What license and what is permissiveness?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Permissiveness"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain Permissiveness -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/swo#hasLocation">
  <rdfs:comment>The location or URL of documentation or resources.</rdfs:comment>
  <rdfs:label>Has Location</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ73 asks where documentation is</vaem:rationale>
  <dc:source>(competency_question) CQ73: Where is the documentation?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  <!-- Axiom: domain Software -->
</owl:DatatypeProperty>

  <!-- owl:NamedIndividual declarations -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/swo#TaskX">
  <rdfs:comment>A specific task referenced in competency questions.</rdfs:comment>
  <rdfs:label>Task X</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ08 supplies TaskX as an instance</vaem:rationale>
  <dc:source>(competency_question) CQ08: What software can perform task x?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/swo#Task"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/swo#Csv">
  <rdfs:comment>Comma-separated values file format.</rdfs:comment>
  <rdfs:label>CSV</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ22 supplies Csv as an instance</vaem:rationale>
  <dc:source>(competency_question) CQ22: Can this software export from its proprietary data format to an open format such as csv, txt?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/swo#Format"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/swo#Txt">
  <rdfs:comment>Plain text file format.</rdfs:comment>
  <rdfs:label>TXT</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ22 supplies Txt as an instance</vaem:rationale>
  <dc:source>(competency_question) CQ22: Can this software export from its proprietary data format to an open format such as csv, txt?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/swo#Format"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/swo#SoftwareB">
  <rdfs:comment>A specific software tool referenced in competency questions.</rdfs:comment>
  <rdfs:label>Software B</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ23 supplies SoftwareB as an instance</vaem:rationale>
  <dc:source>(competency_question) CQ23: Can software A work with data that are output from software B?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/swo#Software"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/swo#SoftwareA">
  <rdfs:comment>A specific software tool referenced in competency questions.</rdfs:comment>
  <rdfs:label>Software A</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ23 supplies SoftwareA as an instance</vaem:rationale>
  <dc:source>(competency_question) CQ23: Can software A work with data that are output from software B?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/swo#Software"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/swo#SoftwareX">
  <rdfs:comment>A specific software tool referenced in competency questions.</rdfs:comment>
  <rdfs:label>Software X</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ38 supplies SoftwareX as an instance</vaem:rationale>
  <dc:source>(competency_question) CQ38: Can we collaborate with developers of software x?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/swo#Software"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/swo#Version1_0">
  <rdfs:comment>The initial major release version of software.</rdfs:comment>
  <rdfs:label>Version 1.0</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ57 supplies Version1_0 as an instance</vaem:rationale>
  <dc:source>(competency_question) CQ57: When was the 1.0 version released?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/swo#Version"/>
</owl:NamedIndividual>

</rdf:RDF>