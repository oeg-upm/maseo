<?xml version="1.0"?>
<rdf:RDF xml:base="http://www.semanticweb.org/water#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:vaem="http://www.linkedmodel.org/schema/vaem#">

  <owl:Ontology rdf:about="http://www.semanticweb.org/water#"/>

  <!-- owl:Class declarations -->

<owl:Class rdf:about="http://www.semanticweb.org/water#Asset">
  <rdfs:comment>A physical or logical component of a water distribution infrastructure.</rdfs:comment>
  <rdfs:label>Asset</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ01 asks which assets compose the infrastructure</vaem:rationale>
  <dc:source>(competency_question) CQ01: Which assets compose a water distribution infrastructure?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#WaterDistributionInfrastructure">
  <rdfs:comment>The system of pipes, pumps, and other components that distribute water.</rdfs:comment>
  <rdfs:label>Water Distribution Infrastructure</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ01 asks about the infrastructure composed by assets</vaem:rationale>
  <dc:source>(competency_question) CQ01: Which assets compose a water distribution infrastructure?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Sensor">
  <rdfs:comment>A device that detects or measures a physical property in water systems.</rdfs:comment>
  <rdfs:label>Sensor</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ04 asks which sensor types are used in water infrastructures</vaem:rationale>
  <dc:source>(competency_question) CQ04: Which types of sensors are used in water infrastructures?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#WaterInfrastructure">
  <rdfs:comment>The physical facilities and systems used to manage water resources.</rdfs:comment>
  <rdfs:label>Water Infrastructure</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ04, CQ05, CQ06 refer to water infrastructures where sensors, actuators, and meters are used</vaem:rationale>
  <dc:source>(competency_question) CQ04: Which types of sensors are used in water infrastructures?
    (competency_question) CQ05: Which types of actuators are used in water infrastructures?
    (competency_question) CQ06: A water meter is a device that measures different aspects of a water infrastructure.</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Actuator">
  <rdfs:comment>A component that controls or moves a mechanism in water systems.</rdfs:comment>
  <rdfs:label>Actuator</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ05 asks which actuator types are used in water infrastructures</vaem:rationale>
  <dc:source>(competency_question) CQ05: Which types of actuators are used in water infrastructures?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#WaterMeter">
  <rdfs:comment>A device that measures different aspects of a water infrastructure.</rdfs:comment>
  <rdfs:label>Water Meter</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06, CQ08-CQ12, CQ18-CQ20, CQ38-CQ43 refer to water meters and their properties</vaem:rationale>
  <dc:source>(competency_question) CQ06: A water meter is a device that measures different aspects of a water infrastructure.
    (competency_question) CQ08: What is the fabrication number of the water meter?
    (competency_question) CQ09: What are the manufacturer and the model of the water meter?
    (competency_question) CQ10: What is the version of the water meter?
    (competency_question) CQ11: What is the hardware version number of the water meter?
    (competency_question) CQ12: What firmware version is the water meter using?
    (competency_question) CQ18: What is the power of the water meter?
    (competency_question) CQ19: What is the radio frequency level of the water meter?
    (competency_question) CQ20: What is the geolocation of the water meter?
    (competency_question) CQ38: What is the start date and time of the tariff in use in the water meter?
    (competency_question) CQ39: What is the duration of the current tariff of the water meter?
    (competency_question) CQ40: What is the tariff period of the water meter?
    (competency_question) CQ42: What is the billing date of the water meter?
    (competency_question) CQ43: What is the billing date period of the water meter?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/water#Device"/>
  <!-- Axiom: SubClassOf Device -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Device">
  <rdfs:comment>A piece of equipment or machinery used in water management.</rdfs:comment>
  <rdfs:label>Device</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06 states a water meter is a device</vaem:rationale>
  <dc:source>(competency_question) CQ06: A water meter is a device that measures different aspects of a water infrastructure.</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Function">
  <rdfs:comment>The purpose or role of a component within a water system.</rdfs:comment>
  <rdfs:label>Function</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06 asks about the function of a water meter to measure aspects</vaem:rationale>
  <dc:source>(competency_question) CQ06: A water meter is a device that measures different aspects of a water infrastructure.</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#TemporalSetting">
  <rdfs:comment>A configuration related to time intervals or schedules for measurements.</rdfs:comment>
  <rdfs:label>Temporal Setting</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ25 asks about temporal settings of water meter measurements</vaem:rationale>
  <dc:source>(competency_question) CQ25: Water meters can provide measurements according to different temporal settings.</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#WaterMeterMeasurement">
  <rdfs:comment>A recorded measurement produced by a water meter.</rdfs:comment>
  <rdfs:label>Water Meter Measurement</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ25 asks about measurements and their temporal settings</vaem:rationale>
  <dc:source>(competency_question) CQ25: Water meters can provide measurements according to different temporal settings.</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Water">
  <rdfs:comment>The chemical substance H2O, essential for life and managed by water infrastructures.</rdfs:comment>
  <rdfs:label>Water</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ33 and CQ34 ask about physical and chemical properties of water</vaem:rationale>
  <dc:source>(competency_question) CQ33: What are the physical properties of water?
    (competency_question) CQ34: What are the chemical properties of water?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#WaterIndicator">
  <rdfs:comment>A metric or parameter used to assess water quality or status.</rdfs:comment>
  <rdfs:label>Water Indicator</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ37 asks which water indicators are defined for Burgos</vaem:rationale>
  <dc:source>(competency_question) CQ37: Which water indicators are defined for Burgos?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#City">
  <rdfs:comment>A large human settlement, often a reference point for geographical or administrative data.</rdfs:comment>
  <rdfs:label>City</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ37 asks about indicators defined for a city</vaem:rationale>
  <dc:source>(competency_question) CQ37: Which water indicators are defined for Burgos?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/water#Tariff">
  <rdfs:comment>A schedule of fees or charges for water usage, associated with a meter.</rdfs:comment>
  <rdfs:label>Tariff</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ38 and CQ39 ask about tariffs in use or current for a water meter</vaem:rationale>
  <dc:source>(competency_question) CQ38: What is the start date and time of the tariff in use in the water meter?
    (competency_question) CQ39: What is the duration of the current tariff of the water meter?</dc:source>
</owl:Class>

  <!-- owl:ObjectProperty declarations -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#compose">
  <rdfs:comment>Relates an asset to the water distribution infrastructure it composes.</rdfs:comment>
  <rdfs:label>Compose</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ01 connects assets to the infrastructure they compose</vaem:rationale>
  <dc:source>(competency_question) CQ01: Which assets compose a water distribution infrastructure?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Asset"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#WaterDistributionInfrastructure"/>
  <!-- Axiom: domain Asset -->
  <!-- Axiom: range WaterDistributionInfrastructure -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#usedIn">
  <rdfs:comment>Relates a sensor or actuator to the water infrastructure where it is deployed.</rdfs:comment>
  <rdfs:label>Used In</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ04 and CQ05 connect sensors and actuators to water infrastructures
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] added Actuator to domain: Themis test CQ05 requires usedIn to have Actuator in its domain</vaem:rationale>
  <dc:source>(competency_question) CQ04: Which types of sensors are used in water infrastructures?
    (competency_question) CQ05: Which types of actuators are used in water infrastructures?
    (themis_test) CQ05: usedIn domain Actuator -&gt; Undefined</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Sensor"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#WaterInfrastructure"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Actuator"/>
  <!-- Axiom: domain Sensor -->
  <!-- Axiom: domain Actuator -->
  <!-- Axiom: range WaterInfrastructure -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#hasFunction">
  <rdfs:comment>Relates a water meter to its operational function.</rdfs:comment>
  <rdfs:label>Has Function</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06 connects water meters to their functions</vaem:rationale>
  <dc:source>(competency_question) CQ06: A water meter is a device that measures different aspects of a water infrastructure.</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#Function"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range Function -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#measures">
  <rdfs:comment>Relates a function to the water infrastructure aspect it measures.</rdfs:comment>
  <rdfs:label>Measures</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ06 connects functions to the infrastructure they measure</vaem:rationale>
  <dc:source>(competency_question) CQ06: A water meter is a device that measures different aspects of a water infrastructure.</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Function"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#WaterInfrastructure"/>
  <!-- Axiom: domain Function -->
  <!-- Axiom: range WaterInfrastructure -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#hasTemporalSetting">
  <rdfs:comment>Relates a water meter measurement to its temporal configuration.</rdfs:comment>
  <rdfs:label>Has Temporal Setting</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ25 connects measurements to temporal settings</vaem:rationale>
  <dc:source>(competency_question) CQ25: Water meters can provide measurements according to different temporal settings.</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeterMeasurement"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#TemporalSetting"/>
  <!-- Axiom: domain WaterMeterMeasurement -->
  <!-- Axiom: range TemporalSetting -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#definedFor">
  <rdfs:comment>Relates a water indicator to the city for which it is defined.</rdfs:comment>
  <rdfs:label>Defined For</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ37 connects indicators to cities</vaem:rationale>
  <dc:source>(competency_question) CQ37: Which water indicators are defined for Burgos?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterIndicator"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#City"/>
  <!-- Axiom: domain WaterIndicator -->
  <!-- Axiom: range City -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#inUseIn">
  <rdfs:comment>Relates a tariff to the water meter where it is currently applied.</rdfs:comment>
  <rdfs:label>In Use In</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ38 connects tariffs in use to water meters</vaem:rationale>
  <dc:source>(competency_question) CQ38: What is the start date and time of the tariff in use in the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Tariff"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <!-- Axiom: domain Tariff -->
  <!-- Axiom: range WaterMeter -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/water#currentTariff">
  <rdfs:comment>Relates a water meter to its currently active tariff.</rdfs:comment>
  <rdfs:label>Current Tariff</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ39 connects water meters to their current tariffs</vaem:rationale>
  <dc:source>(competency_question) CQ39: What is the duration of the current tariff of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/water#Tariff"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range Tariff -->
</owl:ObjectProperty>

  <!-- owl:DatatypeProperty declarations -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#fabricationNumber">
  <rdfs:comment>The unique manufacturing identifier of a water meter.</rdfs:comment>
  <rdfs:label>Fabrication Number</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ08 asks for the fabrication number</vaem:rationale>
  <dc:source>(competency_question) CQ08: What is the fabrication number of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#manufacturer">
  <rdfs:comment>The company that produced the water meter.</rdfs:comment>
  <rdfs:label>Manufacturer</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ09 asks for the manufacturer</vaem:rationale>
  <dc:source>(competency_question) CQ09: What are the manufacturer and the model of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#model">
  <rdfs:comment>The specific product model of the water meter.</rdfs:comment>
  <rdfs:label>Model</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ09 asks for the model</vaem:rationale>
  <dc:source>(competency_question) CQ09: What are the manufacturer and the model of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#version">
  <rdfs:comment>The general version identifier of the water meter.</rdfs:comment>
  <rdfs:label>Version</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ10 asks for the version</vaem:rationale>
  <dc:source>(competency_question) CQ10: What is the version of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#hardwareVersionNumber">
  <rdfs:comment>The specific hardware revision of the water meter.</rdfs:comment>
  <rdfs:label>Hardware Version Number</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ11 asks for the hardware version number</vaem:rationale>
  <dc:source>(competency_question) CQ11: What is the hardware version number of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#firmwareVersion">
  <rdfs:comment>The software/firmware version running on the water meter.</rdfs:comment>
  <rdfs:label>Firmware Version</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ12 asks for the firmware version</vaem:rationale>
  <dc:source>(competency_question) CQ12: What firmware version is the water meter using?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#power">
  <rdfs:comment>The electrical power consumption or rating of the water meter.</rdfs:comment>
  <rdfs:label>Power</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ18 asks for the power</vaem:rationale>
  <dc:source>(competency_question) CQ18: What is the power of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range float -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#radioFrequencyLevel">
  <rdfs:comment>The radio frequency transmission level of the water meter.</rdfs:comment>
  <rdfs:label>Radio Frequency Level</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ19 asks for the radio frequency level</vaem:rationale>
  <dc:source>(competency_question) CQ19: What is the radio frequency level of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range float -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#geolocation">
  <rdfs:comment>The geographical coordinates or location string of the water meter.</rdfs:comment>
  <rdfs:label>Geolocation</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ20 asks for the geolocation</vaem:rationale>
  <dc:source>(competency_question) CQ20: What is the geolocation of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <!-- Axiom: domain WaterMeter -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#physicalProperty">
  <rdfs:comment>A measurable physical characteristic of water.</rdfs:comment>
  <rdfs:label>Physical Property</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ33 asks for physical properties of water</vaem:rationale>
  <dc:source>(competency_question) CQ33: What are the physical properties of water?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Water"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <!-- Axiom: domain Water -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#chemicalProperty">
  <rdfs:comment>A measurable chemical characteristic of water.</rdfs:comment>
  <rdfs:label>Chemical Property</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ34 asks for chemical properties of water</vaem:rationale>
  <dc:source>(competency_question) CQ34: What are the chemical properties of water?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Water"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <!-- Axiom: domain Water -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#startDate">
  <rdfs:comment>The calendar date when a tariff becomes effective.</rdfs:comment>
  <rdfs:label>Start Date</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ38 asks for the start date of a tariff</vaem:rationale>
  <dc:source>(competency_question) CQ38: What is the start date and time of the tariff in use in the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Tariff"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <!-- Axiom: domain Tariff -->
  <!-- Axiom: range dateTime -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#startTime">
  <rdfs:comment>The clock time when a tariff becomes effective.</rdfs:comment>
  <rdfs:label>Start Time</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ38 asks for the start time of a tariff</vaem:rationale>
  <dc:source>(competency_question) CQ38: What is the start date and time of the tariff in use in the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Tariff"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <!-- Axiom: domain Tariff -->
  <!-- Axiom: range dateTime -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#duration">
  <rdfs:comment>The length of time a tariff remains valid.</rdfs:comment>
  <rdfs:label>Duration</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ39 asks for the duration of a tariff</vaem:rationale>
  <dc:source>(competency_question) CQ39: What is the duration of the current tariff of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#Tariff"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <!-- Axiom: domain Tariff -->
  <!-- Axiom: range integer -->
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/water#tariffPeriod">
  <rdfs:comment>The billing or measurement cycle associated with a water meter's tariff.</rdfs:comment>
  <rdfs:label>Tariff Period</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ40 asks for the tariff period</vaem:rationale>
  <dc:source>(competency_question) CQ40: What is the tariff period of the water meter?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/water#WaterMeter"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
