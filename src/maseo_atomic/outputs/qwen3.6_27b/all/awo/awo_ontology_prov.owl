  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/awo_prov#agent_OntoGeneration_Agent"/>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/awo#Herbivore">
  <rdfs:comment>An animal that feeds primarily on plants.</rdfs:comment>
  <rdfs:label>Herbivore</rdfs:label>
