    </prov:Derivation>
  </prov:qualifiedDerivation>
  <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/awo_prov#GenerationActivity"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/awo_prov#ExtractionActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/awo_prov#agent_TermExtraction_Agent"/>
