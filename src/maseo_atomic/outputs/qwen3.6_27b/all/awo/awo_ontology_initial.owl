<?xml version="1.0"?>
<rdf:RDF xml:base="http://www.semanticweb.org/awo#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:vaem="http://www.linkedmodel.org/schema/vaem#">

  <owl:Ontology rdf:about="http://www.semanticweb.org/awo#"/>

  <!-- owl:Class declarations -->

<owl:Class rdf:about="http://www.semanticweb.org/awo#Animal">
  <rdfs:comment>A living organism that typically moves, takes in oxygen, and consumes food.</rdfs:comment>
  <rdfs:label>Animal</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Serves as domain/range for eats and diet properties across multiple CQs</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which animal eats which other animal?
    (competency_question) CQ2: Is [this animal] a herbivore?
    (competency_question) CQ3: Which plant parts does [this omnivorous or herbivorourus animal] eat?
    (competency_question) CQ4: Does a lion eat plants or plant parts?
    (competency_question) CQ6: Which plants eat animals?
    (competency_question) CQ7: Which animals eat [these animals]?
    (competency_question) CQ14: Are there animals that are carnivore but still eat some plants or parts of plants?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/awo#Herbivore">
  <rdfs:comment>An animal that feeds primarily on plants.</rdfs:comment>
  <rdfs:label>Herbivore</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ2 asks to check if an animal belongs to this class</vaem:rationale>
  <dc:source>(competency_question) CQ2: Is [this animal] a herbivore?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/awo#Animal"/>
  <!-- Axiom: SubClassOf Animal -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/awo#PlantPart">
  <rdfs:comment>A structural component of a plant that may be consumed.</rdfs:comment>
  <rdfs:label>Plant Part</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ3 and CQ4 ask about consumption of plant parts</vaem:rationale>
  <dc:source>(competency_question) CQ3: Which plant parts does [this omnivorous or herbivorourus animal] eat?
    (competency_question) CQ4: Does a lion eat plants or plant parts?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/awo#Plant">
  <rdfs:comment>A multicellular organism that typically grows in soil and does not move.</rdfs:comment>
  <rdfs:label>Plant</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ4 and CQ6 involve plants as consumed items or consumers</vaem:rationale>
  <dc:source>(competency_question) CQ4: Does a lion eat plants or plant parts?
    (competency_question) CQ6: Which plants eat animals?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/awo#Diet">
  <rdfs:comment>The kinds of food that a person or animal habitually eats.</rdfs:comment>
  <rdfs:label>Diet</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ14 asks about dietary classifications</vaem:rationale>
  <dc:source>(competency_question) CQ14: Are there animals that are carnivore but still eat some plants or parts of plants?</dc:source>
</owl:Class>

  <!-- owl:ObjectProperty declarations -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/awo#eats">
  <rdfs:comment>Relates a consumer to the organism or part it consumes.</rdfs:comment>
  <rdfs:label>Eats</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Core relation across CQ1, CQ3, CQ4, CQ6, CQ7 connecting consumers to consumed entities</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which animal eats which other animal?
    (competency_question) CQ3: Which plant parts does [this omnivorous or herbivorourus animal] eat?
    (competency_question) CQ4: Does a lion eat plants or plant parts?
    (competency_question) CQ6: Which plants eat animals?
    (competency_question) CQ7: Which animals eat [these animals]?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/awo#Animal"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/awo#Animal"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/awo#PlantPart"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/awo#Plant"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/awo#Plant"/>
  <!-- Axiom: domain Animal -->
  <!-- Axiom: range Animal -->
  <!-- Axiom: range PlantPart -->
  <!-- Axiom: range Plant -->
  <!-- Axiom: domain Plant -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/awo#diet">
  <rdfs:comment>Relates an animal to its dietary classification.</rdfs:comment>
  <rdfs:label>Diet</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ14 connects animals to their diet types</vaem:rationale>
  <dc:source>(competency_question) CQ14: Are there animals that are carnivore but still eat some plants or parts of plants?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/awo#Animal"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/awo#Diet"/>
  <!-- Axiom: domain Animal -->
  <!-- Axiom: range Diet -->
</owl:ObjectProperty>

  <!-- owl:NamedIndividual declarations -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/awo#Lion">
  <rdfs:comment>A specific large cat species used as a query subject.</rdfs:comment>
  <rdfs:label>Lion</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ4 uses it as a named instance to query consumption</vaem:rationale>
  <dc:source>(competency_question) CQ4: Does a lion eat plants or plant parts?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/awo#Animal"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/awo#CarnivorousDiet">
  <rdfs:comment>A diet consisting mainly of meat.</rdfs:comment>
  <rdfs:label>Carnivorous Diet</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ14_a1 queries for animals with this diet</vaem:rationale>
  <dc:source>(competency_question) CQ14: Are there animals that are carnivore but still eat some plants or parts of plants?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/awo#Diet"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/awo#PlantBasedDiet">
  <rdfs:comment>A diet consisting mainly of plants.</rdfs:comment>
  <rdfs:label>Plant-Based Diet</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ14_a2 queries for animals with this diet</vaem:rationale>
  <dc:source>(competency_question) CQ14: Are there animals that are carnivore but still eat some plants or parts of plants?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/awo#Diet"/>
</owl:NamedIndividual>

</rdf:RDF>