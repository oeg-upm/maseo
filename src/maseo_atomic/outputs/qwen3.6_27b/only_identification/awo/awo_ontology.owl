<?xml version="1.0"?>
<rdf:RDF xml:base="http://www.semanticweb.org/awo#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:vaem="http://www.linkedmodel.org/schema/vaem#">

  <owl:Ontology rdf:about="http://www.semanticweb.org/awo#"/>

  <!-- owl:Class declarations -->

<owl:Class rdf:about="http://www.semanticweb.org/awo#Animal">
  <rdfs:comment>A living organism that feeds on organic matter and is capable of voluntary movement.</rdfs:comment>
  <rdfs:label>Animal</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Serves as the primary domain and range for eating relations across multiple CQs</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which animal eats which other animal?
    (competency_question) CQ2: Is [this animal] a herbivore?
    (competency_question) CQ3: Which plant parts does [this omnivorous or herbivorourus animal] eat?
    (competency_question) CQ4: Does a lion eat plants or plant parts?
    (competency_question) CQ6: Which plants eat animals?
    (competency_question) CQ7: Which animals eat [these animals]?
    (competency_question) CQ14: Are there animals that are carnivore but still eat some plants or parts of plants?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/awo#Herbivore">
  <rdfs:comment>An animal that feeds on plants or plant parts.</rdfs:comment>
  <rdfs:label>Herbivore</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ2 and CQ3 classify animals by diet</vaem:rationale>
  <dc:source>(competency_question) CQ2: Is [this animal] a herbivore?
    (competency_question) CQ3: Which plant parts does [this omnivorous or herbivorourus animal] eat?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/awo#Animal"/>
  <!-- Axiom: SubClassOf Animal -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/awo#Omnivore">
  <rdfs:comment>An animal that feeds on both plants and animals.</rdfs:comment>
  <rdfs:label>Omnivore</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ3 classifies animals by diet</vaem:rationale>
  <dc:source>(competency_question) CQ3: Which plant parts does [this omnivorous or herbivorourus animal] eat?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/awo#Animal"/>
  <!-- Axiom: SubClassOf Animal -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/awo#Lion">
  <rdfs:comment>A large carnivorous feline.</rdfs:comment>
  <rdfs:label>Lion</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ4 queries about this specific animal's diet</vaem:rationale>
  <dc:source>(competency_question) CQ4: Does a lion eat plants or plant parts?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/awo#Animal"/>
  <!-- Axiom: SubClassOf Animal -->
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/awo#Plant">
  <rdfs:comment>A multicellular organism that typically grows in soil and produces its own food.</rdfs:comment>
  <rdfs:label>Plant</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ4, CQ6, and CQ14 involve plants as eaten or eating entities</vaem:rationale>
  <dc:source>(competency_question) CQ4: Does a lion eat plants or plant parts?
    (competency_question) CQ6: Which plants eat animals?
    (competency_question) CQ14: Are there animals that are carnivore but still eat some plants or parts of plants?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/awo#PlantPart">
  <rdfs:comment>A structural component of a plant.</rdfs:comment>
  <rdfs:label>Plant Part</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ3, CQ4, and CQ14 query consumption of plant parts</vaem:rationale>
  <dc:source>(competency_question) CQ3: Which plant parts does [this omnivorous or herbivorourus animal] eat?
    (competency_question) CQ4: Does a lion eat plants or plant parts?
    (competency_question) CQ14: Are there animals that are carnivore but still eat some plants or parts of plants?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/awo#Carnivore">
  <rdfs:comment>An animal that feeds on other animals.</rdfs:comment>
  <rdfs:label>Carnivore</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ14 queries about carnivores eating plants</vaem:rationale>
  <dc:source>(competency_question) CQ14: Are there animals that are carnivore but still eat some plants or parts of plants?</dc:source>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/awo#Animal"/>
  <!-- Axiom: SubClassOf Animal -->
</owl:Class>

  <!-- owl:ObjectProperty declarations -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/awo#eats">
  <rdfs:comment>Relates a consumer organism to the organism or part it consumes.</rdfs:comment>
  <rdfs:label>Eats</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: All CQs query consumption relations between organisms and their food</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which animal eats which other animal?
    (competency_question) CQ3: Which plant parts does [this omnivorous or herbivorourus animal] eat?
    (competency_question) CQ4: Does a lion eat plants or plant parts?
    (competency_question) CQ6: Which plants eat animals?
    (competency_question) CQ7: Which animals eat [these animals]?
    (competency_question) CQ14: Are there animals that are carnivore but still eat some plants or parts of plants?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/awo#Animal"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/awo#Animal"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/awo#Plant"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/awo#PlantPart"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/awo#Plant"/>
  <!-- Axiom: domain Animal -->
  <!-- Axiom: range Animal -->
  <!-- Axiom: domain Plant -->
  <!-- Axiom: range PlantPart -->
  <!-- Axiom: range Plant -->
</owl:ObjectProperty>

  <!-- owl:NamedIndividual declarations -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/awo#GivenAnimal">
  <rdfs:comment>A placeholder individual representing a specific animal queried in CQ2 and CQ3.</rdfs:comment>
  <rdfs:label>Given Animal</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ2 and CQ3 supply this as an instance to query</vaem:rationale>
  <dc:source>(competency_question) CQ2: Is [this animal] a herbivore?
    (competency_question) CQ3: Which plant parts does [this omnivorous or herbivorourus animal] eat?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/awo#Animal"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/awo#GivenPreyAnimals">
  <rdfs:comment>A placeholder individual representing prey animals queried in CQ7.</rdfs:comment>
  <rdfs:label>Given Prey Animals</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ7 supplies this as an instance to query</vaem:rationale>
  <dc:source>(competency_question) CQ7: Which animals eat [these animals]?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/awo#Animal"/>
</owl:NamedIndividual>

</rdf:RDF>