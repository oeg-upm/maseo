<owl:Class rdf:about="http://www.semanticweb.org/swo#Format">
  <rdfs:comment>A file or data format supported by software.</rdfs:comment>
  <rdfs:label>Format</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ17, CQ19, CQ22, and CQ26 ask about input/output/processing formats</vaem:rationale>
  <dc:source>(competency_question) CQ17: What are the input and output formats for this software?
    (competency_question) CQ19: What software can read a .cel file?
    (competency_question) CQ22: Can this software export from its proprietary data format to an open format such as csv, txt?
    (competency_question) CQ26: What open source, maintained software can I use to process these in this format?</dc:source>
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/swo_prov#CQ17"/>
  <prov:qualifiedDerivation>
    <prov:Derivation>
      <prov:entity rdf:resource="http://www.semanticweb.org/swo_prov#CQ17"/>
      <prov:hadActivity rdf:resource="http://www.semanticweb.org/swo_prov#ExtractionActivity"/>
    </prov:Derivation>
