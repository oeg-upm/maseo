<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#uses">
  <rdfs:comment>Relates a tool or software to an algorithm or data it utilizes.</rdfs:comment>
  <rdfs:label>Uses</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ04 connects Tool to Algorithm; CQ16 connects Software to Data</vaem:rationale>
  <dc:source>(competency_question) CQ04: Which of the named and published algorithms does this tool use?
    (competency_question) CQ16: What software can I use my data with to support my task?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Tool"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Algorithm"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/swo#Software"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/swo#Data"/>
  <!-- Axiom: domain Tool -->
  <!-- Axiom: range Algorithm -->
  <!-- Axiom: domain Software -->
  <!-- Axiom: range Data -->
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/swo_prov#CQ04"/>
  <prov:qualifiedDerivation>
    <prov:Derivation>
      <prov:entity rdf:resource="http://www.semanticweb.org/swo_prov#CQ04"/>
      <prov:hadActivity rdf:resource="http://www.semanticweb.org/swo_prov#ExtractionActivity"/>
    </prov:Derivation>
  </prov:qualifiedDerivation>
  <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/swo_prov#CQ16"/>
  <prov:qualifiedDerivation>
    <prov:Derivation>
      <prov:entity rdf:resource="http://www.semanticweb.org/swo_prov#CQ16"/>
      <prov:hadActivity rdf:resource="http://www.semanticweb.org/swo_prov#ExtractionActivity"/>
    </prov:Derivation>
  </prov:qualifiedDerivation>
  <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/swo_prov#GenerationActivity"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/swo_prov#ExtractionActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/swo_prov#agent_TermExtraction_Agent"/>
  <prov:wasInfluencedBy rdf:resource="http://www.semanticweb.org/swo_prov#IdentificationActivity"/>
  <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/swo_prov#agent_OntoGeneration_Agent"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/swo#modification">
  <rdfs:comment>Relates an algorithm to a modification applied to it.</rdfs:comment>
  <rdfs:label>Modification</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: CQ05 asks about modifications to algorithms</vaem:rationale>
