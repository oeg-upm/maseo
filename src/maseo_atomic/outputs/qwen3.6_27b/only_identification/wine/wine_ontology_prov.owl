  <prov:wasAssociatedWith rdf:resource="http://www.semanticweb.org/wine_prov#agent_TestGeneration_Agent"/>
  <prov:hadRole rdf:resource="http://www.semanticweb.org/wine_prov#RefinementRole"/>
  <prov:hadPlan rdf:resource="http://www.semanticweb.org/wine_prov#GenerationPrompt"/>
  <prov:qualifiedAssociation>
    <prov:Association>
      <prov:agent rdf:resource="http://www.semanticweb.org/wine_prov#agent_TestGeneration_Agent"/>
      <prov:hadRole rdf:resource="http://www.semanticweb.org/wine_prov#RefinementRole"/>
