<?xml version="1.0"?>
<rdf:RDF xml:base="http://www.semanticweb.org/wine#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:vaem="http://www.linkedmodel.org/schema/vaem#">

  <owl:Ontology rdf:about="http://www.semanticweb.org/wine#"/>

  <!-- owl:Class declarations -->

<owl:Class rdf:about="http://www.semanticweb.org/wine#Wine">
  <rdfs:comment>A fermented grape beverage characterized by color, bouquet, body, vintage year, and grape variety.</rdfs:comment>
  <rdfs:label>Wine</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Serves as domain for multiple properties across CQ1, CQ2, CQ6, CQ7, CQnew1</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which wine characteristics should I consider when choosing a wine?
    (competency_question) CQ2: Is Bordeaux a red or white wine?
    (competency_question) CQ6: Does a bouquet or body of a specific wine change with vintage year?
    (competency_question) CQ7: What were good vintages for Napa Zinfandel?
    (competency_question) CQnew1: What grapes are used to make Bordeaux wine?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#Characteristic">
  <rdfs:comment>An attribute or feature of a wine.</rdfs:comment>
  <rdfs:label>Characteristic</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Range of hasCharacteristic in CQ1</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which wine characteristics should I consider when choosing a wine?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#Color">
  <rdfs:comment>The visual hue of a wine.</rdfs:comment>
  <rdfs:label>Color</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Range of hasColor in CQ2</vaem:rationale>
  <dc:source>(competency_question) CQ2: Is Bordeaux a red or white wine?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#Bouquet">
  <rdfs:comment>The complex aroma of a wine.</rdfs:comment>
  <rdfs:label>Bouquet</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Range of hasBouquet and domain of changesWith in CQ6</vaem:rationale>
  <dc:source>(competency_question) CQ6: Does a bouquet or body of a specific wine change with vintage year?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#Body">
  <rdfs:comment>The weight or fullness of a wine on the palate.</rdfs:comment>
  <rdfs:label>Body</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Range of hasBody in CQ6</vaem:rationale>
  <dc:source>(competency_question) CQ6: Does a bouquet or body of a specific wine change with vintage year?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#VintageYear">
  <rdfs:comment>The year the grapes were harvested.</rdfs:comment>
  <rdfs:label>Vintage Year</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Range of hasVintageYear and changesWith in CQ6, CQ7</vaem:rationale>
  <dc:source>(competency_question) CQ6: Does a bouquet or body of a specific wine change with vintage year?
    (competency_question) CQ7: What were good vintages for Napa Zinfandel?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#Quality">
  <rdfs:comment>An assessment of how good a vintage or wine is.</rdfs:comment>
  <rdfs:label>Quality</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Type for individual Good in CQ7</vaem:rationale>
  <dc:source>(competency_question) CQ7: What were good vintages for Napa Zinfandel?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/wine#Grape">
  <rdfs:comment>The fruit used to produce wine.</rdfs:comment>
  <rdfs:label>Grape</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Domain of usedToMake in CQnew1</vaem:rationale>
  <dc:source>(competency_question) CQnew1: What grapes are used to make Bordeaux wine?</dc:source>
</owl:Class>

  <!-- owl:ObjectProperty declarations -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#hasCharacteristic">
  <rdfs:comment>Relates a wine to one of its characteristics.</rdfs:comment>
  <rdfs:label>Has Characteristic</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Connects Wine to Characteristic in CQ1</vaem:rationale>
  <dc:source>(competency_question) CQ1: Which wine characteristics should I consider when choosing a wine?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/wine#Characteristic"/>
  <!-- Axiom: domain Wine -->
  <!-- Axiom: range Characteristic -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#hasColor">
  <rdfs:comment>Relates a wine to its color.</rdfs:comment>
  <rdfs:label>Has Color</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Connects Wine to Color in CQ2</vaem:rationale>
  <dc:source>(competency_question) CQ2: Is Bordeaux a red or white wine?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/wine#Color"/>
  <!-- Axiom: domain Wine -->
  <!-- Axiom: range Color -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#hasBouquet">
  <rdfs:comment>Relates a wine to its bouquet.</rdfs:comment>
  <rdfs:label>Has Bouquet</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Connects Wine to Bouquet in CQ6</vaem:rationale>
  <dc:source>(competency_question) CQ6: Does a bouquet or body of a specific wine change with vintage year?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/wine#Bouquet"/>
  <!-- Axiom: domain Wine -->
  <!-- Axiom: range Bouquet -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#hasBody">
  <rdfs:comment>Relates a wine to its body.</rdfs:comment>
  <rdfs:label>Has Body</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Connects Wine to Body in CQ6</vaem:rationale>
  <dc:source>(competency_question) CQ6: Does a bouquet or body of a specific wine change with vintage year?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/wine#Body"/>
  <!-- Axiom: domain Wine -->
  <!-- Axiom: range Body -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#changesWith">
  <rdfs:comment>Relates a bouquet to the vintage year that influences it.</rdfs:comment>
  <rdfs:label>Changes With</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Connects Bouquet to VintageYear in CQ6</vaem:rationale>
  <dc:source>(competency_question) CQ6: Does a bouquet or body of a specific wine change with vintage year?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Bouquet"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/wine#VintageYear"/>
  <!-- Axiom: domain Bouquet -->
  <!-- Axiom: range VintageYear -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#hasVintageYear">
  <rdfs:comment>Relates a wine to its vintage year.</rdfs:comment>
  <rdfs:label>Has Vintage Year</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Connects Wine to VintageYear in CQ6, CQ7</vaem:rationale>
  <dc:source>(competency_question) CQ6: Does a bouquet or body of a specific wine change with vintage year?
    (competency_question) CQ7: What were good vintages for Napa Zinfandel?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Wine"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/wine#VintageYear"/>
  <!-- Axiom: domain Wine -->
  <!-- Axiom: range VintageYear -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/wine#usedToMake">
  <rdfs:comment>Relates a grape variety to the wine it produces.</rdfs:comment>
  <rdfs:label>Used To Make</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Connects Grape to Wine in CQnew1</vaem:rationale>
  <dc:source>(competency_question) CQnew1: What grapes are used to make Bordeaux wine?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#Grape"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/wine#Wine"/>
  <!-- Axiom: domain Grape -->
  <!-- Axiom: range Wine -->
</owl:ObjectProperty>

  <!-- owl:DatatypeProperty declarations -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/wine#hasQualityRating">
  <rdfs:comment>The quality assessment string for a vintage year.</rdfs:comment>
  <rdfs:label>Has Quality Rating</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Connects VintageYear to a string rating in CQ7</vaem:rationale>
  <dc:source>(competency_question) CQ7: What were good vintages for Napa Zinfandel?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/wine#VintageYear"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <!-- Axiom: domain VintageYear -->
  <!-- Axiom: range string -->
</owl:DatatypeProperty>

  <!-- owl:NamedIndividual declarations -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/wine#Red">
  <rdfs:comment>A wine color.</rdfs:comment>
  <rdfs:label>Red</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Supplied as individual in CQ2</vaem:rationale>
  <dc:source>(competency_question) CQ2: Is Bordeaux a red or white wine?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/wine#Color"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/wine#White">
  <rdfs:comment>A wine color.</rdfs:comment>
  <rdfs:label>White</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Supplied as individual in CQ2</vaem:rationale>
  <dc:source>(competency_question) CQ2: Is Bordeaux a red or white wine?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/wine#Color"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/wine#Bordeaux">
  <rdfs:comment>A wine region/style.</rdfs:comment>
  <rdfs:label>Bordeaux</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Supplied as instance in CQ2, CQnew1</vaem:rationale>
  <dc:source>(competency_question) CQ2: Is Bordeaux a red or white wine?
    (competency_question) CQnew1: What grapes are used to make Bordeaux wine?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/wine#Wine"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/wine#Good">
  <rdfs:comment>A quality rating.</rdfs:comment>
  <rdfs:label>Good</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Supplied as individual in CQ7</vaem:rationale>
  <dc:source>(competency_question) CQ7: What were good vintages for Napa Zinfandel?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/wine#Quality"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/wine#NapaZinfandel">
  <rdfs:comment>A specific wine.</rdfs:comment>
  <rdfs:label>Napa Zinfandel</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Supplied as instance in CQ7</vaem:rationale>
  <dc:source>(competency_question) CQ7: What were good vintages for Napa Zinfandel?</dc:source>
  <rdf:type rdf:resource="http://www.semanticweb.org/wine#Wine"/>
</owl:NamedIndividual>

</rdf:RDF>