<?xml version="1.0"?>
<rdf:RDF xml:base="http://www.semanticweb.org/vgo#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:vaem="http://www.linkedmodel.org/schema/vaem#">

  <owl:Ontology rdf:about="http://www.semanticweb.org/vgo#"/>

  <!-- owl:Class declarations -->

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Player">
  <rdfs:comment>A user of the gaming platform who plays games, owns items, and makes purchases.</rdfs:comment>
  <rdfs:label>Player</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Core entity supplied across multiple CQs
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: core entity across CQs
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 2 | themis_test] removed disjointWith Game: prevents logical conflict when adding explicit domain axioms for hasAchievement and hasItem</vaem:rationale>
  <dc:source>(competency_question) CQ01: What is the username of the player?
    (competency_question) CQ02: Who are the friends of the player?
    (competency_question) CQ22: Who has the best kill count in the game?
    (competency_question) CQ24: What achievements has a player obtained?
    (competency_question) CQ25: What games has the player played?
    (competency_question) CQ26: What items does the player have?
    (competency_question) CQ27: What achievements of a certain type does the player have?
    (competency_question) CQ29: What is the last game a player has played?
    (competency_question) CQ35: In how many games does the player have all the achievements?
    (competency_question) CQ52: What equipment does a player have in a game?
    (competency_question) CQ55: What are the games where a player can use this item?
    (competency_question) CQ56: How many players have made in app purchases?
    (competency_question) CQ63: Where do the most paying customers live?
    (competency_question) CQ64: How long does a player spend in the game before making first IAP?
    (competency_question) CQ65: Where do the players live who have not made any IAP?
    (competency_question) CQ66: Where do the players who have done the most IAP live?
    (competency_question) CQ01, CQ02, CQ22, CQ24, CQ25, CQ26, CQ27, CQ29, CQ35, CQ52, CQ55, CQ56, CQ63, CQ64, CQ65, CQ66</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Friend">
  <rdfs:comment>A player designated as a friend of another player.</rdfs:comment>
  <rdfs:label>Friend</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Range of the friend relation and domain for friend-specific queries
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: range of friend relation</vaem:rationale>
  <dc:source>(competency_question) CQ02: Who are the friends of the player?
    (competency_question) CQ03: Who are the friends that play other games as well with this player?
    (competency_question) CQ05: What are the achievements of my friends?
    (competency_question) CQ07: What are the achievements your friend has received?
    (competency_question) CQ02, CQ03, CQ05, CQ07</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Game">
  <rdfs:comment>A digital game that can be played, contains items, and has achievements.</rdfs:comment>
  <rdfs:label>Game</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Central entity for gameplay, content, and statistics queries
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: central gameplay entity
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 2 | themis_test] removed disjointWith Player: prevents logical conflict when adding explicit domain axioms for hasAchievement and hasItem</vaem:rationale>
  <dc:source>(competency_question) CQ03: Who are the friends that play other games as well with this player?
    (competency_question) CQ08: What achievements does a game have?
    (competency_question) CQ09: How many hours has this game been played in total?
    (competency_question) CQ12: What is the genre of the game?
    (competency_question) CQ13: What items exist in a game?
    (competency_question) CQ15: What is the release date of the game?
    (competency_question) CQ17: List all games of a certain Genre?
    (competency_question) CQ22: Who has the best kill count in the game?
    (competency_question) CQ25: What games has the player played?
    (competency_question) CQ29: What is the last game a player has played?
    (competency_question) CQ35: In how many games does the player have all the achievements?
    (competency_question) CQ52: What equipment does a player have in a game?
    (competency_question) CQ64: How long does a player spend in the game before making first IAP?
    (competency_question) New CQ1: What playing areas does a game have?
    (competency_question) CQ03, CQ08, CQ09, CQ12, CQ13, CQ15, CQ17, CQ22, CQ25, CQ29, CQ35, CQ52, CQ64, New CQ1</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Achievement">
  <rdfs:comment>A reward or milestone unlocked within a game.</rdfs:comment>
  <rdfs:label>Achievement</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Target of achievement-related queries for players, friends, and games
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: target of achievement queries</vaem:rationale>
  <dc:source>(competency_question) CQ05: What are the achievements of my friends?
    (competency_question) CQ07: What are the achievements your friend has received?
    (competency_question) CQ08: What achievements does a game have?
    (competency_question) CQ10: What are the types of achievements in this game?
    (competency_question) CQ11: What are the types of achievements a game can have?
    (competency_question) CQ24: What achievements has a player obtained?
    (competency_question) CQ27: What achievements of a certain type does the player have?
    (competency_question) CQ35: In how many games does the player have all the achievements?
    (competency_question) CQ05, CQ07, CQ08, CQ10, CQ11, CQ24, CQ27, CQ35</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#AchievementType">
  <rdfs:comment>A category or classification for an achievement.</rdfs:comment>
  <rdfs:label>Achievement Type</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Range of the type property to classify achievements
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: range of type property</vaem:rationale>
  <dc:source>(competency_question) CQ10: What are the types of achievements in this game?
    (competency_question) CQ11: What are the types of achievements a game can have?
    (competency_question) CQ27: What achievements of a certain type does the player have?
    (competency_question) CQ10, CQ11, CQ27</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Genre">
  <rdfs:comment>A thematic category of a game.</rdfs:comment>
  <rdfs:label>Genre</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Range of the genre property for game classification
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: range of genre property</vaem:rationale>
  <dc:source>(competency_question) CQ12: What is the genre of the game?
    (competency_question) CQ17: List all games of a certain Genre?
    (competency_question) CQ12, CQ17</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Item">
  <rdfs:comment>An in-game object that can be owned or used.</rdfs:comment>
  <rdfs:label>Item</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Entity for inventory and usage queries
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: inventory and usage entity</vaem:rationale>
  <dc:source>(competency_question) CQ13: What items exist in a game?
    (competency_question) CQ19: What abilities does an item have?
    (competency_question) CQ26: What items does the player have?
    (competency_question) CQ55: What are the games where a player can use this item?
    (competency_question) CQ13, CQ19, CQ26, CQ55</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Ability">
  <rdfs:comment>A capability or effect provided by an item.</rdfs:comment>
  <rdfs:label>Ability</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Range of hasAbility to describe item properties
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: range of hasAbility</vaem:rationale>
  <dc:source>(competency_question) CQ19: What abilities does an item have?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Equipment">
  <rdfs:comment>Gear or tools equipped by a player.</rdfs:comment>
  <rdfs:label>Equipment</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Range of hasEquipment for player loadout queries
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: range of hasEquipment</vaem:rationale>
  <dc:source>(competency_question) CQ52: What equipment does a player have in a game?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#InAppPurchase">
  <rdfs:comment>A transaction made within the application.</rdfs:comment>
  <rdfs:label>In-App Purchase</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Entity for tracking spending behavior and timing
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: spending behavior entity</vaem:rationale>
  <dc:source>(competency_question) CQ56: How many players have made in app purchases?
    (competency_question) CQ57: How many players who have already spent money, spend money again?
    (competency_question) CQ62: What time are most of the in app purchases done?
    (competency_question) CQ63: Where do the most paying customers live?
    (competency_question) CQ64: How long does a player spend in the game before making first IAP?
    (competency_question) CQ65: Where do the players live who have not made any IAP?
    (competency_question) CQ66: Where do the players who have done the most IAP live?
    (competency_question) CQ56, CQ57, CQ62, CQ63, CQ64, CQ65, CQ66</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#Location">
  <rdfs:comment>A geographic place where a player resides.</rdfs:comment>
  <rdfs:label>Location</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Range of livesIn for demographic queries
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: range of livesIn</vaem:rationale>
  <dc:source>(competency_question) CQ63: Where do the most paying customers live?
    (competency_question) CQ65: Where do the players live who have not made any IAP?
    (competency_question) CQ66: Where do the players who have done the most IAP live?
    (competency_question) CQ63, CQ65, CQ66</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#PlayingArea">
  <rdfs:comment>A distinct zone or map within a game.</rdfs:comment>
  <rdfs:label>Playing Area</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Range of hasPlayingArea for New CQ1
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: range of hasPlayingArea</vaem:rationale>
  <dc:source>(competency_question) New CQ1: What playing areas does a game have?</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#AchievementOwner">
  <rdfs:comment>Abstract superclass for entities that can possess achievements.</rdfs:comment>
  <rdfs:label>Achievement Owner</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Shared domain for hasAchievement per supplied axioms
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: shared domain for hasAchievement</vaem:rationale>
  <dc:source>(competency_question) CQ08: What achievements does a game have?
    (competency_question) CQ27: What achievements of a certain type does the player have?
    (competency_question) CQ35: In how many games does the player have all the achievements?
    (competency_question) CQ08, CQ27, CQ35</dc:source>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/vgo#ItemOwner">
  <rdfs:comment>Abstract superclass for entities that can possess items.</rdfs:comment>
  <rdfs:label>Item Owner</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Shared domain for hasItem per supplied axioms
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: shared domain for hasItem</vaem:rationale>
  <dc:source>(competency_question) CQ13: What items exist in a game?
    (competency_question) CQ26: What items does the player have?
    (competency_question) CQ13, CQ26</dc:source>
</owl:Class>

  <!-- owl:ObjectProperty declarations -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#friend">
  <rdfs:comment>Relates a player to another player designated as a friend.</rdfs:comment>
  <rdfs:label>Friend</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ02 and enables CQ03 path
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: answers CQ02</vaem:rationale>
  <dc:source>(competency_question) CQ02: Who are the friends of the player?
    (competency_question) CQ03: Who are the friends that play other games as well with this player?
    (competency_question) CQ02, CQ03</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Friend"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#playsWith">
  <rdfs:comment>Relates a friend to a game they play alongside the player.</rdfs:comment>
  <rdfs:label>Plays With</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ03 by connecting friends to shared games
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: answers CQ03</vaem:rationale>
  <dc:source>(competency_question) CQ03: Who are the friends that play other games as well with this player?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Friend"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Game"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#achievement">
  <rdfs:comment>Relates a friend to an achievement they possess.</rdfs:comment>
  <rdfs:label>Achievement</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ05; specialized under friendAchievementRelation
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: answers CQ05</vaem:rationale>
  <dc:source>(competency_question) CQ05: What are the achievements of my friends?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Friend"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
  <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/vgo#friendAchievementRelation"/>
  <!-- Axiom: SubPropertyOf friendAchievementRelation -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#received">
  <rdfs:comment>Relates a friend to an achievement they have received.</rdfs:comment>
  <rdfs:label>Received</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ07; specialized under friendAchievementRelation
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: answers CQ07</vaem:rationale>
  <dc:source>(competency_question) CQ07: What are the achievements your friend has received?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Friend"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
  <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/vgo#friendAchievementRelation"/>
  <!-- Axiom: SubPropertyOf friendAchievementRelation -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasAchievement">
  <rdfs:comment>Relates an achievement owner to an achievement they possess.</rdfs:comment>
  <rdfs:label>Has Achievement</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ08, CQ27, CQ35 using shared domain
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] added explicit domain axioms for Game and Player: Themis tests CQ08, CQ27, CQ35 reported domain Game/Player as Absent
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] removed redundant Game/Player domains to fix intersection conflict; kept AchievementOwner domain: Themis tests CQ08, CQ27, CQ35 reported Conflict due to multiple domains creating empty intersection
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] added explicit domain axioms for Game and Player: Themis tests CQ08, CQ27, CQ35 reported Absent for hasAchievement domain Game/Player
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] removed redundant Game/Player domains to resolve intersection conflict: Themis tests CQ08, CQ27, CQ35 reported Conflict due to multiple disjoint domains</vaem:rationale>
  <dc:source>(competency_question) CQ08: What achievements does a game have?
    (competency_question) CQ27: What achievements of a certain type does the player have?
    (competency_question) CQ35: In how many games does the player have all the achievements?
    (competency_question) CQ08, CQ27, CQ35
    (themis_test) CQ08: hasAchievement domain Game -&gt; Absent; CQ27: hasAchievement domain Player -&gt; Absent; CQ35: hasAchievement domain Game -&gt; Absent
    (themis_test) CQ08/CQ27/CQ35 hasAchievement domain/range -&gt; Conflict
    (themis_test) CQ08/CQ27/CQ35 hasAchievement domain -&gt; Absent
    (themis_test) CQ08/CQ27/CQ35 hasAchievement domain -&gt; Conflict
    (themis_test) CQ08/CQ27/CQ35 hasAchievement domain -&gt; Absent/Conflict</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#AchievementOwner"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <!-- Axiom: domain AchievementOwner -->
  <!-- Axiom: domain Game -->
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Achievement -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#type">
  <rdfs:comment>Relates an achievement to its classification type.</rdfs:comment>
  <rdfs:label>Type</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ10, CQ11, CQ27 for achievement categorization
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] ensured correct declaration as ObjectProperty with explicit domain/range axioms: Themis tests CQ10, CQ11, CQ27 reported path as Incorrect
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] ensured explicit domain/range axioms: Themis tests CQ10, CQ11 reported Incorrect path
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] verified explicit domain/range axioms: Themis tests CQ10, CQ11, CQ27 reported Incorrect path for Achievement type AchievementType
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] added explicit domain and range axioms: Themis tests CQ10, CQ11, CQ27 reported Incorrect path
    [OntoCorrection Agent | loop_rounds: 3 tool_retries: 1 | themis_test] ensured explicit ObjectProperty declaration and domain/range axioms: Themis tests CQ10, CQ11, CQ27 reported Incorrect path for Achievement type AchievementType
    [OntoCorrection Agent | loop_rounds: 3 tool_retries: 2 | themis_test] explicitly declared as owl:ObjectProperty with correct domain and range to resolve Incorrect test status: Themis tests CQ10, CQ11, CQ27 reported Achievement type AchievementType -&gt; Incorrect
    [OntoCorrection Agent | loop_rounds: 3 tool_retries: 3 | themis_test] added explicit domain and range axioms: Themis tests CQ10, CQ11, CQ27 reported Incorrect for Achievement type AchievementType</vaem:rationale>
  <dc:source>(competency_question) CQ10: What are the types of achievements in this game?
    (competency_question) CQ11: What are the types of achievements a game can have?
    (competency_question) CQ27: What achievements of a certain type does the player have?
    (competency_question) CQ10, CQ11, CQ27
    (themis_test) CQ10/CQ11/CQ27: Achievement type AchievementType -&gt; Incorrect
    (themis_test) CQ10/CQ11 Achievement type AchievementType -&gt; Incorrect
    (themis_test) CQ10/CQ11/CQ27 Achievement type AchievementType -&gt; Incorrect
    (themis_test) Achievement type AchievementType -&gt; Incorrect
    (themis_test) CQ10: Achievement type AchievementType -&gt; Incorrect; CQ11: Achievement type AchievementType -&gt; Incorrect; CQ27: Achievement type AchievementType -&gt; Incorrect</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#AchievementType"/>
  <!-- Axiom: domain Achievement -->
  <!-- Axiom: range AchievementType -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#genre">
  <rdfs:comment>Relates a game to its thematic genre.</rdfs:comment>
  <rdfs:label>Genre</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ12 and CQ17 for game classification
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: answers CQ12, CQ17</vaem:rationale>
  <dc:source>(competency_question) CQ12: What is the genre of the game?
    (competency_question) CQ17: List all games of a certain Genre?
    (competency_question) CQ12, CQ17</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Genre"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasItem">
  <rdfs:comment>Relates an item owner to an item they possess.</rdfs:comment>
  <rdfs:label>Has Item</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ13 and CQ26 using shared domain
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 1 | themis_test] added explicit domain axioms for Game and Player: Themis tests CQ13, CQ26 reported domain Game/Player as Absent
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] removed redundant Game/Player domains to fix intersection conflict; kept ItemOwner domain: Themis tests CQ13, CQ26 reported Conflict due to multiple domains
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] added explicit domain axioms for Game and Player: Themis tests CQ13, CQ26 reported Absent for hasItem domain Game/Player
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] removed redundant Game/Player domains to resolve intersection conflict: Themis tests CQ13, CQ26 reported Conflict due to multiple disjoint domains</vaem:rationale>
  <dc:source>(competency_question) CQ13: What items exist in a game?
    (competency_question) CQ26: What items does the player have?
    (competency_question) CQ13, CQ26
    (themis_test) CQ13: hasItem domain Game -&gt; Absent; CQ26: hasItem domain Player -&gt; Absent
    (themis_test) CQ13/CQ26 hasItem domain/range -&gt; Conflict
    (themis_test) CQ13/CQ26 hasItem domain -&gt; Absent
    (themis_test) CQ13/CQ26 hasItem domain -&gt; Conflict
    (themis_test) CQ13/CQ26 hasItem domain -&gt; Absent/Conflict</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#ItemOwner"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Item"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <!-- Axiom: domain ItemOwner -->
  <!-- Axiom: domain Game -->
  <!-- Axiom: domain Player -->
  <!-- Axiom: range Item -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasAbility">
  <rdfs:comment>Relates an item to the abilities it provides.</rdfs:comment>
  <rdfs:label>Has Ability</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ19 for item capabilities
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: answers CQ19</vaem:rationale>
  <dc:source>(competency_question) CQ19: What abilities does an item have?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Item"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Ability"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#playsIn">
  <rdfs:comment>Relates a player to a game they are currently playing.</rdfs:comment>
  <rdfs:label>Plays In</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ22, CQ52, CQ64; specialized under gameInteraction
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: answers CQ22, CQ52, CQ64</vaem:rationale>
  <dc:source>(competency_question) CQ22: Who has the best kill count in the game?
    (competency_question) CQ52: What equipment does a player have in a game?
    (competency_question) CQ64: How long does a player spend in the game before making first IAP?
    (competency_question) CQ22, CQ52, CQ64</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/vgo#gameInteraction"/>
  <!-- Axiom: SubPropertyOf gameInteraction -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#obtained">
  <rdfs:comment>Relates a player to an achievement they have unlocked.</rdfs:comment>
  <rdfs:label>Obtained</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ24 for player achievements
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: answers CQ24</vaem:rationale>
  <dc:source>(competency_question) CQ24: What achievements has a player obtained?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#played">
  <rdfs:comment>Relates a player to a game they have played.</rdfs:comment>
  <rdfs:label>Played</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ25, CQ29, CQ35; specialized under gameInteraction
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: answers CQ25, CQ29, CQ35</vaem:rationale>
  <dc:source>(competency_question) CQ25: What games has the player played?
    (competency_question) CQ29: What is the last game a player has played?
    (competency_question) CQ35: In how many games does the player have all the achievements?
    (competency_question) CQ25, CQ29, CQ35</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/vgo#gameInteraction"/>
  <!-- Axiom: SubPropertyOf gameInteraction -->
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasEquipment">
  <rdfs:comment>Relates a player to equipment they possess.</rdfs:comment>
  <rdfs:label>Has Equipment</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ52 for player gear
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] added explicit domain/range axioms: Themis test CQ52 reported Conflict
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] preserved: answers CQ52
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] added explicit domain and range axioms: Themis test CQ52 reported Conflict</vaem:rationale>
  <dc:source>(competency_question) CQ52: What equipment does a player have in a game?
    (themis_test) CQ52 Player hasEquipment Equipment -&gt; Conflict</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Equipment"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#uses">
  <rdfs:comment>Relates a player to an item they utilize.</rdfs:comment>
  <rdfs:label>Uses</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ55 for item usage
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] added explicit domain/range axioms: Themis test CQ55 reported Conflict
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] preserved: answers CQ55
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] added explicit domain and range axioms: Themis test CQ55 reported Conflict</vaem:rationale>
  <dc:source>(competency_question) CQ55: What are the games where a player can use this item?
    (themis_test) CQ55 Player uses Item -&gt; Conflict</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Item"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasMade">
  <rdfs:comment>Relates a player to an in-app purchase they completed.</rdfs:comment>
  <rdfs:label>Has Made</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ56, CQ57, CQ63, CQ64, CQ65, CQ66 for spending behavior
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] added explicit domain/range axioms: Themis tests CQ56, CQ57, CQ64, CQ65, CQ66 reported Conflict
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] preserved: answers spending behavior CQs
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] added explicit domain and range axioms: Themis tests CQ56, CQ57, CQ64, CQ65, CQ66 reported Conflict</vaem:rationale>
  <dc:source>(competency_question) CQ56: How many players have made in app purchases?
    (competency_question) CQ57: How many players who have already spent money, spend money again?
    (competency_question) CQ63: Where do the most paying customers live?
    (competency_question) CQ64: How long does a player spend in the game before making first IAP?
    (competency_question) CQ65: Where do the players live who have not made any IAP?
    (competency_question) CQ66: Where do the players who have done the most IAP live?
    (competency_question) CQ56, CQ57, CQ63, CQ64, CQ65, CQ66
    (themis_test) CQ56/CQ57/CQ64/CQ65/CQ66 Player hasMade InAppPurchase -&gt; Conflict</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#InAppPurchase"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#livesIn">
  <rdfs:comment>Relates a player to their geographic location.</rdfs:comment>
  <rdfs:label>Lives In</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ63, CQ65, CQ66 for demographic filtering
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] added explicit domain/range axioms: Themis tests CQ63, CQ65, CQ66 reported Conflict
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] preserved: answers demographic CQs
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] added explicit domain and range axioms: Themis tests CQ63, CQ65, CQ66 reported Conflict</vaem:rationale>
  <dc:source>(competency_question) CQ63: Where do the most paying customers live?
    (competency_question) CQ65: Where do the players live who have not made any IAP?
    (competency_question) CQ66: Where do the players who have done the most IAP live?
    (competency_question) CQ63, CQ65, CQ66
    (themis_test) CQ63/CQ65/CQ66 Player livesIn Location -&gt; Conflict</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Location"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#hasPlayingArea">
  <rdfs:comment>Relates a game to its distinct playing zones.</rdfs:comment>
  <rdfs:label>Has Playing Area</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers New CQ1 for game map structure
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] added explicit domain/range axioms: Themis test New CQ1 reported Conflict
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] preserved: answers New CQ1
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] added explicit domain and range axioms: Themis test New CQ1 reported Conflict</vaem:rationale>
  <dc:source>(competency_question) New CQ1: What playing areas does a game have?
    (themis_test) New CQ1 Game hasPlayingArea PlayingArea -&gt; Conflict</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#PlayingArea"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#gameInteraction">
  <rdfs:comment>General relation connecting a player to a game.</rdfs:comment>
  <rdfs:label>Game Interaction</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] coined: Unifies played and playsIn which share domain Player and range Game
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: unifies played and playsIn</vaem:rationale>
  <dc:source>(competency_question) CQ25: What games has the player played?
    (competency_question) CQ29: What is the last game a player has played?
    (competency_question) CQ35: In how many games does the player have all the achievements?
    (competency_question) CQ22: Who has the best kill count in the game?
    (competency_question) CQ52: What equipment does a player have in a game?
    (competency_question) CQ64: How long does a player spend in the game before making first IAP?
    (competency_question) CQ25, CQ29, CQ35, CQ22, CQ52, CQ64</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Game"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/vgo#friendAchievementRelation">
  <rdfs:comment>General relation connecting a friend to an achievement.</rdfs:comment>
  <rdfs:label>Friend Achievement Relation</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] coined: Unifies achievement and received which share domain Friend and range Achievement
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: unifies achievement and received</vaem:rationale>
  <dc:source>(competency_question) CQ05: What are the achievements of my friends?
    (competency_question) CQ07: What are the achievements your friend has received?
    (competency_question) CQ05, CQ07</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Friend"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/vgo#Achievement"/>
</owl:ObjectProperty>

  <!-- owl:DatatypeProperty declarations -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#username">
  <rdfs:comment>The unique identifier string for a player.</rdfs:comment>
  <rdfs:label>Username</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ01 for player identification
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: answers CQ01</vaem:rationale>
  <dc:source>(competency_question) CQ01: What is the username of the player?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#totalPlayHours">
  <rdfs:comment>The cumulative time spent playing a game.</rdfs:comment>
  <rdfs:label>Total Play Hours</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ09 for gameplay duration metrics
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: answers CQ09</vaem:rationale>
  <dc:source>(competency_question) CQ09: How many hours has this game been played in total?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#releaseDate">
  <rdfs:comment>The calendar date when a game was published.</rdfs:comment>
  <rdfs:label>Release Date</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ15 for game publication timing
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: answers CQ15</vaem:rationale>
  <dc:source>(competency_question) CQ15: What is the release date of the game?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Game"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#killCount">
  <rdfs:comment>The number of eliminations recorded for a player.</rdfs:comment>
  <rdfs:label>Kill Count</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ22 for player performance metrics
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: answers CQ22</vaem:rationale>
  <dc:source>(competency_question) CQ22: Who has the best kill count in the game?</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#playedAt">
  <rdfs:comment>The timestamp when a player last played a game.</rdfs:comment>
  <rdfs:label>Played At</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ29 for recency tracking
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] added explicit domain/range axioms: Themis test CQ29 reported Conflict
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] preserved: answers CQ29
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] added explicit domain and range axioms: Themis test CQ29 reported Conflict</vaem:rationale>
  <dc:source>(competency_question) CQ29: What is the last game a player has played?
    (themis_test) CQ29 Player playedAt dateTime -&gt; Conflict</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#playDuration">
  <rdfs:comment>The time a player spends in a game before specific events.</rdfs:comment>
  <rdfs:label>Play Duration</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ64 for engagement timing analysis
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] added explicit domain/range axioms: Themis test CQ64 reported Conflict
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 3 | themis_test] preserved: answers CQ64
    [OntoCorrection Agent | loop_rounds: 2 tool_retries: 1 | themis_test] added explicit domain and range axioms: Themis test CQ64 reported Conflict</vaem:rationale>
  <dc:source>(competency_question) CQ64: How long does a player spend in the game before making first IAP?
    (themis_test) CQ64 Player playDuration float -&gt; Conflict</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#Player"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vgo#doneAt">
  <rdfs:comment>The timestamp when an in-app purchase was completed.</rdfs:comment>
  <rdfs:label>Done At</rdfs:label>
  <vaem:rationale>[OntoGeneration Agent] created: Answers CQ62 and CQ64 for transaction timing
    [OntoCorrection Agent | loop_rounds: 1 tool_retries: 2 | themis_test] preserved: answers CQ62, CQ64</vaem:rationale>
  <dc:source>(competency_question) CQ62: What time are most of the in app purchases done?
    (competency_question) CQ64: How long does a player spend in the game before making first IAP?
    (competency_question) CQ62, CQ64</dc:source>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/vgo#InAppPurchase"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:DatatypeProperty>

</rdf:RDF>