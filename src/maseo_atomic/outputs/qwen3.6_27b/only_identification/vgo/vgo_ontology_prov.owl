  <vgo_prov:correctionOutcome>succeeded</vgo_prov:correctionOutcome>
  <vgo_prov:ofRun rdf:resource="http://www.semanticweb.org/vgo_prov#run_vgo_only_identification"/>
  <vgo_prov:triggeredBy rdf:resource="http://www.semanticweb.org/vgo_prov#tool_themis_test"/>
</prov:Activity>

