<owl:NamedIndividual rdf:about="http://www.semanticweb.org/wine#OffDry">
  <rdf:type rdf:resource="http://www.semanticweb.org/wine#WineSugar"/><rdfs:label>Off Dry</rdfs:label></owl:NamedIndividual>
<owl:NamedIndividual rdf:about="http://www.semanticweb.org/wine#Sweet">
  <rdf:type rdf:resource="http://www.semanticweb.org/wine#WineSugar"/><rdfs:label>Sweet</rdfs:label></owl:NamedIndividual>

