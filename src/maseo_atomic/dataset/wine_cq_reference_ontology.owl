<owl:NamedIndividual rdf:about="http://www.semanticweb.org/wine#Strong">
  <rdf:type rdf:resource="http://www.semanticweb.org/wine#WineFlavor"/><rdfs:label>Strong</rdfs:label></owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/wine#Dry">
